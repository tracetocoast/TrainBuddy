# Copy to deploy/.env on the target host, chmod 600. NEVER commit the filled file.
# Generate four different URL-safe hex passwords with: openssl rand -hex 32
POSTGRES_PASSWORD=
MIGRATOR_DB_PASSWORD=
APP_DB_PASSWORD=
BACKUP_DB_PASSWORD=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
ADMIN_API_KEY=
# Hostname only, without https:// or a path.
API_DOMAIN=
ACME_EMAIL=
# Set only after reviewing docs/PRODUCTION-AUDIT.md and staging acceptance:
PRODUCTION_COMPAT_STORE_ACK=
# reviewed value: single-document-locking-reviewed
