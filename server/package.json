{
  "name": "trainbuddy-api",
  "version": "1.0.0",
  "private": true,
  "description": "练搭子统一业务 API（API01–31：含媒体/AI/体态/目标图/咨询）",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
