# 复制为 server/.env 后填写（.env 已 gitignore，勿提交真实密钥）

PORT=8787
AI_PROVIDER=unavailable

# ---- DeepSeek（文本：课后结构化 / 目标图规格）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- 豆包火山方舟（视觉：饮食识别 + 体态观察）----
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 必填：视觉理解／多模态接入点 ID（ep-…）。不要用 Seedream 文生图。
DOUBAO_MODEL=

# ---- MiniMax（可选；豆包未配 endpoint 时 nutrition 回退）----
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-Text-01

# 兼容单客户端写法（可与上面并存；文本优先 DeepSeek）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=60000
LLM_ENABLED_TASKS=nutrition,posture_scan,voice_structure,goal_image_spec

# 按任务覆盖供应商：deepseek | doubao | minimax
# LLM_TASK_PROVIDER_NUTRITION=doubao
# LLM_TASK_PROVIDER_VOICE_STRUCTURE=deepseek
# LLM_TASK_PROVIDER_GOAL_IMAGE_SPEC=deepseek

VOICE_ASR_PROVIDER=mock
