# 复制为 server/.env 后填写（.env 已 gitignore，勿提交真实密钥）

PORT=8787
AI_PROVIDER=unavailable

# ---- 微信小程序登录（jscode2session）----
# AppID 须与 miniprogram/project.config.json 一致；AppSecret 仅放服务端
WECHAT_APPID=
WECHAT_APPSECRET=

# ---- DeepSeek（文本：课后结构化 / 目标图规格）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- 豆包火山方舟（视觉：饮食识别 + 体态观察）----
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 必填：视觉理解／多模态接入点 ID（ep-…）。不要用 Seedream 文生图。
DOUBAO_MODEL=

# ---- MiniMax（目标预览图生图；亦可作饮食任务回退）----
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-Text-01
# 图生图模型（目标预览）
MINIMAX_IMAGE_MODEL=image-01
MINIMAX_IMAGE_TIMEOUT_MS=120000

# 兼容单客户端写法（可与上面并存；文本优先 DeepSeek）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=60000
LLM_ENABLED_TASKS=nutrition,posture_scan,voice_structure,goal_image_spec

# 按任务覆盖供应商：deepseek | doubao | minimax
# LLM_TASK_PROVIDER_NUTRITION=doubao
# LLM_TASK_PROVIDER_VOICE_STRUCTURE=deepseek
# LLM_TASK_PROVIDER_GOAL_IMAGE_SPEC=deepseek

# ---- 语音 ASR（课后录音听写）----
# mock | wechat | qwen
VOICE_ASR_PROVIDER=mock
# 阿里云百炼 Qwen ASR（VOICE_ASR_PROVIDER=qwen）
QWEN_ASR_API_KEY=
DASHSCOPE_API_KEY=
# streaming：qwen-audio-3.1-asr-flash-streaming（产品名 Qwen-Audio-ASR-Flash-Streaming）
# http：qwen3-asr-flash（录完再传更稳）
QWEN_ASR_MODEL=qwen-audio-3.1-asr-flash-streaming
QWEN_ASR_MODE=streaming
QWEN_ASR_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
# QWEN_ASR_HTTP_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
QWEN_ASR_FORMAT=mp3
QWEN_ASR_SAMPLE_RATE=16000
# 新版 MaaS 域名需业务空间 ID：wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
