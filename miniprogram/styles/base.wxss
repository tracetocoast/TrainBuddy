page {
  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}
view, text, button, input, textarea, scroll-view { box-sizing: border-box; }
button {
  margin: 0;
  margin-left: 0 !important;
  margin-right: 0 !important;
  padding: 0;
  width: auto;
  background: transparent;
  color: inherit;
  border-radius: 0;
  font-size: inherit;
  line-height: 1.4;
  font-weight: inherit;
}
button::after { border: none; }

.page { min-height: 100vh; padding: 24rpx 50rpx calc(156rpx + env(safe-area-inset-bottom)); }
.page-solo { padding-top: 28rpx; }
.top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 24rpx 0; }
.top-actions { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; }
.brand {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 750;
  line-height: 1.3;
  letter-spacing: -.6rpx;
  white-space: nowrap;
}
.brand-sub { display: none; }
.brand-emblem-slot { display: inline-flex; flex-shrink: 0; }
.eyebrow {
  display: block;
  margin-top: 16rpx;
  color: var(--muted);
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.title {
  font-family: "Songti SC", "STSong", SimSun, serif;
  margin: 12rpx 0;
  font-size: 56rpx;
  font-weight: 750;
  line-height: 1.25;
  letter-spacing: -1rpx;
  overflow-wrap: break-word;
}
.sub { font-size: 25rpx; color: var(--muted); line-height: 1.7; }

.hero {
  background: var(--graphite);
  color: var(--hero-ink);
  padding: 32rpx;
  border: 0;
  border-radius: var(--radius-card);
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow-soft);
}
.hero-ring { display: none; }
.hero-title { margin: 22rpx 0 12rpx; font-size: 40rpx; font-weight: 750; line-height: 1.3; }
.hero .sub, .hero .big-unit { color: var(--hero-muted); }
.herofoot { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; margin-top: 24rpx; }

/* 标签：默认信息态；语义态需同时有文案（必要时配合图标） */
.pill, .tag, .statuspill {
  display: inline-block;
  background: var(--soft);
  color: var(--accent);
  padding: 6rpx 14rpx;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  font-weight: 600;
  border: 1rpx solid transparent;
}
.tag-ok, .statuspill-ok, .pill-ok {
  background: var(--ok-soft);
  color: var(--ok-ink);
  border-color: var(--ok-line);
}
.tag-warn, .statuspill-warn, .pill-warn {
  background: var(--warn-soft);
  color: var(--warn-ink);
  border-color: var(--warn-line);
}
.tag-err, .statuspill-err, .pill-err {
  background: var(--danger-soft);
  color: var(--danger);
  border-color: var(--danger-line);
}

.big {
  font-size: 64rpx;
  line-height: 1.1;
  font-weight: 750;
  font-variant-numeric: tabular-nums;
}
.big-unit { margin-left: 8rpx; font-size: 24rpx; color: var(--muted); }

/* 主/次/深色按钮：统一按压反馈；时长走 token，减动效可关闭 */
.primary, .secondary, .darkbtn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: 18rpx 26rpx;
  border: 1rpx solid transparent;
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  font-weight: 650;
  text-align: center;
  line-height: 1.35;
  transition: transform var(--ix-state) var(--ease-spring), opacity var(--ix-fast) ease;
}
.primary { background: var(--accent); color: var(--on-accent); }
.darkbtn { background: var(--graphite); color: var(--on-accent); }
.secondary { background: var(--surface); border-color: var(--line); color: var(--ink); }
.primary:active, .secondary:active, .darkbtn:active { transform: scale(.985); opacity: .92; }
.primary[disabled], .secondary[disabled], .darkbtn[disabled],
.primary.is-disabled, .secondary.is-disabled, .darkbtn.is-disabled {
  background: var(--disabled-bg);
  border-color: var(--disabled-line);
  color: var(--disabled-ink);
  transform: none;
  opacity: 1;
}
.primary.is-selected, .secondary.is-selected {
  border-color: var(--accent);
  box-shadow: inset 0 0 0 2rpx var(--ok-line);
}
.primary.is-loading, .secondary.is-loading, .darkbtn.is-loading {
  opacity: .72;
  pointer-events: none;
}

.head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 32rpx 0 16rpx; }
.head-title { font-size: 30rpx; font-weight: 700; line-height: 1.4; }
.head > .head-title, .head > .sub { flex: 1; min-width: 0; }
.link {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  max-width: 220rpx;
  padding: 0 4rpx;
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; }
.stat {
  min-width: 0;
  padding: 22rpx 10rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-ctl);
  text-align: center;
  box-shadow: var(--shadow-soft);
}
.stat-value {
  display: block;
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 750;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}
.stat-label { display: block; margin-top: 8rpx; font-size: 22rpx; line-height: 1.4; color: var(--muted); }

/* 卡片：轻边框为主，阴影只作微弱层级 */
.card {
  margin-top: 16rpx;
  padding: 26rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft);
}
.card-title { margin: 0 0 8rpx; font-size: 29rpx; font-weight: 650; line-height: 1.45; }
.flex { display: flex; align-items: center; gap: 20rpx; }
.grow { flex: 1; min-width: 0; }
.ico {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  border-radius: var(--radius-ctl);
  background: var(--soft);
  color: var(--accent);
  font-size: 32rpx;
}

.dates { display: block; width: 100%; margin: 24rpx 0; white-space: nowrap; }
.date-btn {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  min-height: 112rpx;
  margin-right: 12rpx;
  padding: 14rpx 12rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-ctl);
  background: var(--surface);
  color: var(--muted);
  font-size: 24rpx;
  vertical-align: top;
  transition: background var(--ix-fast) ease, color var(--ix-fast) ease, border-color var(--ix-fast) ease;
}
.date-day { display: block; margin-top: 4rpx; font-size: 32rpx; font-weight: 700; }
.date-btn.chosen, .date-btn.is-selected {
  background: var(--accent);
  border-color: var(--accent);
  color: var(--on-accent);
}

.time {
  width: 110rpx;
  flex-shrink: 0;
  font-size: 32rpx;
  font-weight: 750;
  font-variant-numeric: tabular-nums;
}
.slot { display: flex; align-items: center; gap: 16rpx; }
.slotmain { flex: 1; min-width: 0; }
.slotmain .card-title { margin-bottom: 6rpx; }
.statuspill { flex-shrink: 0; font-size: 21rpx; }

.field {
  width: 100%;
  min-height: 44px;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-field);
  background: var(--surface);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.5;
}
input.field { height: 96rpx; padding: 0 24rpx; line-height: 96rpx; }
textarea.field { display: block; height: 180rpx; min-height: 180rpx; }
input.mini-field { height: 80rpx; line-height: 80rpx; padding: 0 10rpx; }

.exercise {
  margin-top: 20rpx;
  padding: 24rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--coach-radius);
  background: var(--surface);
}
.setgrid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14rpx; margin-top: 20rpx; }
.set { padding: 16rpx 6rpx; background: var(--surface-raised); border-radius: 12rpx; text-align: center; }
.done {
  background: var(--ok-soft) !important;
  border-color: var(--ok-line) !important;
  color: var(--ok-ink) !important;
  box-shadow: none !important;
}

.progress {
  height: 10rpx;
  background: var(--progress-track);
  border-radius: 6rpx;
  overflow: hidden;
}
.progress-bar {
  display: block;
  height: 100%;
  border-radius: 6rpx;
  background: var(--accent);
  transition: width var(--ix-panel) ease;
}

.twobtn { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; margin-top: 20rpx; width: 100%; }
.twobtn > button { width: 100%; min-width: 0; }
.flex > button, .slot > button, .head > button, .herofoot > button { flex-shrink: 0; }
.msg-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx !important;
  min-width: 76rpx;
  max-width: 76rpx;
  height: 76rpx;
  padding: 0;
  flex-shrink: 0;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 50%;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
}
.link { width: auto !important; }
.press-spring { transform: scale(.985); opacity: .92; }

/* 空/加载/错误：文案为主，色块为辅 */
.ui-state {
  padding: 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--surface);
  color: var(--muted);
  margin: 16rpx 0;
  font-size: 25rpx;
  line-height: 1.6;
}
.ui-state-error {
  background: var(--danger-soft);
  border-color: var(--danger-line);
  color: var(--danger);
}
.ui-state-ok {
  background: var(--ok-soft);
  border-color: var(--ok-line);
  color: var(--ok-ink);
}
.ui-state-warn {
  background: var(--warn-soft);
  border-color: var(--warn-line);
  color: var(--warn-ink);
}
.ui-state .link { justify-content: flex-start; }
.ui-section-number { color: var(--muted); font-size: 20rpx; letter-spacing: 2rpx; }
.quiet-empty {
  padding: 32rpx 0;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.6;
}

/* 减少动态效果：偏好类与系统偏好一致置零时长 */
.ui-reduced, .ix-reduced {
  --ix-fast: 0ms;
  --ix-state: 0ms;
  --ix-panel: 0ms;
  --ease-spring: linear;
}
@media (prefers-reduced-motion: reduce) {
  .primary, .secondary, .darkbtn, .press-spring, .date-btn, .progress-bar {
    transition: none;
    transform: none;
  }
}
