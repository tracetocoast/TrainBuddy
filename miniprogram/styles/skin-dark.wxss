/* 黑色皮肤 · 黑金青铜。仅在页面根节点挂 .skin-dark 时生效。
   选择器重复一次类名以提高优先级，确保压过页面级 @import 的 .interaction-scope 同名变量。 */
.skin-dark.skin-dark {
  --ink: #f5f3ef;
  --muted: #b8b0a5;
  --paper: #090909;
  --surface: #151515;
  --surface-raised: #202020;
  --line: #3a3329;
  --accent: #c7a45a;
  --bronze: #b48a57;
  --lime: #c7a45a;
  --purple: #9d92c4;
  --signal: #9a7142;
  --graphite: #050505;
  --positive: #c7a45a;
  --danger: #e58a8f;
  --warning: #d2ad70;
  --shadow-soft: 0 8rpx 28rpx rgba(0, 0, 0, 0.55);

  --on-accent: #ffffff;
  --graphite-ink: #f5f3ef;
  --pine-ink: #f5f3ef;
  --hero-ink: #fffaf1;
  --hero-muted: #d5c5a4;
  --disabled-bg: #24211c;
  --disabled-line: #40382d;
  --disabled-ink: #a99f90;
  --ok-bg: #302719;
  --ok-line: #655235;
  --ok-ink: #d6bb7b;
  --progress-track: #443a2b;
  --danger-bg: #332224;
  --danger-line: #4d2e31;
  --danger-ink: #e07a85;

  --tint-1: #1c1915;
  --tint-2: #272118;
  --green-soft: #302719;
  --green-strong: #51432d;
  --deep-green: #d3b36e;
  --muted-2: #9b9183;
  --ink-2: #e1d8ca;
  --blue-tint: #1d262e;
  --blue-tint-2: #243040;
  --blue-line: #34404b;
  --blue-soft: #4c6280;
  --blue-muted: #8fa3b5;
  --blue-ink: #b6c4d4;
  --warm-ink: #d0a66d;
  --warm-tint: #30251a;

  /* 上游 V1.6-V1.12 新设计色板的暗色对应 */
  --soft: #302719;
  --ok-soft: #302719;
  --danger-soft: #332224;
  --warn-soft: #30251a;
  --warn-ink: #d2ad70;
  --warn-line: #57452c;
  --positive: #c7a45a;
  --warning: #d2ad70;
  --linen-1: #1c1915;
  --linen-2: #272118;
  --linen-3: #393024;
  --mint-1: #211c16;
  --mint-2: #302719;
  --mint-3: #453823;
  --pine-1: #11100e;
  --pine-2: #29231b;
  --rose-tint: #332321;
  --rose-line: #4e3230;
  --steel-ink: #8fa3b5;
  --glass-1: rgba(21, 21, 21, 0.9);
  --glass-2: rgba(21, 21, 21, 0.76);

  --ix-ink: #f5f3ef;
  --ix-muted: #b8b0a5;
  --ix-surface: #151515;
  --ix-line: #3a3329;
  --ix-accent: #c7a45a;
  --ix-soft: #302719;
  --ix-error: #e58a8f;

  min-height: 100vh;
  background: var(--paper);
  color: var(--ink);
}
