/* 练搭子 · 黑金青铜（保留 Interaction v2 / 全站落地所需语义 token） */
page {
  /* 浅色皮肤：白底黑字，驼金与青铜承担品牌强调 */
  --ink: #171717;
  --muted: #70685f;
  --paper: #ffffff;
  --surface: #ffffff;
  --surface-raised: #f5f1e9;
  --soft: #f4ecdf;
  --line: #e3d8c7;
  --accent: #c7a45a;
  --bronze: #9a7142;
  --lime: #c7a45a;
  --purple: #8478a5;
  --signal: #c7a45a;
  --graphite: #171717;
  --positive: #9a7142;
  --danger: #b42332;
  --warning: #8a5a26;

  /* 状态浅底：配合图标/文案，不只靠色块 */
  --ok-soft: #f4ecdf;
  --ok-ink: #76572f;
  --ok-line: #d8c29a;
  --warn-soft: #f6eee2;
  --warn-ink: #805d36;
  --warn-line: #dfc8a8;
  --danger-soft: #fff1f2;
  --danger-line: #f1cbd0;
  --disabled-bg: #eeeae3;
  --disabled-line: #ded8ce;
  --disabled-ink: #81796e;
  --progress-track: #e8dfd1;

  /* 圆角与阴影：卡片靠边框+轻阴影，教练域可关闭阴影 */
  --radius-card: 36rpx;
  --radius-ctl: 28rpx;
  --radius-field: 14rpx;
  --radius-pill: 999rpx;
  --coach-radius: 20rpx;
  --coach-control-radius: 14rpx;
  --coach-space: 24rpx;
  --shadow-soft: 0 8rpx 28rpx rgba(70, 52, 28, 0.08);

  /* 动效：减少动态效果时由 .ui-reduced / .ix-reduced 置零 */
  --ease-spring: cubic-bezier(0.34, 1.4, 0.64, 1);
  --ix-fast: 100ms;
  --ix-state: 200ms;
  --ix-panel: 280ms;

  /* Interaction 作用域别名：指向同一套色板，避免第二套硬编码 */
  --ix-ink: var(--ink);
  --ix-muted: var(--muted);
  --ix-surface: var(--surface);
  --ix-line: var(--line);
  --ix-accent: var(--accent);
  --ix-soft: var(--soft);
  --ix-error: var(--danger);

  /* V1.13 皮肤系统补充 token（浅色值 = 原硬编码值，白色皮肤外观不变；与上游状态 token 同值的保留别名） */
  --on-accent: #ffffff;
  --graphite-ink: #171717;
  --pine-ink: #29231b;
  --hero-ink: #fffaf1;
  --hero-muted: #e4d6bb;
  --ok-bg: #f4ecdf;
  --danger-bg: #fff1f2;
  --danger-ink: #a52b3b;
  --tint-1: #faf7f1;
  --tint-2: #f4ecdf;
  --green-soft: #f4ecdf;
  --green-strong: #e8d8bc;
  --deep-green: #9a7142;
  --muted-2: #8a8176;
  --ink-2: #3c352b;
  --blue-tint: #f7f9fc;
  --blue-tint-2: #dfe7ff;
  --blue-line: #dce2e8;
  --blue-soft: #b7c6f9;
  --blue-muted: #738093;
  --blue-ink: #526071;
  --warm-ink: #805d36;
  --warm-tint: #f6eee2;

  /* V1.13 兼容上游 V1.6-V1.12 新设计色板 */
  --linen-1: #faf7f1;
  --linen-2: #f0e8dc;
  --linen-3: #e3d6c3;
  --mint-1: #f6f1e8;
  --mint-2: #eadcc5;
  --mint-3: #e2cfad;
  --pine-1: #29231b;
  --pine-2: #4a3926;
  --rose-tint: #f6e4df;
  --rose-line: #e8cfc8;
  --steel-ink: #5b7c99;
  --glass-1: rgba(255, 255, 255, 0.86);
  --glass-2: rgba(255, 255, 255, 0.72);
}
