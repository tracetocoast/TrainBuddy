/* 练搭子 · 暖白自然绿（保留 Interaction v2 / 全站落地所需语义 token） */
page {
  /* 核心色板：勿另起霓虹/强渐变体系 */
  --ink: #25352c;
  --muted: #6e7c72;
  --paper: #fafbf7;
  --surface: #ffffff;
  --surface-raised: #f1f5ed;
  --soft: #eef4e9;
  --line: #e0e7dc;
  --accent: #28744e;
  --lime: #28744e;
  --purple: #8478a5;
  --signal: #c7e8a8;
  --graphite: #1c3d2e;
  --positive: #28744e;
  --danger: #b42332;
  --warning: #8a5a26;

  /* 状态浅底：配合图标/文案，不只靠色块 */
  --ok-soft: #e8f5ee;
  --ok-ink: #19704c;
  --ok-line: #b2d9c5;
  --warn-soft: #fff3e3;
  --warn-ink: #8a5a26;
  --warn-line: #e6d0b0;
  --danger-soft: #fff1f2;
  --danger-line: #f1cbd0;
  --disabled-bg: #e7eee4;
  --disabled-line: #d7e0d4;
  --disabled-ink: #7a8a7e;
  --progress-track: #e0e7dc;

  /* 圆角与阴影：卡片靠边框+轻阴影，教练域可关闭阴影 */
  --radius-card: 36rpx;
  --radius-ctl: 28rpx;
  --radius-field: 14rpx;
  --radius-pill: 999rpx;
  --coach-radius: 20rpx;
  --coach-control-radius: 14rpx;
  --coach-space: 24rpx;
  --shadow-soft: 0 8rpx 28rpx rgba(40, 116, 78, 0.08);

  /* 动效：减少动态效果时由 .ui-reduced / .ix-reduced 置零 */
  --ease-spring: cubic-bezier(0.34, 1.4, 0.64, 1);
  --ix-fast: 100ms;
  --ix-state: 200ms;
  --ix-panel: 280ms;

  /* Interaction 作用域别名：指向同一套色板，避免第二套硬编码 */
  --ix-ink: var(--ink);
  --ix-muted: var(--muted);
  --ix-surface: var(--surface);
  --ix-line: var(--line);
  --ix-accent: var(--accent);
  --ix-soft: var(--soft);
  --ix-error: var(--danger);

  /* V1.13 皮肤系统补充 token（浅色值 = 原硬编码值，白色皮肤外观不变；与上游状态 token 同值的保留别名） */
  --on-accent: #ffffff;
  --graphite-ink: #1c3d2e;
  --pine-ink: #1e2a24;
  --hero-ink: #f3f6f1;
  --hero-muted: #c5d6c8;
  --ok-bg: #e8f5ee;
  --danger-bg: #fff1f2;
  --danger-ink: #a52b3b;
  --tint-1: #f7f9f2;
  --tint-2: #f1f4ee;
  --green-soft: #e6f0e4;
  --green-strong: #d4e3cc;
  --deep-green: #486540;
  --muted-2: #8a958b;
  --ink-2: #3a4540;
  --blue-tint: #f7f9fc;
  --blue-tint-2: #dfe7ff;
  --blue-line: #dce2e8;
  --blue-soft: #b7c6f9;
  --blue-muted: #738093;
  --blue-ink: #526071;
  --warm-ink: #9a6b45;
  --warm-tint: #fff3e3;

  /* V1.13 兼容上游 V1.6-V1.12 新设计色板 */
  --linen-1: #f8f6ef;
  --linen-2: #eeece4;
  --linen-3: #e4e0d5;
  --mint-1: #f4f9f1;
  --mint-2: #dfeadb;
  --mint-3: #dcead4;
  --pine-1: #1e2a24;
  --pine-2: #2d4036;
  --rose-tint: #f6e4df;
  --rose-line: #e8cfc8;
  --steel-ink: #5b7c99;
  --glass-1: rgba(255, 255, 255, 0.86);
  --glass-2: rgba(255, 255, 255, 0.72);
}
