/* TrainBuddy · Precision Daylight. Shared by every native page and component. */
page {
  --ink:#17202b; --muted:#526071; --paper:#f3f5f7;
  --surface:#ffffff; --surface-raised:#eaf0f6; --line:#dce2e8;
  --accent:#214beb; --lime:#214beb; --purple:#6554c0;
  --signal:#c7f36b; --graphite:#17202b; --positive:#19704c;
  --radius-card:20rpx; --radius-ctl:14rpx; --radius-pill:14rpx;
  --ease-spring:cubic-bezier(.2,.8,.2,1);
  --shadow-soft:0 6rpx 20rpx rgba(23,32,43,.04);
  --ix-ink:#17202b; --ix-muted:#526071; --ix-surface:#ffffff;
  --ix-line:#dce2e8; --ix-accent:#214beb; --ix-soft:#edf1ff;
  --ix-error:#b42332; --ix-fast:100ms; --ix-state:200ms; --ix-panel:280ms;
}
