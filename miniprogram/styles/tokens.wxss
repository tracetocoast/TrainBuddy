/* Field Notes · semantic tokens; legacy aliases retained for existing components. */
page {

  --ink: #282522;
  --muted: #827A73;
  --paper: #F8F5EF;
  --surface: #F8F5EF;
  --surface-raised: #F1ECE5;
  --soft: #F3E8E1;
  --line: #E1D8CE;
  --accent: #AB584A;
  --lime: #AB584A;
  --purple: #8478a5;
  --signal: #AB584A;
  --graphite: #AB584A;
  --positive: #507968;
  --danger: #b42332;
  --warning: #8a5a26;


  --ok-soft: #E9ECE4;
  --ok-ink: #507968;
  --ok-line: #C5D2C6;
  --warn-soft: #fff3e3;
  --warn-ink: #8a5a26;
  --warn-line: #e6d0b0;
  --danger-soft: #fff1f2;
  --danger-line: #f1cbd0;
  --disabled-bg: #ECE7DF;
  --disabled-line: #E1D8CE;
  --disabled-ink: #827A73;
  --progress-track: #E1D8CE;


  --radius-card: 0;
  --radius-ctl: 6rpx;
  --radius-field: 6rpx;
  --radius-pill: 6rpx;
  --coach-radius: 0;
  --coach-control-radius: 6rpx;
  --coach-space: 24rpx;
  --shadow-soft: none;


  --ease-spring: ease;
  --ix-fast: 100ms;
  --ix-state: 200ms;
  --ix-panel: 280ms;


  --ix-ink: var(--ink);
  --ix-muted: var(--muted);
  --ix-surface: var(--surface);
  --ix-line: var(--line);
  --ix-accent: var(--accent);
  --ix-soft: var(--soft);
  --ix-error: var(--danger);


  --on-accent: #ffffff;
  --graphite-ink: #282522;
  --pine-ink: #282522;
  --hero-ink: #f3f6f1;
  --hero-muted: #c5d6c8;
  --ok-bg: #E9ECE4;
  --danger-bg: #fff1f2;
  --danger-ink: #a52b3b;
  --tint-1: #F8F5EF;
  --tint-2: #F1ECE5;
  --green-soft: #F3E8E1;
  --green-strong: #E1D8CE;
  --deep-green: #AB584A;
  --muted-2: #827A73;
  --ink-2: #504A44;
  --blue-tint: #F1ECE5;
  --blue-tint-2: #F3E8E1;
  --blue-line: #E1D8CE;
  --blue-soft: #E1D8CE;
  --blue-muted: #827A73;
  --blue-ink: #504A44;
  --warm-ink: #9a6b45;
  --warm-tint: #fff3e3;


  --linen-1: #F8F5EF;
  --linen-2: #F1ECE5;
  --linen-3: #E1D8CE;
  --mint-1: #F3E8E1;
  --mint-2: #F1ECE5;
  --mint-3: #E1D8CE;
  --pine-1: #282522;
  --pine-2: #504A44;
  --rose-tint: #f6e4df;
  --rose-line: #e8cfc8;
  --steel-ink: #827A73;
  --glass-1: #F8F5EF;
  --glass-2: #F1ECE5;
}
