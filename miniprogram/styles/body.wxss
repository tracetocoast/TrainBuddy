.body-page { min-height: 100vh; padding: 36rpx 36rpx calc(50rpx + env(safe-area-inset-bottom)); background: #fafbfc; color: #334754; }
.body-page-head { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin-bottom: 40rpx; }
.body-heading { font-size: 42rpx; line-height: 1.4; font-weight: 700; }
.body-caption { font-size: 25rpx; line-height: 1.6; color: #8b98a2; margin-top: 10rpx; }
.body-add { width: auto !important; flex-shrink: 0; padding: 14rpx 20rpx; border: 1rpx solid #cddce6; border-radius: 16rpx; font-size: 26rpx; color: #4b6c83; background: #f1f6f9; }
.body-add[disabled] { opacity: .4; }
.body-section-label { font-size: 23rpx; color: #8b98a2; margin: 24rpx 4rpx 16rpx; }
.metric-list { background: #fff; border: 1rpx solid #e7ecf0; border-radius: 24rpx; overflow: hidden; }
.metric-row { display: flex; align-items: center; gap: 22rpx; text-align: left; width: 100% !important; padding: 30rpx 26rpx; border-bottom: 1rpx solid #eef1f4; }
.metric-row:last-child { border-bottom: 0; }
.metric-name { font-size: 30rpx; color: #3a4c59; }
.metric-date { margin-top: 8rpx; font-size: 22rpx; color: #98a3ac; }
.metric-number { font-size: 38rpx; color: #344f63; font-weight: 600; }
.metric-number text { font-size: 23rpx; font-weight: 400; color: #94a0aa; margin-left: 8rpx; }
.metric-arrow { color: #b1bdc6; font-size: 32rpx; }
.all-metrics { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; width: 100% !important; padding: 32rpx 4rpx 22rpx; text-align: left; font-size: 27rpx; }
.all-caption { font-size: 22rpx; color: #94a0aa; }
.body-privacy { color: #99a4ac; font-size: 22rpx; line-height: 1.7; text-align: center; margin-top: 32rpx; }
.body-status { padding: 50rpx 0; font-size: 26rpx; color: #8b98a2; }
.metric-hero { padding: 12rpx 0 32rpx; }
.metric-hero-value { font-size: 76rpx; line-height: 1.3; color: #344f63; font-weight: 600; }
.metric-hero-value text { font-size: 26rpx; color: #99a4ac; margin-left: 14rpx; font-weight: 400; }
.metric-change { font-size: 26rpx; color: #668094; margin-top: 20rpx; }.metric-change text { font-size: 22rpx; color: #99a4ac; }
.metric-ranges { display: flex; padding: 6rpx; background: #ecf0f3; border-radius: 16rpx; gap: 6rpx; }
.metric-range { flex: 1; width: 0 !important; padding: 14rpx 8rpx; border-radius: 12rpx; color: #8b98a2; font-size: 25rpx; }.metric-range.on { background: #fff; color: #3f5b70; }
.trend-wrap { margin: 36rpx 0; }.body-chart { position: relative; width: 600rpx; height: 200rpx; margin: 20rpx auto; }
.chart-grid { position: absolute; width: 100%; border-top: 1rpx dashed #dce4eb; }.grid-top { top: 20rpx; }.grid-middle { top: 100rpx; }.grid-bottom { top: 180rpx; }
.chart-line { height: 4rpx; background: #638aa4; position: absolute; transform-origin: left center; }.chart-dot { position: absolute; width: 12rpx; height: 12rpx; margin: -4rpx 0 0 -6rpx; background: #638aa4; border: 2rpx solid #fff; border-radius: 50%; }
.chart-labels { display: flex; justify-content: space-between; font-size: 21rpx; color: #99a4ac; padding: 8rpx 10rpx; }
.metric-empty { text-align: center; padding: 60rpx 12rpx; color: #8b98a2; font-size: 29rpx; }.metric-empty text { display: block; font-size: 24rpx; margin-top: 16rpx; color: #a0aab2; }
.history-head { display: flex; justify-content: space-between; font-size: 27rpx; margin: 36rpx 4rpx 18rpx; }.history-head text:last-child { color: #99a4ac; font-size: 23rpx; }
.history-row { display: flex; align-items: center; gap: 22rpx; width: 100% !important; padding: 26rpx; text-align: left; border-bottom: 1rpx solid #eef1f4; font-size: 26rpx; color: #8b98a2; }.history-row:last-child { border: 0; }.history-value { color: #3f5b70; }
.record-options { margin: 44rpx 0; border-top: 1rpx solid #e7ecf0; border-bottom: 1rpx solid #e7ecf0; }.record-option { display: flex; justify-content: space-between; gap: 24rpx; padding: 26rpx 0; font-size: 27rpx; color: #8b98a2; }.record-option > text:last-child { color: #435f73; }.record-option .metric-arrow { margin-left: 12rpx; }
.record-input-label { color: #8b98a2; font-size: 26rpx; margin-top: 50rpx; }.record-value-row { display: flex; align-items: center; gap: 20rpx; padding: 20rpx 0; border-bottom: 2rpx solid #bed0de; }.record-value-row > text { color: #8b98a2; font-size: 30rpx; }.record-value { width: 0; flex: 1; height: 110rpx; font-size: 72rpx; color: #344f63; line-height: 110rpx; }
.record-hint { font-size: 23rpx; color: #99a4ac; line-height: 1.8; margin-top: 22rpx; }.record-save { width: 100% !important; min-height: 96rpx; line-height: 1.4; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; background: #344f63; color: #fff; font-size: 29rpx; margin-top: 70rpx; }.record-save[disabled] { background: #dce3e8; color: #94a0aa; }.record-conflict { padding: 20rpx; margin-top: 24rpx; border-radius: 16rpx; background: #fff5e8; font-size: 24rpx; color: #8c7554; }
