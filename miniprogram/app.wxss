/* 练搭子 · 轻快、清晰、鼓励行动的基础样式 */
page {
  --lime: #58cc02;
  --ink: #3c3c3c;
  --paper: #ffffff;
  --muted: #777777;
  --line: #e5e5e5;
  --purple: #9069cd;
  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

view, text, button, input, textarea, scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  width: auto;
  background: transparent;
  border-radius: 0;
  font-size: inherit;
  line-height: 1.4;
  font-weight: inherit;
}

button::after {
  border: none;
}

.page {
  padding: 0 32rpx calc(156rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
}

.page-solo {
  padding-top: 28rpx;
}

.top {
  padding: 24rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.top-actions {
  display: flex;
  gap: 12rpx;
  align-items: center;
  flex-shrink: 0;
}

.brand {
  display: flex;
  align-items: center;
  min-width: 0;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.3;
  white-space: nowrap;
}

.mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 17rpx;
  background: var(--lime);
  color: #fff;
  margin-right: 12rpx;
  font-size: 32rpx;
  font-weight: 800;
  flex-shrink: 0;
  box-shadow: 0 4rpx 0 #46a302;
}

.brand-sub {
  display: none;
}

.eyebrow {
  display: none;
}

.title {
  font-size: 44rpx;
  line-height: 1.3;
  font-weight: 800;
  margin: 20rpx 0 14rpx;
  overflow-wrap: break-word;
}

.sub {
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--muted);
}

.hero {
  background: #effbdd;
  color: var(--ink);
  border: 2rpx solid #d7edbd;
  border-radius: 28rpx;
  padding: 32rpx;
  position: relative;
  overflow: hidden;
}

.hero-ring {
  display: none;
}

.pill {
  background: #fff;
  color: #487b21;
  border-radius: 14rpx;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  font-weight: 700;
  display: inline-block;
}

.hero-title {
  font-size: 40rpx;
  line-height: 1.35;
  margin: 24rpx 0 12rpx;
  font-weight: 800;
  position: relative;
}

.hero .sub {
  color: #64834d;
}

.herofoot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-top: 24rpx;
}

.big {
  font-size: 60rpx;
  line-height: 1.2;
  font-weight: 800;
}

.big-unit {
  font-size: 24rpx;
  margin-left: 8rpx;
  color: #64834d;
}

.primary, .secondary, .darkbtn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 16rpx 26rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
  text-align: center;
}

.primary {
  background: var(--lime);
  border: 2rpx solid var(--lime);
  color: #244b11;
  box-shadow: 0 6rpx 0 #46a302;
}

.primary:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 0 #46a302;
}

.secondary {
  background: #fff;
  border: 2rpx solid var(--line);
  box-shadow: 0 4rpx 0 var(--line);
  color: #597181;
}

.darkbtn {
  background: #3c5461;
  border: 2rpx solid #3c5461;
  color: #fff;
  box-shadow: 0 4rpx 0 #253d49;
}

.primary[disabled], .secondary[disabled], .darkbtn[disabled] {
  opacity: 1;
  background: #f1f1f1;
  border-color: #e5e5e5;
  color: #aaa;
  box-shadow: 0 3rpx 0 #e5e5e5;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 36rpx 0 18rpx;
}

.head-title {
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.4;
}

.head > .head-title, .head > .sub {
  min-width: 0;
  flex: 1;
}

.link {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  color: #1689b8;
  font-size: 25rpx;
  font-weight: 700;
  padding: 0 4rpx;
  flex-shrink: 0;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.stat {
  border: 2rpx solid var(--line);
  border-bottom-width: 5rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 22rpx 10rpx;
  min-width: 0;
  text-align: center;
}

.stat strong, .stat-value {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.3;
  color: #4b4b4b;
}

.stat span, .stat-label {
  display: block;
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 8rpx;
  line-height: 1.4;
}

.card {
  background: #fff;
  border: 2rpx solid var(--line);
  border-bottom-width: 5rpx;
  border-radius: 28rpx;
  padding: 26rpx;
  margin-top: 16rpx;
}

.flex {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.grow {
  flex: 1;
  min-width: 0;
}

.ico {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: #effbdd;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  flex-shrink: 0;
}

.card-title {
  font-size: 29rpx;
  margin: 0 0 8rpx;
  font-weight: 700;
  line-height: 1.45;
}

.tag {
  font-size: 22rpx;
  font-weight: 700;
  background: #f2f7fa;
  border-radius: 12rpx;
  padding: 6rpx 12rpx;
  color: #648191;
  display: inline-block;
}

.dates {
  display: block;
  width: 100%;
  margin: 24rpx 0;
  white-space: nowrap;
}

.date-btn {
  display: inline-flex;
  min-width: 88rpx;
  min-height: 112rpx;
  margin-right: 12rpx;
  border: 2rpx solid var(--line);
  border-bottom-width: 5rpx;
  background: #fff;
  border-radius: 22rpx;
  padding: 14rpx 12rpx;
  color: #777;
  font-size: 24rpx;
  line-height: 1.4;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  vertical-align: top;
}

.date-btn b, .date-day {
  display: block;
  font-size: 32rpx;
  margin-top: 4rpx;
  font-weight: 800;
}

.date-btn.chosen {
  background: #effbdd;
  color: #487b21;
  border-color: #a7df78;
}

.time {
  font-size: 32rpx;
  font-weight: 800;
  width: 110rpx;
  flex-shrink: 0;
}

.slot {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.slotmain {
  flex: 1;
  min-width: 0;
}

.slotmain .card-title {
  margin-bottom: 6rpx;
}

.statuspill {
  font-size: 21rpx;
  font-weight: 700;
  border-radius: 12rpx;
  padding: 8rpx 12rpx;
  background: #effbdd;
  color: #487b21;
  flex-shrink: 0;
}

.field {
  width: 100%;
  min-height: 88rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--line);
  border-radius: 22rpx;
  background: #f8fafb;
  font-size: 28rpx;
  line-height: 1.5;
}

input.field {
  height: 88rpx;
  padding: 0 24rpx;
  line-height: 88rpx;
}

textarea.field {
  display: block;
  height: 180rpx;
  min-height: 180rpx;
}

input.mini-field {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 10rpx;
}

.exercise {
  background: #fff;
  border: 2rpx solid var(--line);
  border-bottom-width: 5rpx;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-top: 20rpx;
}

.setgrid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 20rpx;
}

.set {
  background: #f7f9fa;
  border-radius: 16rpx;
  text-align: center;
  padding: 16rpx 6rpx;
}

.set small {
  display: block;
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
}

.set b {
  font-size: 28rpx;
}

.done {
  background: #effbdd !important;
  border-color: #a7df78 !important;
  color: #487b21 !important;
  box-shadow: 0 3rpx 0 #a7df78 !important;
}

.progress {
  height: 24rpx;
  background: #e5e5e5;
  border-radius: 20rpx;
  overflow: hidden;
}

.progress-bar {
  display: block;
  background: var(--lime);
  height: 100%;
  border-radius: 20rpx;
}

.twobtn {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 20rpx;
  width: 100%;
}

.twobtn > button {
  width: 100%;
  min-width: 0;
}

.flex > button, .slot > button, .head > button, .herofoot > button {
  flex-shrink: 0;
}

.msg-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: #e8f5fe;
  border: 2rpx solid #b9def5;
  color: #1689b8;
  font-size: 28rpx;
  font-weight: 800;
  flex-shrink: 0;
}

/* 原生 button 默认宽度与自动外边距会挤压横向布局。 */
button {
  margin-left: 0 !important;
  margin-right: 0 !important;
}

.msg-btn {
  width: 76rpx !important;
  max-width: 76rpx;
  min-width: 76rpx;
  padding: 0;
}

.link {
  width: auto !important;
  max-width: 180rpx;
  min-width: 0;
}
