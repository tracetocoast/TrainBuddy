page {
  --lime: #c8ff36;
  --ink: #151812;
  --paper: #f5f6f0;
  --muted: #74796d;
  --line: #e4e7dd;
  --purple: #9b7cff;
  background: var(--paper);
  color: var(--ink);
  font-size: 28rpx;
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  border-radius: 0;
  font-size: inherit;
  line-height: inherit;
  font-weight: inherit;
}

button::after {
  border: none;
}

.page {
  padding: 0 38rpx 180rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.top {
  padding: 24rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.top-actions {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.brand {
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
}

.mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 18rpx;
  background: var(--lime);
  margin-right: 14rpx;
  transform: rotate(-7deg);
  font-size: 28rpx;
}

.brand-sub {
  font-size: 16rpx;
  letter-spacing: 2rpx;
  color: #7c8175;
  margin-left: 8rpx;
}

.role {
  display: flex;
  margin-bottom: 30rpx;
  padding: 8rpx;
  background: #e6e9df;
  border-radius: 26rpx;
}

.role-btn {
  flex: 1;
  border: 0;
  background: transparent;
  padding: 18rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #757a6d;
  line-height: 1.2;
}

.role-btn.on {
  background: #fff;
  color: #151812;
}

.eyebrow {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  color: #73786d;
}

.title {
  font-size: 62rpx;
  line-height: 1.05;
  letter-spacing: -3rpx;
  font-weight: 800;
  margin: 16rpx 0 26rpx;
}

.sub {
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--muted);
}

.hero {
  background: #151812;
  color: #fff;
  border-radius: 50rpx;
  padding: 36rpx;
  min-height: 410rpx;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.hero-ring {
  position: absolute;
  width: 340rpx;
  height: 340rpx;
  border: 2rpx solid rgba(200, 255, 54, 0.25);
  border-radius: 50%;
  right: -70rpx;
  top: 56rpx;
  box-shadow: 0 0 0 36rpx rgba(200, 255, 54, 0.06), 0 0 0 72rpx rgba(200, 255, 54, 0.03);
}

.pill {
  background: var(--lime);
  color: #151812;
  border-radius: 100rpx;
  padding: 12rpx 18rpx;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  display: inline-block;
}

.hero-title {
  font-size: 52rpx;
  line-height: 1.05;
  letter-spacing: -2rpx;
  margin: 42rpx 0 14rpx;
  position: relative;
  z-index: 1;
  font-weight: 800;
}

.hero .sub {
  color: #c4c9bb;
  position: relative;
  z-index: 1;
}

.herofoot {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 32rpx;
  position: relative;
  z-index: 1;
}

.big {
  font-size: 72rpx;
  font-weight: 800;
  letter-spacing: -4rpx;
}

.big-unit {
  font-size: 26rpx;
  color: var(--lime);
}

.primary {
  background: var(--lime);
  border: 0;
  border-radius: 26rpx;
  padding: 24rpx 28rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #151812;
  line-height: 1.2;
  box-shadow: 0 6rpx 0 #85b900;
}

.primary[disabled] {
  opacity: 0.55;
}

.secondary {
  background: #fff;
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #151812;
  line-height: 1.2;
}

.darkbtn {
  background: #242a20;
  border: 2rpx solid #434b3b;
  color: #fff;
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.2;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 42rpx 0 20rpx;
}

.head-title {
  font-size: 38rpx;
  letter-spacing: -1rpx;
  font-weight: 800;
}

.link {
  border: 0;
  background: transparent;
  color: #59770b;
  font-size: 22rpx;
  font-weight: 800;
  padding: 0;
  line-height: 1.2;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.stat {
  background: #fff;
  border: 2rpx solid var(--line);
  border-radius: 32rpx;
  padding: 24rpx 20rpx;
}

.stat strong {
  font-size: 44rpx;
  letter-spacing: -2rpx;
  display: block;
  font-weight: 800;
}

.stat span {
  font-size: 20rpx;
  color: var(--muted);
}

.card {
  background: #fff;
  border: 2rpx solid var(--line);
  border-radius: 34rpx;
  padding: 26rpx;
  margin-top: 16rpx;
}

.flex {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.grow {
  flex: 1;
  min-width: 0;
}

.ico {
  width: 96rpx;
  height: 100rpx;
  border-radius: 28rpx;
  background: #eaf8cb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.card-title {
  font-size: 26rpx;
  margin: 0 0 10rpx;
  font-weight: 800;
}

.tag {
  font-size: 18rpx;
  font-weight: 800;
  background: #eef0e9;
  border-radius: 14rpx;
  padding: 8rpx 12rpx;
  color: #62685b;
  display: inline-block;
}

.dates {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
  margin: 26rpx 0;
  white-space: nowrap;
}

.date-btn {
  min-width: 86rpx;
  border: 2rpx solid var(--line);
  background: #fff;
  border-radius: 24rpx;
  padding: 18rpx 6rpx;
  color: #777c71;
  font-size: 20rpx;
  line-height: 1.2;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
}

.date-btn b {
  display: block;
  font-size: 32rpx;
  margin-top: 8rpx;
  color: #151812;
}

.date-btn.chosen {
  background: var(--lime);
  border-color: var(--lime);
}

.time {
  font-size: 36rpx;
  font-weight: 800;
  width: 122rpx;
  flex-shrink: 0;
}

.slot {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.slotmain {
  flex: 1;
}

.slotmain .card-title {
  margin: 0 0 8rpx;
}

.statuspill {
  font-size: 18rpx;
  font-weight: 800;
  border-radius: 14rpx;
  padding: 10rpx 14rpx;
  background: #edf7d7;
  flex-shrink: 0;
}

.field {
  width: 100%;
  padding: 24rpx;
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  background: #fff;
  font-size: 24rpx;
  box-sizing: border-box;
}

.exercise {
  background: #fff;
  border: 2rpx solid var(--line);
  border-radius: 32rpx;
  padding: 24rpx;
  margin-top: 18rpx;
}

.setgrid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 14rpx;
  margin-top: 22rpx;
}

.set {
  background: #f2f4ed;
  border-radius: 18rpx;
  text-align: center;
  padding: 16rpx 6rpx;
}

.set small {
  display: block;
  font-size: 18rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
}

.set b {
  font-size: 26rpx;
}

.done {
  background: #20251b !important;
  color: #fff !important;
}

.progress {
  height: 14rpx;
  background: #e5e8de;
  border-radius: 18rpx;
  overflow: hidden;
}

.progress-bar {
  display: block;
  background: #a6e61b;
  height: 100%;
  border-radius: 18rpx;
}

.twobtn {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 20rpx;
}

.msg-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 2rpx solid var(--line);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
}
