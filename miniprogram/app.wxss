/* 练搭子 · 与 AI 助手一致的深蓝灰视觉系统 */
page {
  --lime: #c6d7e3;
  --ink: #e4edf3;
  --paper: #111b26;
  --muted: #91a6b6;
  --line: #304351;
  --surface: #192a38;
  --surface-raised: #213747;
  --accent: #c6d7e3;
  --purple: #a4b7d8;
  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

view, text, button, input, textarea, scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  color: inherit;
  padding: 0;
  width: auto;
  background: transparent;
  border-radius: 0;
  font-size: inherit;
  line-height: 1.4;
  font-weight: inherit;
}

button::after {
  border: none;
}

.page {
  padding: 0 32rpx calc(156rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
}

.page-solo {
  padding-top: 28rpx;
}

.top {
  padding: 24rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.top-actions {
  display: flex;
  gap: 12rpx;
  align-items: center;
  flex-shrink: 0;
}

.brand {
  display: flex; align-items: center; gap: 14rpx; min-width: 0; font-size: 34rpx; font-weight: 500; line-height: 1.4; white-space: nowrap; letter-spacing: 1rpx;
}



.brand-sub {
  display: none;
}

.eyebrow {
  display: none;
}

.title {
  font-size: 44rpx;
  line-height: 1.3;
  font-weight: 600;
  margin: 20rpx 0 14rpx;
  overflow-wrap: break-word;
}

.sub {
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--muted);
}

.hero {
  background: #203748;
  color: var(--ink);
  border: 2rpx solid #304858;
  border-radius: 28rpx;
  padding: 32rpx;
  position: relative;
  overflow: hidden;
}

.hero-ring {
  display: none;
}

.pill {
  background: var(--surface);
  color: #bdd3e2;
  border-radius: 14rpx;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  font-weight: 500;
  display: inline-block;
}

.hero-title {
  font-size: 40rpx;
  line-height: 1.35;
  margin: 24rpx 0 12rpx;
  font-weight: 600;
  position: relative;
}

.hero .sub {
  color: #9fb9cc;
}

.herofoot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-top: 24rpx;
}

.big {
  font-size: 60rpx;
  line-height: 1.2;
  font-weight: 600;
}

.big-unit {
  font-size: 24rpx;
  margin-left: 8rpx;
  color: #9fb9cc;
}

.primary, .secondary, .darkbtn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 16rpx 26rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.35;
  text-align: center;
}

.primary {
  background: #dce6ec; border: 1rpx solid #dce6ec; color: #203649; box-shadow: none;
}

.primary:active { opacity: .85; transform: none; box-shadow: none; }

.secondary {
  background: var(--surface);
  border: 1rpx solid var(--line);
  box-shadow: none;
  color: #b7cbd9;
}

.darkbtn {
  background: #3c5461;
  border: 2rpx solid #3c5461;
  color: #fff;
  box-shadow: none;
}

.primary[disabled], .secondary[disabled], .darkbtn[disabled] {
  background: #233544; border-color: #304351; color: #708797; opacity: .65; box-shadow: none;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 36rpx 0 18rpx;
}

.head-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
}

.head > .head-title, .head > .sub {
  min-width: 0;
  flex: 1;
}

.link {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  color: #b7cbd9;
  font-size: 25rpx;
  font-weight: 500;
  padding: 0 4rpx;
  flex-shrink: 0;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.stat {
  border: 1rpx solid var(--line);
  border-bottom-width: 1rpx;
  background: var(--surface);
  border-radius: 24rpx;
  padding: 22rpx 10rpx;
  min-width: 0;
  text-align: center;
}

.stat strong, .stat-value {
  display: block;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.3;
  color: #e4edf3;
}

.stat span, .stat-label {
  display: block;
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 8rpx;
  line-height: 1.4;
}

.card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-bottom-width: 1rpx;
  border-radius: 28rpx;
  padding: 26rpx;
  margin-top: 16rpx;
}

.flex {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.grow {
  flex: 1;
  min-width: 0;
}

.ico {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: #203748;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  flex-shrink: 0;
}

.card-title {
  font-size: 29rpx;
  margin: 0 0 8rpx;
  font-weight: 500;
  line-height: 1.45;
}

.tag {
  font-size: 22rpx;
  font-weight: 500;
  background: #203747;
  border-radius: 12rpx;
  padding: 6rpx 12rpx;
  color: #a6becf;
  display: inline-block;
}

.dates {
  display: block;
  width: 100%;
  margin: 24rpx 0;
  white-space: nowrap;
}

.date-btn {
  display: inline-flex;
  min-width: 88rpx;
  min-height: 112rpx;
  margin-right: 12rpx;
  border: 1rpx solid var(--line);
  border-bottom-width: 1rpx;
  background: var(--surface);
  border-radius: 22rpx;
  padding: 14rpx 12rpx;
  color: #91a6b6;
  font-size: 24rpx;
  line-height: 1.4;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  vertical-align: top;
}

.date-btn b, .date-day {
  display: block;
  font-size: 32rpx;
  margin-top: 4rpx;
  font-weight: 600;
}

.date-btn.chosen {
  background: #203748;
  color: #bdd3e2;
  border-color: #66869e;
}

.time {
  font-size: 32rpx;
  font-weight: 600;
  width: 110rpx;
  flex-shrink: 0;
}

.slot {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.slotmain {
  flex: 1;
  min-width: 0;
}

.slotmain .card-title {
  margin-bottom: 6rpx;
}

.statuspill {
  font-size: 21rpx;
  font-weight: 500;
  border-radius: 12rpx;
  padding: 8rpx 12rpx;
  background: #203748;
  color: #bdd3e2;
  flex-shrink: 0;
}

.field {
  width: 100%;
  min-height: 88rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  background: #142330;
  font-size: 28rpx;
  line-height: 1.5;
}

input.field {
  height: 88rpx;
  padding: 0 24rpx;
  line-height: 88rpx;
}

textarea.field {
  display: block;
  height: 180rpx;
  min-height: 180rpx;
}

input.mini-field {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 10rpx;
}

.exercise {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-bottom-width: 1rpx;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-top: 20rpx;
}

.setgrid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 20rpx;
}

.set {
  background: #172735;
  border-radius: 16rpx;
  text-align: center;
  padding: 16rpx 6rpx;
}

.set small {
  display: block;
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
}

.set b {
  font-size: 28rpx;
}

.done {
  background: #203748 !important;
  border-color: #66869e !important;
  color: #bdd3e2 !important;
  box-shadow: none !important;
}

.progress {
  height: 24rpx;
  background: #304351;
  border-radius: 20rpx;
  overflow: hidden;
}

.progress-bar {
  display: block;
  background: var(--lime);
  height: 100%;
  border-radius: 20rpx;
}

.twobtn {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 20rpx;
  width: 100%;
}

.twobtn > button {
  width: 100%;
  min-width: 0;
}

.flex > button, .slot > button, .head > button, .herofoot > button {
  flex-shrink: 0;
}

.msg-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: #213849;
  border: 2rpx solid #b9def5;
  color: #b7cbd9;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* 原生 button 默认宽度与自动外边距会挤压横向布局。 */
button {
  margin-left: 0 !important;
  margin-right: 0 !important;
}

.msg-btn {
  width: 76rpx !important;
  max-width: 76rpx;
  min-width: 76rpx;
  padding: 0;
}

.link {
  width: auto !important;
  max-width: 180rpx;
  min-width: 0;
}

.brand-emblem-slot { display: inline-flex; flex-shrink: 0; }
.secondary, .darkbtn { box-shadow: none; border-width: 1rpx; border-radius: 18rpx; font-weight: 500; }
.primary { border-radius: 18rpx; font-weight: 500; }
.card, .exercise, .stat { border-width: 1rpx; background: linear-gradient(145deg,#1e2d3b,#172432); }
.field { color: #e4edf3; }
