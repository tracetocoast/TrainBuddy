.new-workout{padding-top:40rpx;background:var(--paper);}.intro{margin-bottom:48rpx;}.start-option{width:100%;display:flex;align-items:center;gap:24rpx;padding:32rpx 0;margin-bottom:20rpx;border:0;border-bottom:1rpx solid var(--line);border-radius:0;text-align:left;background:var(--surface);min-height:172rpx;}.option-primary{border-top:1rpx solid var(--line);}.option-icon{width:76rpx;height:76rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:transparent;border-radius:0;color:var(--accent);font-family:Georgia,serif;font-size:40rpx;}.option-copy{flex:1;min-width:0;display:flex;flex-direction:column;gap:10rpx;}.option-title{font-size:32rpx;font-weight:600;color:var(--ink);}.option-hint{font-size:24rpx;color:var(--muted);line-height:1.6;}.option-arrow{font-size:40rpx;color:var(--muted);}.creation-note{font-size:24rpx;color:var(--muted);line-height:1.7;margin-top:28rpx;}.start-option:active{opacity:.8;}
