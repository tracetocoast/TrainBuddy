.report-page{min-height:100vh;box-sizing:border-box;padding:2rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));overflow-wrap:anywhere;background:var(--paper);color:var(--ink)}.date,.caption,.muted{color:var(--muted);font-size:25rpx}.title{font-size:46rpx;font-weight:650;line-height:1.35;margin:20rpx 0}.overview{display:flex;gap:64rpx;padding:36rpx 0;border-bottom:1rpx solid var(--line)}.overview view{display:flex;flex-direction:column;gap:12rpx;font-size:25rpx}.number{font-size:56rpx;font-variant-numeric:tabular-nums;font-weight:600}.section-title{font-size:32rpx;font-weight:600;margin:36rpx 0 24rpx}.exercise{background:var(--surface);border:1rpx solid var(--line);border-radius:20rpx;padding:24rpx;margin:20rpx 0}.exercise-name{font-size:31rpx;font-weight:600;margin-bottom:22rpx}.set{display:grid;grid-template-columns:.75fr 1.1fr 1fr .9fr;gap:12rpx;padding:20rpx 0;border-top:1rpx solid var(--line);font-size:26rpx;align-items:center;font-variant-numeric:tabular-nums}.heading{border:0;color:var(--muted);font-size:23rpx}.kind{display:block;font-size:20rpx;color:var(--muted)}.done{color:var(--accent)}.feedback{white-space:pre-wrap;line-height:1.8;font-size:29rpx}.back{margin:40rpx 0 0;min-height:44px;background:var(--soft);color:var(--accent);font-size:28rpx}.state{padding:48rpx 0;line-height:1.8;color:var(--muted)}.state button{margin-top:24rpx}
