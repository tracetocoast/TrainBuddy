.report-page {
  min-height: 100vh;
  padding: 40rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--paper);
  color: var(--ink);
  overflow-wrap: anywhere;
}
.date, .caption, .muted { color: var(--muted); font-size: 25rpx; }
.title { margin: 16rpx 0; font-size: 46rpx; font-weight: 650; line-height: 1.35; }
.overview { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 24rpx; padding: 24rpx; background: var(--surface); border-radius: 16rpx; }
.overview view { display: flex; flex-direction: column; font-size: 25rpx; }
.number { font-size: 52rpx; font-weight: 650; font-variant-numeric: tabular-nums; }
.section-title { margin: 32rpx 0 16rpx; font-size: 32rpx; font-weight: 650; }
.report-areas { display: flex; flex-wrap: wrap; gap: 12rpx; }
.report-areas text { padding: 6rpx 16rpx; background: var(--ok-bg); color: var(--ok-ink); border-radius: 16rpx; font-size: 24rpx; }
.exercise { padding: 20rpx 0; border-bottom: 1rpx solid var(--line); }
.exercise-name { margin-bottom: 12rpx; font-size: 30rpx; font-weight: 650; }
.set { display: grid; grid-template-columns: .75fr 1.1fr 1fr .9fr; gap: 8rpx; padding: 16rpx 0; border-top: 1rpx solid var(--line); font-size: 26rpx; align-items: center; font-variant-numeric: tabular-nums; }
.heading, .kind { color: var(--muted); font-size: 23rpx; }
.heading { border: 0; }
.kind { display: block; }
.done, .back { color: var(--ok-ink); }
.feedback { white-space: pre-wrap; line-height: 1.7; font-size: 28rpx; }
.back { margin: 32rpx 0 0; min-height: 44px; background: var(--ok-bg); font-size: 28rpx; }
.state { padding: 40rpx 0; line-height: 1.7; color: var(--muted); }
.state button { margin-top: 24rpx; }
