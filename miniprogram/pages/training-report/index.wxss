page{background:#fafbf7;color:#25352c}.report-page{padding:40rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));overflow-wrap:anywhere}.date,.caption,.muted{color:#6e7c72;font-size:25rpx}.title{font-size:46rpx;font-weight:650;line-height:1.35;margin:20rpx 0}.overview{display:flex;gap:64rpx;padding:36rpx 0;border-bottom:1rpx solid #e0e7dc}.overview view{display:flex;flex-direction:column;gap:12rpx;font-size:25rpx}.number{font-size:56rpx;font-variant-numeric:tabular-nums;font-weight:600}.section-title{font-size:32rpx;font-weight:600;margin:36rpx 0 24rpx}.exercise{background:#fff;border:1rpx solid #e0e7dc;border-radius:20rpx;padding:24rpx;margin:20rpx 0}.exercise-name{font-size:31rpx;font-weight:600;margin-bottom:22rpx}.set{display:grid;grid-template-columns:.75fr 1.1fr 1fr .9fr;gap:12rpx;padding:20rpx 0;border-top:1rpx solid #e0e7dc;font-size:26rpx;align-items:center;font-variant-numeric:tabular-nums}.heading{border:0;color:#6e7c72;font-size:23rpx}.kind{display:block;font-size:20rpx;color:#6e7c72}.done{color:#28744e}.feedback{white-space:pre-wrap;line-height:1.8;font-size:29rpx}.back{margin:40rpx 0 0;min-height:44px;background:#edf3ec;color:#28744e;font-size:28rpx}.state{padding:48rpx 0;line-height:1.8;color:#6e7c72}.state button{margin-top:24rpx}
