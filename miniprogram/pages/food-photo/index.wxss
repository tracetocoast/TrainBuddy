.food-page { padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); }.food-kicker { font-size: 22rpx; color: var(--muted); margin-top: 8rpx; }.food-title { font-size: 39rpx; font-weight: 500; margin: 18rpx 0; line-height: 1.5; }
.food-photo { height: 350rpx; border-radius: 20rpx; background: #edf1ff; border: 1rpx solid var(--line); margin-top: 30rpx; overflow: hidden; position: relative; }.food-photo image { width: 100%; height: 100%; }.food-photo > text { position: absolute; bottom: 12rpx; left: 18rpx; font-size: 21rpx; color: #ffffff; background: rgba(39,64,37,.65); padding: 5rpx 12rpx; border-radius: 8rpx; }
.food-empty { display: flex; flex-direction: column; justify-content: center; align-items: center; color: var(--muted); gap: 18rpx; font-size: 28rpx; }.food-empty > text { position: static; background: transparent; color: var(--muted); font-size: 22rpx; padding: 0 20rpx; text-align: center; }
.plate-mark { width: 94rpx; height: 94rpx; border: 2rpx solid #94a6c1; border-radius: 50%; display: flex; align-items: center; justify-content: center; }.plate-mark view { width: 66rpx; height: 66rpx; border: 1rpx solid var(--line); border-radius: 50%; }
.food-local-note,.food-estimate-note { color: var(--muted); font-size: 22rpx; line-height: 1.8; margin-top: 18rpx; }.food-error { font-size: 23rpx; color: #a25f3f; margin-top: 16rpx; }.food-badge { font-size: 21rpx; color: #8d896d; background: #f2f1e8; padding: 7rpx 12rpx; border-radius: 12rpx; }
.nutrient-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 14rpx; }.nutrient-grid > view { padding: 24rpx 14rpx; border-radius: 20rpx; background: #ffffff; border: 1rpx solid var(--line); }.nutrient-grid > view > text { color: var(--muted); font-size: 23rpx; }.nutrient-grid view view { color: var(--ink); font-size: 42rpx; margin-top: 16rpx; }.nutrient-grid view view text { font-size: 22rpx; margin-left: 8rpx; color: var(--muted); }
.food-sync { border-top: 1rpx solid var(--line); border-bottom: 1rpx solid var(--line); margin-top: 30rpx; padding: 24rpx 0; }.food-sync-head { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; font-size: 27rpx; }.food-sync-head .sub { font-size: 22rpx; margin-top: 8rpx; }.food-sync switch { transform: scale(.8); transform-origin: right center; flex: none; }.food-save { width: 100% !important; margin-top: 30rpx; }.food-manual { width: 100% !important; max-width: none; margin-top: 12rpx; }
.food-mode { margin-top: 22rpx; align-items: center; }.food-mode-label { font-size: 26rpx; color: var(--muted); }.mode-group { display: flex; gap: 20rpx; }.mode-item { font-size: 24rpx; color: var(--ink); }
.food-edit { margin-top: 22rpx; display: flex; flex-direction: column; gap: 14rpx; padding: 8rpx 0; }
.food-row { display: flex; flex-direction: row; align-items: center; gap: 16rpx; min-height: 72rpx; }
.food-row-top { align-items: flex-start; padding-top: 8rpx; }
.food-label { width: 150rpx; flex: none; font-size: 26rpx; color: var(--muted); line-height: 1.4; }
.food-input { flex: 1; min-width: 0; box-sizing: border-box; height: 72rpx; line-height: 72rpx; background: #fff; border: 1rpx solid var(--line); border-radius: 999rpx; padding: 0 18rpx; font-size: 28rpx; color: var(--ink); }
.food-picker { display: flex; align-items: center; }
.food-portion { flex: 1; min-width: 0; display: flex; flex-direction: row; align-items: center; gap: 12rpx; }
.food-portion .food-input { flex: 1; }
.food-unit { flex: none; width: 36rpx; font-size: 24rpx; color: var(--muted); text-align: left; }
.food-meals { flex: 1; display: flex; flex-wrap: wrap; gap: 12rpx; }
.food-meal { padding: 10rpx 18rpx; border-radius: 999rpx; border: 1rpx solid var(--line); font-size: 24rpx; color: var(--muted); background: #f7f9fc; }
.food-meal.on { background: var(--accent); color: #fff; border-color: var(--accent); }
.food-unc { display: flex; flex-direction: column; gap: 6rpx; font-size: 22rpx; color: #a25f3f; padding-left: 166rpx; }
