.food-page {
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}
.food-kicker {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 8rpx;
}
.food-title {
  font-size: 39rpx;
  font-weight: 500;
  margin: 18rpx 0;
  line-height: 1.5;
}

.food-photo {
  height: 420rpx;
  border-radius: 6rpx;
  background: var(--ix-soft);
  border: 1rpx solid var(--line);
  margin-top: 30rpx;
  overflow: hidden;
  position: relative;
}
.food-photo-ready {
  border-color: var(--green-strong);
  box-shadow: none;
}
.food-photo image {
  width: 100%;
  height: 100%;
}
.food-photo-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 48rpx 18rpx 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  background: linear-gradient(180deg, transparent 0%, rgba(28, 34, 32, 0.55) 100%);
}
.food-photo-hint {
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.88);
}
.food-phase-chip {
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.18);
  color: var(--on-accent);
}
.food-empty {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: var(--muted);
  gap: 18rpx;
  font-size: 28rpx;
}
.food-empty > text {
  position: static;
  background: transparent;
  color: var(--muted);
  font-size: 22rpx;
  padding: 0 20rpx;
  text-align: center;
}
.plate-mark {
  width: 94rpx;
  height: 94rpx;
  border: 2rpx solid var(--blue-muted);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.plate-mark view {
  width: 66rpx;
  height: 66rpx;
  border: 1rpx solid var(--line);
  border-radius: 50%;
}

.food-local-note,
.food-estimate-note {
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.8;
  margin-top: 18rpx;
}
.food-scanning {
  padding: 16rpx 0 4rpx;
}
.food-scan-bar {
  height: 6rpx;
  border-radius: 6rpx;
  margin-bottom: 12rpx;
  background: linear-gradient(90deg, var(--ix-soft), var(--accent), var(--ix-soft));
  background-size: 200% 100%;
  animation: foodBarSlide 1.6s linear infinite;
}
.food-error {
  font-size: 23rpx;
  color: var(--warm-ink);
  margin-top: 16rpx;
}
.food-badge {
  font-size: 21rpx;
  color: var(--muted-2);
  background: var(--tint-2);
  padding: 7rpx 12rpx;
  border-radius: 12rpx;
}
.food-badge.phase-scanning {
  color: var(--warm-ink);
  background: var(--warm-tint);
}
.food-badge.phase-confirm {
  color: var(--deep-green);
  background: var(--mint-2);
}
.food-badge.phase-done {
  color: var(--deep-green);
  background: var(--mint-3);
}
.food-badge.phase-failed,
.food-badge.phase-need_retake {
  color: var(--danger);
  background: var(--rose-tint);
}

.head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 32rpx 0 16rpx;
}
.head-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
}

.nutrient-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}
.macro-card {
  padding: 22rpx 16rpx 20rpx;
  border-radius: 6rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  box-sizing: border-box;
  min-height: 168rpx;
}
.macro-card.kind-value {
  border-color: var(--green-strong);
  background: linear-gradient(180deg, var(--tint-1) 0%, var(--surface) 70%);
}
.macro-card.kind-zero {
  border-color: var(--green-strong);
  background: var(--tint-1);
}
.macro-card.kind-unknown {
  border-style: dashed;
  background: var(--paper);
}
.macro-top {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.macro-name {
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.35;
}
.macro-kind {
  font-size: 18rpx;
  color: var(--muted-2);
  align-self: flex-start;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: var(--tint-2);
}
.kind-value .macro-kind {
  color: var(--deep-green);
  background: var(--mint-2);
}
.kind-zero .macro-kind {
  color: var(--muted);
  background: var(--tint-2);
}
.kind-unknown .macro-kind {
  color: var(--muted-2);
  background: var(--linen-1);
}
.macro-value {
  color: var(--ink);
  font-size: 42rpx;
  margin-top: 18rpx;
  font-weight: 500;
  line-height: 1.1;
}
.macro-value text {
  font-size: 22rpx;
  margin-left: 6rpx;
  color: var(--muted);
  font-weight: 400;
}
.macro-value.is-unknown {
  color: var(--muted-2);
  font-weight: 400;
  letter-spacing: 2rpx;
}

.food-sync {
  border-top: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
  margin-top: 30rpx;
  padding: 24rpx 0;
}
.food-sync-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  font-size: 27rpx;
}
.food-sync-head .sub {
  font-size: 22rpx;
  margin-top: 8rpx;
}
.food-sync switch {
  transform: scale(0.8);
  transform-origin: right center;
  flex: none;
}
.food-save {
  width: 100% !important;
  margin-top: 30rpx;
}
.food-manual {
  width: 100% !important;
  max-width: none;
  margin-top: 12rpx;
}
.food-mode {
  margin-top: 22rpx;
  align-items: center;
}
.food-mode-label {
  font-size: 26rpx;
  color: var(--muted);
}
.mode-group {
  display: flex;
  gap: 20rpx;
}
.mode-item {
  font-size: 24rpx;
  color: var(--ink);
}
.food-edit {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 8rpx 0;
}
.food-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  min-height: 72rpx;
}
.food-row-top {
  align-items: flex-start;
  padding-top: 8rpx;
}
.food-label {
  width: 150rpx;
  flex: none;
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.4;
}
.food-input {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  height: 72rpx;
  line-height: 72rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 6rpx;
  padding: 0 18rpx;
  font-size: 28rpx;
  color: var(--ink);
}
.food-picker {
  display: flex;
  align-items: center;
}
.food-portion {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}
.food-portion .food-input {
  flex: 1;
}
.food-unit {
  flex: none;
  width: 36rpx;
  font-size: 24rpx;
  color: var(--muted);
  text-align: left;
}
.food-meals {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.food-meal {
  padding: 10rpx 18rpx;
  border-radius: 6rpx;
  border: 1rpx solid var(--line);
  font-size: 24rpx;
  color: var(--muted);
  background: var(--blue-tint);
}
.food-meal.on {
  background: var(--accent);
  color: var(--on-accent);
  border-color: var(--accent);
}
.food-unc {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  font-size: 22rpx;
  color: var(--warm-ink);
  padding-left: 166rpx;
}

@keyframes foodBarSlide {
  from {
    background-position: 100% 0;
  }
  to {
    background-position: -100% 0;
  }
}

.ui-reduced .food-scan-bar,
.ui-reduced .food-photo-ready {
  animation: none !important;
  transition: none !important;
}
@media (prefers-reduced-motion: reduce) {
  .food-scan-bar {
    animation: none !important;
  }
}
