.food-page { padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); }.food-kicker { font-size: 22rpx; color: #7d9170; margin-top: 8rpx; }.food-title { font-size: 39rpx; font-weight: 500; margin: 18rpx 0; line-height: 1.5; }
.food-photo { height: 350rpx; border-radius: 24rpx; background: #edf4e6; border: 1rpx solid #e0ead6; margin-top: 30rpx; overflow: hidden; position: relative; }.food-photo image { width: 100%; height: 100%; }.food-photo > text { position: absolute; bottom: 12rpx; left: 18rpx; font-size: 21rpx; color: #ffffff; background: rgba(39,64,37,.65); padding: 5rpx 12rpx; border-radius: 8rpx; }
.food-empty { display: flex; flex-direction: column; justify-content: center; align-items: center; color: #5f7f51; gap: 18rpx; font-size: 28rpx; }.food-empty > text { position: static; background: transparent; color: #819377; font-size: 22rpx; padding: 0 20rpx; text-align: center; }
.plate-mark { width: 94rpx; height: 94rpx; border: 2rpx solid #9bb58e; border-radius: 50%; display: flex; align-items: center; justify-content: center; }.plate-mark view { width: 66rpx; height: 66rpx; border: 1rpx solid #b6cba8; border-radius: 50%; }
.food-local-note,.food-estimate-note { color: #809076; font-size: 22rpx; line-height: 1.8; margin-top: 18rpx; }.food-error { font-size: 23rpx; color: #a25f3f; margin-top: 16rpx; }.food-badge { font-size: 21rpx; color: #8d896d; background: #f2f1e8; padding: 7rpx 12rpx; border-radius: 12rpx; }
.nutrient-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 14rpx; }.nutrient-grid > view { padding: 24rpx 14rpx; border-radius: 20rpx; background: #ffffff; border: 1rpx solid #e0e7dc; }.nutrient-grid > view > text { color: #7b8874; font-size: 23rpx; }.nutrient-grid view view { color: #57784c; font-size: 42rpx; margin-top: 16rpx; }.nutrient-grid view view text { font-size: 22rpx; margin-left: 8rpx; color: #8e9a86; }
.food-sync { border-top: 1rpx solid #e0e7dc; border-bottom: 1rpx solid #e0e7dc; margin-top: 30rpx; padding: 24rpx 0; }.food-sync-head { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; font-size: 27rpx; }.food-sync-head .sub { font-size: 22rpx; margin-top: 8rpx; }.food-sync switch { transform: scale(.8); transform-origin: right center; flex: none; }.food-save { width: 100% !important; margin-top: 30rpx; }.food-manual { width: 100% !important; max-width: none; margin-top: 12rpx; }
