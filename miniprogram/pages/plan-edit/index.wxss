@import "../../styles/interaction.wxss";
.page-solo {
  padding-bottom: 60rpx;
}

.aset {
  margin-top: 12rpx;
  padding: 12rpx;
  background: #f1f4ee;
  border-radius: 8rpx;
}

.aset-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.aset-no {
  font-weight: 600;
}

.mini-field {
  width: 110rpx;
  padding: 8rpx 10rpx;
  background: var(--surface);
  border: 2rpx solid #e0e7dc;
  border-radius: 10rpx;
  font-size: 24rpx;
  text-align: center;
}
.tools { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 16rpx 0; }
.tools button { flex: 1 1 150rpx; margin: 0; }
input.field { height: 88rpx; padding: 0 24rpx; line-height: 88rpx; }
.basis { padding: 16rpx 0; }
textarea.field { box-sizing: border-box; width: 100%; height: 160rpx; }
.sheet-set { padding:24rpx 0;border-top:1rpx solid #dce2e8; }
.sheet-set training-number-control { margin:12rpx 0; }
