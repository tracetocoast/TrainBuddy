.page-solo {
  padding-bottom: 60rpx;
}

.chip-row {
  white-space: nowrap;
  margin: 20rpx 0;
}

.chip {
  display: inline-flex;
  margin-right: 12rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: var(--surface);
  border: 2rpx solid #e0e7dc;
  font-size: 22rpx;
  font-weight: 600;
  color: #6e7c72;
}

.chip.on {
  background: #e6f0e4;
  border-color: #a5c5a7;
  color: #25352c;
}
