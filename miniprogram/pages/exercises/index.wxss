.exercise-library { height:100vh; box-sizing:border-box; padding-bottom:env(safe-area-inset-bottom); display:flex; flex-direction:column; overflow:hidden; background:var(--paper); color:var(--ink); }
.exercise-library.pick-mode { padding-bottom:0; }
.exercise-tile.picked { border-color:var(--accent); background:var(--mint-1); box-shadow:none; }
.pick-mark { margin-top:8rpx; color:var(--accent); font-size:20rpx; font-weight:650; }
.pick-bar { flex:none; display:flex; align-items:center; gap:16rpx; padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); background:var(--surface); border-top:1rpx solid var(--line); }
.pick-count { flex:1; font-size:26rpx; font-weight:650; color:var(--ink); }
.pick-bar .primary { flex:none; width:auto !important; min-width:240rpx; }
.library-toolbar { flex:none; padding:20rpx 24rpx; border-bottom:1rpx solid var(--line); background:var(--surface); }
.search-box { display:flex; align-items:center; gap:14rpx; min-height:88rpx; padding:0 20rpx; border-radius:6rpx; background:var(--surface-raised); }
.library-search { flex:1; min-width:0; height:88rpx; font-size:28rpx; }
.clear-search { flex:none; width:auto !important; min-height:44px; padding:12rpx 0 12rpx 12rpx; font-size:23rpx; color:var(--accent); }
.library-main { display:flex; flex:1; min-height:0; overflow:hidden; }
.body-sidebar { flex:none; width:140rpx; height:100%; background:var(--surface-raised); border-right:1rpx solid var(--line); }
.body-option { display:flex; align-items:center; justify-content:center; width:100% !important; min-height:100rpx; padding:20rpx 12rpx; border-radius:0; font-size:26rpx; line-height:1.5; color:var(--muted); border-left:5rpx solid transparent; overflow-wrap:break-word; }
.body-option.selected { color:var(--accent); background:var(--surface); border-left-color:var(--accent); font-weight:650; }
.sidebar-caption { padding:24rpx 8rpx 8rpx; color:var(--muted); font-size:20rpx; text-align:center; }
.facet-retry { width:100% !important; min-height:44px; padding:16rpx 8rpx; color:var(--accent); font-size:22rpx; }
.results-pane { flex:1; min-width:0; display:flex; flex-direction:column; overflow:hidden; }
.equipment-strip { flex:none; width:100%; white-space:nowrap; padding:18rpx 16rpx 10rpx; box-sizing:border-box; }
.equipment-option { display:inline-flex; align-items:center; justify-content:center; width:auto !important; min-height:44px; margin-right:10rpx; padding:12rpx 20rpx; border:1rpx solid var(--line); border-radius:6rpx; background:var(--surface); color:var(--muted); font-size:24rpx; vertical-align:middle; }
.equipment-option.selected { border-color:var(--accent); color:var(--accent); background:var(--soft); font-weight:600; }
.results-heading { display:flex; align-items:baseline; flex-wrap:wrap; gap:8rpx 14rpx; flex:none; padding:18rpx 20rpx; }
.results-title { font-size:29rpx; font-weight:650; overflow-wrap:break-word; }
.results-count { color:var(--muted); font-size:22rpx; }
.results-scroll { flex:1; min-height:0; height:0; width:100%; }
.exercise-grid { display:grid; grid-template-columns:minmax(0,1fr); gap:0; padding:0 20rpx 20rpx; }
.exercise-tile { position:relative; display:grid; grid-template-columns:88rpx minmax(0,1fr); column-gap:16rpx; width:100% !important; min-width:0; padding:24rpx 0; border:0; border-bottom:1rpx solid var(--line); border-radius:0; background:transparent; text-align:left; }
.exercise-art { grid-row:1 / span 3; width:88rpx; height:100rpx; display:flex; align-items:center; justify-content:center; overflow:hidden; }
.exercise-image { width:100%; height:100%; }
.image-placeholder { display:flex; flex-direction:column; align-items:center; gap:12rpx; color:var(--muted); font-size:17rpx; text-align:center; }
.exercise-name { min-width:0; padding-right:12rpx; font-size:26rpx; line-height:1.5; font-weight:600; overflow-wrap:break-word; }
.exercise-meta { margin-top:6rpx; font-size:21rpx; line-height:1.5; color:var(--muted); overflow-wrap:break-word; }
.library-state { padding:24rpx 20rpx; color:var(--muted); font-size:24rpx; line-height:1.65; }
.error-state { color:var(--danger); }
.retry-button { width:auto !important; min-height:44px; color:var(--accent); text-align:left; font-size:25rpx; }
.end-state { text-align:center; padding-bottom:40rpx; }
@media (max-width:340px) { .body-sidebar { width:120rpx; } .body-option { font-size:25rpx; } .exercise-grid { gap:12rpx; padding:0 12rpx 12rpx; } .exercise-tile { position:relative; display:grid; grid-template-columns:88rpx minmax(0,1fr); column-gap:16rpx; width:100% !important; min-width:0; padding:24rpx 0; border:0; border-bottom:1rpx solid var(--line); border-radius:0; background:transparent; text-align:left; } .exercise-art { grid-row:1 / span 3; width:88rpx; height:100rpx; display:flex; align-items:center; justify-content:center; overflow:hidden; } .exercise-name { min-width:0; padding-right:12rpx; font-size:26rpx; line-height:1.5; font-weight:600; overflow-wrap:break-word; } }

.exercise-use-count{grid-column:2;grid-row:3;color:var(--muted);font-size:20rpx;}

.workout-shortcuts { padding: 12rpx 0; }
.shortcut-filters { display: flex; gap: 12rpx; margin-bottom: 10rpx; }
.shortcut-row { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; width: 100%; min-height: 44px; text-align: left; color: var(--ink); border-bottom: 1rpx solid var(--line); }
.shortcut-row > text, .shortcut-date { flex-shrink: 0; color: var(--muted); font-size: 23rpx; }
.reset-filters { align-self: flex-start; padding: 4rpx 16rpx; }
.shortcut-row.selected { color: var(--accent); }
