.page-solo {
  padding-bottom: 60rpx;
}

.chip-row {
  white-space: nowrap;
  margin: 20rpx 0;
}

.chip {
  display: inline-flex;
  margin-right: 12rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: var(--surface);
  border: 2rpx solid #304351;
  font-size: 22rpx;
  font-weight: 700;
  color: #91a6b6;
}

.chip.on {
  background: #28465b;
  border-color: #52718a;
  color: #e4edf3;
}
