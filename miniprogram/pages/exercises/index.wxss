.page-solo {
  padding-bottom: 60rpx;
}

.chip-row {
  white-space: nowrap;
  margin: 20rpx 0;
}

.chip {
  display: inline-flex;
  margin-right: 12rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: var(--surface);
  border: 2rpx solid var(--line);
  font-size: 22rpx;
  font-weight: 600;
  color: var(--muted);
}

.chip.on {
  background: #edf1ff;
  border-color: #b7c6f9;
  color: var(--ink);
}
