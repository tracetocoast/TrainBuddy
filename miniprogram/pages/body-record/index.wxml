<view class="body-page record-page">
  <view class="body-heading">记录身体数据</view>
  <view class="body-caption">每次测量独立保存，留下真实变化</view>
  <view class="body-status" wx:if="{{loading}}">正在读取…</view>
  <view class="body-status" wx:elif="{{error}}"><view>{{error}}</view><button class="link" bindtap="reload">重试</button></view>
  <block wx:else>
    <view class="record-options">
      <picker range="{{metricNames}}" value="{{metricIndex}}" bindchange="onMetric" disabled="{{saving}}"><view class="record-option"><text>测量项目</text><text>{{metric.label}} <text class="metric-arrow">›</text></text></view></picker>
      <picker mode="date" value="{{date}}" start="1900-01-01" end="{{today}}" bindchange="onDate" disabled="{{saving}}"><view class="record-option"><text>测量日期</text><text>{{date}} <text class="metric-arrow">›</text></text></view></picker>
      <picker mode="time" value="{{time}}" bindchange="onTime" disabled="{{saving}}"><view class="record-option"><text>测量时间</text><text>{{time}} <text class="metric-arrow">›</text></text></view></picker>
    </view>
    <view class="record-input-label">{{metric.label}}</view>
    <view class="record-value-row"><input class="record-value" type="digit" value="{{value}}" placeholder="0.0" maxlength="8" bindinput="onInput" disabled="{{saving}}" /><text>{{displayUnit}}</text></view>
    <view class="record-hint">{{metric.key === 'targetWeight' ? '目标体重作为个人目标单独保留，不会替代实际体重。' : metric.key === 'shoulder' ? '肩围是绕肩一周的长度，不是肩宽。' : metric.unit === 'cm' && metric.key !== 'height' ? '保持相同测量位置；单侧围度请始终测量同一侧。' : '尽量保持相同测量时间和条件，方便日后比较。'}}</view>
    <view class="record-previous" wx:if="{{previous}}">上次 {{previous}}</view>
    <button class="link record-history-link" bindtap="onHistory">查看{{metric.label}}历史与趋势 ›</button>
    <button class="record-save" bindtap="onSave" disabled="{{saving || !value}}" loading="{{saving}}">保存本次测量</button>
    <view class="body-privacy">每次的时间与数值均保留，历史记录不会覆盖 · 仅自己可见</view>
  </block>
</view>
