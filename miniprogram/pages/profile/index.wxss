.page-solo {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.tag-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.scope-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
}

.invite-box {
  margin-top: 20rpx;
  padding: 20rpx;
  background: var(--surface-raised);
  border-radius: 20rpx;
  text-align: center;
}

.menu {
  font-size: 28rpx;
  font-weight: 600;
}

.info-row { display:flex; align-items:center; justify-content:space-between; gap:24rpx; padding:22rpx 0; border-bottom:1rpx solid var(--line); font-size:26rpx; }
.info-row > text:first-child { color:var(--muted); flex-shrink:0; }
.account-id { overflow-wrap:anywhere; text-align:right; }
.role-entry { width:100%; margin-top:24rpx; min-height:88rpx; }

.skin-switch { position:relative; display:flex; flex-shrink:0; padding:6rpx; background:var(--surface-raised); border-radius:999rpx; }
.skin-thumb { position:absolute; top:6rpx; bottom:6rpx; left:6rpx; width:calc(50% - 6rpx); background:var(--accent); border-radius:999rpx; transition:transform 260ms var(--ease-spring); }
.skin-switch-dark .skin-thumb { transform:translateX(100%); }
.skin-option { position:relative; z-index:1; min-height:0; margin:0; padding:10rpx 18rpx; border-radius:999rpx; font-size:24rpx; font-weight:600; color:var(--muted); line-height:1.4; background:transparent; transition:color 220ms ease; }
.skin-option-on { color:var(--on-accent); }

/* V1.5 皮肤切换 circle-blur 遮罩（模拟 View Transitions 的 circle-blur-reveal） */
.skin-reveal {
  position: fixed;
  width: 100rpx;
  height: 100rpx;
  margin: -50rpx 0 0 -50rpx;
  border-radius: 50%;
  z-index: 9999;
  pointer-events: none;
  transform: scale(0);
}
.skin-reveal-expand {
  animation: skin-reveal-expand 233ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
}
@keyframes skin-reveal-expand {
  from { transform: scale(0); filter: blur(14px); }
  to { transform: scale(var(--reveal-scale)); filter: blur(0); }
}
.skin-reveal-fade {
  animation: skin-reveal-fade 80ms ease forwards;
}
@keyframes skin-reveal-fade {
  from { opacity: 1; }
  to { opacity: 0; }
}
