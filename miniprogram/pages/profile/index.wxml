<page-meta background-color="{{pageBg}}" />
<view class="page page-solo {{skinClass}}">
  <view class="eyebrow">ACCOUNT · PROFILE</view>
  <view class="title">{{displayName}}</view>
  <view class="sub">账号信息、服务关系与隐私设置</view>

  <view class="head"><view class="head-title">账号信息</view></view>
  <view class="card account-info">
    <view class="info-row"><text>昵称</text><text>{{displayName}}</text></view>
    <view class="info-row"><text>账号 ID</text><text class="account-id" selectable>{{userId}}</text></view>
    <view class="info-row"><text>当前身份</text><text>{{role === 'coach' ? '教练' : '学员'}}</text></view>
    <button class="secondary role-entry" wx:if="{{canSwitchRole}}" bindtap="onSwitchRole">切换成{{role === 'coach' ? '学员' : '教练'}}</button>
    <button class="secondary role-entry" wx:if="{{role === 'student' && !canSwitchCoach}}" bindtap="onApplyCoach">申请教练资格</button>
  </view>

  <block wx:if="{{role === 'student'}}">
  <view class="head">
    <view class="head-title">服务关系</view>
    <button class="link" bindtap="goBind" wx:if="{{!primaryBinding}}">去绑定 ↗</button>
  </view>

  <view class="card" wx:if="{{primaryBinding}}">
    <view class="flex">
      <view class="ico">教练</view>
      <view class="grow">
        <view class="card-title">主教练 · {{primaryBinding.coachName}}</view>
        <view class="sub">状态 {{primaryBinding.status}} · 绑定于 {{boundAtText}}</view>
      </view>
    </view>
    <view class="scope-tags">
      <text class="tag" wx:for="{{activeScopeLabels}}" wx:key="*this">{{item}}</text>
      <text class="tag" wx:if="{{!activeScopeLabels.length}}">暂无授权类别</text>
    </view>
    <view class="twobtn">
      <button class="secondary" bindtap="goPrivacy">管理授权</button>
      <button class="secondary" bindtap="onUnbind">解绑</button>
    </view>
  </view>
  <view class="card sub" wx:else>尚未绑定教练。绑定后可约课与共享日记。</view>

  </block>

  <view class="head" wx:if="{{role === 'coach'}}">
    <view class="head-title">教练邀请</view>
  </view>
  <view class="card" wx:if="{{role === 'coach'}}">
    <view class="sub">生成一次性邀请码（约 7 天有效）。学员用码绑定。</view>
    <button class="primary" style="width:100%;margin-top:16rpx" bindtap="onCreateInvite">生成邀请码</button>
    <view class="invite-box" wx:if="{{inviteToken}}">
      <view class="card-title">{{inviteToken}}</view>
      <view class="sub">请复制发给学员 · 请勿包含训练内容</view>
    </view>
  </view>

  <view class="head"><view class="head-title">更多工具</view></view>
  <view class="card menu" wx:if="{{role === 'student'}}" bindtap="goGrowth">我的训练进展</view>
  <view class="card menu" wx:if="{{role === 'student'}}" bindtap="goPoints">积分与成就</view>
  <view class="card menu" bindtap="goTools">辅助工具</view>
  <view class="card menu" wx:if="{{role === 'student'}}" bindtap="goFriends">朋友训练</view>
  <view class="head"><view class="head-title">外观</view></view>
  <view class="card">
    <view class="skin-switch {{skin === 'dark' ? 'skin-switch-dark' : ''}}">
      <view class="skin-thumb"></view>
      <button class="skin-option {{skin === 'light' ? 'skin-option-on' : ''}}" bindtap="onSkinChange" data-skin="light">白色</button>
      <button class="skin-option {{skin === 'dark' ? 'skin-option-on' : ''}}" bindtap="onSkinChange" data-skin="dark">黑色</button>
    </view>
  </view>

  <!-- V1.5 皮肤切换圆形扩散遮罩：新皮肤底色从点击处 circle-blur 扩散，盖住全屏后换肤再淡出 -->
  <view
    wx:if="{{revealActive}}"
    class="skin-reveal {{revealState === 'expand' ? 'skin-reveal-expand' : ''}} {{revealState === 'fade' ? 'skin-reveal-fade' : ''}}"
    style="left:{{revealX}}px;top:{{revealY}}px;background:{{revealBg}};--reveal-scale:{{revealScale}};"
  ></view>

  <view class="head"><view class="head-title">更多</view></view>
  <view class="card menu" bindtap="goPrivacy">隐私与授权管理</view>
  <view class="card menu" bindtap="onLogout">退出登录</view>
</view>
