@import "../../styles/interaction.wxss";

.page {
  padding-bottom: calc(300rpx + env(safe-area-inset-bottom));
}

/* 微信原生 button：用固定行高 + flex，避免文字偏上/不居中 */
.page button.primary,
.page button.secondary,
.page button.link,
.ix-workout-dock button {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  text-align: center;
  line-height: 1.25;
  box-sizing: border-box;
}

.page button.primary,
.page button.secondary {
  min-height: 88rpx;
  padding: 0 28rpx;
}

.page .twobtn > button {
  width: 100%;
}

.exercise {
  margin-top: 20rpx;
  padding: 24rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-card);
  background: var(--surface);
}

.exercise > .flex {
  margin-bottom: 8rpx;
}

.aset {
  display: block;
  margin-top: 16rpx;
  padding: 20rpx;
  background: var(--surface-raised);
  border-radius: 24rpx;
  border: 1rpx solid transparent;
}

.aset.ix-focus {
  border-color: rgba(40, 116, 78, 0.28);
  background: #f6faf4;
}

.aset-main {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}

.aset-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.aset-head-text {
  flex: 1;
  min-width: 0;
}

.aset-no {
  display: inline-block;
  font-weight: 650;
  font-size: 28rpx;
  color: var(--ink);
  margin-right: 8rpx;
  line-height: 1.4;
}

.aset-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 23rpx;
  color: var(--muted);
  line-height: 1.55;
}

.aset-edit {
  width: 100% !important;
  margin-top: 4rpx;
  min-height: 80rpx !important;
  font-size: 25rpx !important;
}

.aset-inputs {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 4rpx;
}

.aset-inputs training-number-control {
  width: 100%;
}

.ix-tools {
  display: flex;
  gap: 12rpx;
  margin: 4rpx 0 0;
}

.ix-tools button {
  flex: 1;
  min-width: 0;
  min-height: 80rpx !important;
  font-size: 25rpx !important;
  padding: 0 16rpx !important;
}

.aset-actions {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  margin-top: 16rpx;
}

.aset-actions > button {
  flex: 1;
  min-width: 0;
  min-height: 96rpx !important;
  margin: 0;
}

.aset-actions .tag {
  align-self: center;
}

.finish-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 28rpx;
}

.finish-card .grow {
  flex: 1;
  min-width: 0;
}

.finish-card > button {
  flex: none;
  width: auto !important;
  min-width: 220rpx;
  min-height: 88rpx !important;
  padding: 0 28rpx !important;
}

.abandon-btn {
  width: 100% !important;
  margin-top: 12rpx;
}

.ix-workout-dock {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(124rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 18rpx;
  background: #1c3d2e;
  color: #fff;
  border-radius: 28rpx;
  z-index: 30;
  box-shadow: 0 8rpx 24rpx rgba(28, 61, 46, 0.18);
}

.dock-summary {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  font-size: 22rpx;
  line-height: 1.35;
  color: rgba(255, 255, 255, 0.82);
}

.dock-number {
  font-size: 28rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: #fff;
  line-height: 1.3;
}

.dock-complete {
  flex: none;
  width: auto !important;
  min-width: 200rpx;
  min-height: 88rpx !important;
  padding: 0 24rpx !important;
  margin: 0;
  background: #c7e8a8;
  color: #1c3d2e;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.dock-complete::after {
  border: none;
}
