@import "../../styles/interaction.wxss";

.page {
  padding-bottom: calc(240rpx + env(safe-area-inset-bottom));
}

/* 微信原生 button 文字垂直居中：去掉默认行高偏移 */
.page button,
.proto-dock button,
.rest button,
.exercise-done button,
.workout-exec button {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  text-align: center !important;
  line-height: 1.2 !important;
  box-sizing: border-box;
}

.page button.primary,
.page button.secondary,
.page button.entry-btn {
  min-height: 88rpx;
  height: 88rpx;
  padding: 0 24rpx !important;
}

.page .twobtn > button,
.workout-entry-btns > button {
  width: 100%;
  margin: 0 !important;
}

.workout-entry-btns {
  margin-top: 20rpx;
  margin-bottom: 8rpx;
}

.entry-btn {
  font-size: 26rpx !important;
  font-weight: 650 !important;
}

.workout-exec.is-session {
  --ink: var(--pine-ink);
  --muted: var(--muted-2);
  --paper: var(--linen-1);
  --surface: var(--linen-1);
  --line: var(--linen-3);
  --green-dark: var(--graphite);
  --green-ink: var(--graphite-ink);
  --green-soft: var(--mint-1);
  background: var(--paper);
  color: var(--ink);
  min-height: 100vh;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: calc(360rpx + env(safe-area-inset-bottom));
}

.wheel-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 8rpx 0;
}

.wheel-back,
.wheel-more {
  width: 72rpx !important;
  height: 72rpx !important;
  min-height: 72rpx !important;
  margin: 0 !important;
  padding: 0 !important;
  border-radius: 50% !important;
  background: var(--surface) !important;
  color: var(--green-ink) !important;
  font-size: 40rpx !important;
  font-weight: 600;
}

.wheel-more {
  color: var(--muted) !important;
  font-size: 32rpx !important;
}

.wheel-back::after,
.wheel-more::after { border: none; }

.wheel-back-space { width: 72rpx; height: 72rpx; }

.wheel-top-title {
  flex: 1;
  text-align: center;
  margin: 0 12rpx;
  min-width: 0;
}

.wheel-top-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.wheel-top-mode {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--muted);
}

.wheel-section { padding-top: 8rpx; }

.wheel-eyebrow {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: var(--accent);
  font-weight: 900;
}

.wheel-h1 {
  margin-top: 10rpx;
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: -1.2rpx;
  line-height: 1.15;
}

.wheel-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.5;
}

.plan-dots {
  display: flex;
  gap: 10rpx;
  margin-top: 24rpx;
}

.plan-dot {
  flex: 1;
  height: 10rpx;
  border-radius: 99rpx;
  background: var(--linen-3);
}

.plan-dot.active { background: var(--accent); }

.wheel-mode {
  display: inline-flex;
  align-items: center;
  gap: 0;
  margin-top: 24rpx;
  padding: 6rpx;
  border-radius: 99rpx;
  background: var(--linen-2);
  font-size: 20rpx;
  color: var(--muted);
}

.wheel-mode text { padding: 12rpx 18rpx; }

.wheel-mode-on {
  background: var(--surface);
  border-radius: 99rpx;
  color: var(--green-ink);
  font-weight: 800;
}

.carousel-wrap {
  position: relative;
  height: 560rpx;
  margin-top: 8rpx;
  overflow: hidden;
}

.carousel-glow {
  position: absolute;
  left: 0;
  right: 0;
  top: 180rpx;
  height: 280rpx;
  background: radial-gradient(ellipse at center, rgba(40, 116, 78, 0.1), transparent 67%);
  pointer-events: none;
}

.wheel {
  position: absolute;
  left: 50%;
  top: 220rpx;
  width: 100%;
  height: 320rpx;
  transform: translateX(-50%);
}

.wheel-card {
  position: absolute;
  left: 50%;
  top: 0;
  width: 248rpx;
  height: 320rpx;
  margin-left: -124rpx;
  padding: 18rpx;
  border: 1rpx solid var(--line);
  background: var(--surface);
  border-radius: 44rpx;
  box-shadow: 0 16rpx 44rpx rgba(32, 49, 40, 0.08);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.45s, box-shadow 0.45s;
  box-sizing: border-box;
}

.ix-reduced .wheel-card { transition: none; }

.wheel-card.selected {
  box-shadow: 0 28rpx 60rpx rgba(40, 116, 78, 0.2);
  border-color: var(--green-strong);
}

.wheel-card.is-done { filter: grayscale(0.25); }

.wheel-pic {
  height: 150rpx;
  border-radius: 30rpx;
  background: linear-gradient(145deg, var(--mint-2), var(--linen-1));
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.wheel-pic-img {
  width: 100%;
  height: 100%;
}

.wheel-pic-icon { font-size: 64rpx; line-height: 1; }

.wheel-card-name {
  margin-top: 14rpx;
  font-size: 26rpx;
  font-weight: 750;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wheel-card-meta {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: var(--muted);
}

.selection-hint {
  text-align: center;
  margin-top: -8rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.selected-name {
  text-align: center;
  margin-top: 18rpx;
}

.selected-name-b {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
}

.selected-name-s {
  display: block;
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.wheel-start {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: 100% !important;
  height: 96rpx !important;
  min-height: 96rpx !important;
  margin: 24rpx 0 0 !important;
  padding: 0 24rpx !important;
  border-radius: 32rpx !important;
  background: var(--accent) !important;
  color: var(--on-accent) !important;
  font-size: 30rpx !important;
  font-weight: 850 !important;
  line-height: 1.2 !important;
  box-shadow: 0 14rpx 32rpx rgba(40, 116, 78, 0.18);
}

.wheel-start::after { border: none; }

.wheel-start[disabled] {
  opacity: 0.55;
  background: var(--green-strong) !important;
}

.wheel-footer {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 24rpx;
  margin-bottom: 24rpx;
  align-items: stretch;
}

.wheel-footer .secondary,
.wheel-footer .link {
  width: 100% !important;
  margin: 0 !important;
  min-height: 80rpx !important;
  height: 80rpx !important;
  padding: 0 20rpx !important;
}

/* 锁定执行卡 */
.current-card {
  margin-top: 8rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 52rpx;
  overflow: hidden;
  box-shadow: 0 18rpx 44rpx rgba(24, 40, 31, 0.1);
}

.current-card-pop {
  animation: card-enter 0.42s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.ix-reduced .current-card-pop { animation: none; }

@keyframes card-enter {
  0% { transform: scale(0.92); opacity: 0.5; }
  70% { transform: scale(1.02); }
  100% { transform: scale(1); opacity: 1; }
}

.demo {
  position: relative;
  height: 400rpx;
  background: linear-gradient(145deg, var(--mint-2), var(--linen-1));
  display: flex;
  align-items: center;
  justify-content: center;
}

.demo-tag,
.demo-lock {
  position: absolute;
  top: 24rpx;
  padding: 12rpx 18rpx;
  border-radius: 99rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.demo-tag {
  left: 26rpx;
  background: var(--glass-1);
  color: var(--green-ink);
}

.demo-lock {
  right: 26rpx;
  background: rgba(28, 61, 46, 0.9);
  color: var(--on-accent);
}

.demo-figure {
  width: 100%;
  height: 100%;
}

.demo-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.demo-fallback-icon {
  font-size: 120rpx;
  line-height: 1;
}

.info { padding: 32rpx 30rpx 36rpx; }

.info-name {
  font-size: 44rpx;
  font-weight: 900;
  letter-spacing: -0.6rpx;
}

.info-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.baseline {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 30rpx;
  background: var(--green-soft);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.baseline-small {
  font-size: 20rpx;
  color: var(--muted);
}

.baseline-value {
  font-size: 32rpx;
  font-weight: 750;
  color: var(--green-ink);
  font-variant-numeric: tabular-nums;
}

.adjust-note {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: var(--muted);
  line-height: 1.45;
}

.setline {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 28rpx;
}

.setline-small {
  font-size: 20rpx;
  color: var(--muted);
}

.setline-no {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-top: 4rpx;
}

.setline-b {
  font-size: 50rpx;
  font-weight: 850;
  color: var(--green-ink);
  line-height: 1;
}

.set-bar {
  height: 12rpx;
  margin-top: 12rpx;
  border-radius: 99rpx;
  background: var(--linen-3);
  overflow: hidden;
}

.set-bar-fill {
  height: 100%;
  border-radius: 99rpx;
  background: var(--accent);
  transition: width 0.35s ease;
}

.ix-reduced .set-bar-fill { transition: none; }

.controls {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 24rpx;
}

.control {
  background: var(--linen-1);
  border: 1rpx solid var(--line);
  border-radius: 34rpx;
  padding: 20rpx;
}

.control-label {
  display: block;
  font-size: 20rpx;
  color: var(--muted);
  margin-bottom: 12rpx;
}

.stepper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.step {
  width: 64rpx !important;
  height: 64rpx !important;
  min-width: 64rpx !important;
  min-height: 64rpx !important;
  margin: 0 !important;
  padding: 0 !important;
  border-radius: 50% !important;
  background: var(--surface) !important;
  color: var(--green-ink) !important;
  font-size: 34rpx !important;
  font-weight: 500 !important;
  line-height: 1 !important;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
}

.step::after { border: none; }

.value-wrap {
  flex: 1;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4rpx;
}

.value {
  font-size: 44rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}

.unit {
  font-size: 20rpx;
  color: var(--muted);
}

.complete-btn {
  width: 100% !important;
  height: 96rpx !important;
  min-height: 96rpx !important;
  margin-top: 26rpx !important;
  padding: 0 20rpx !important;
  border-radius: 32rpx !important;
  font-size: 30rpx !important;
  font-weight: 850 !important;
  line-height: 1.2 !important;
}

.complete-btn.done { background: var(--green-dark) !important; }

.locked-tools {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tool {
  flex: 1;
  margin: 0 !important;
  min-height: 72rpx !important;
  height: 72rpx !important;
  padding: 0 8rpx !important;
  background: transparent !important;
  border: 1rpx solid var(--line) !important;
  border-radius: 22rpx !important;
  color: var(--muted) !important;
  font-size: 22rpx !important;
  line-height: 1.2 !important;
}

.tool::after { border: none; }

.pending-hint {
  margin-top: 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--warm-ink);
}

.next {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 32rpx;
  background: var(--linen-2);
}

.next-ico {
  width: 68rpx;
  height: 68rpx;
  border-radius: 24rpx;
  background: var(--mint-2);
  color: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  flex: none;
}

.next-b {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
}

.next-s {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--muted);
}

.proto-dock {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(116rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 18rpx;
  min-height: 220rpx;
  padding: 28rpx 28rpx 32rpx;
  background: var(--graphite);
  color: var(--on-accent);
  border-radius: 44rpx;
  z-index: 30;
  box-shadow: 0 20rpx 48rpx rgba(28, 61, 46, 0.25);
  box-sizing: border-box;
}

.dock-big {
  display: block;
  text-align: center;
  font-size: 32rpx;
  font-weight: 750;
  font-variant-numeric: tabular-nums;
  line-height: 1.3;
}

.dock-actions {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  min-height: 108rpx;
}

.dock-skip {
  flex: none;
  width: 160rpx !important;
  margin: 0 !important;
  padding: 0 12rpx !important;
  min-height: 108rpx !important;
  height: 108rpx !important;
  border-radius: 28rpx !important;
  background: rgba(255, 255, 255, 0.12) !important;
  color: rgba(255, 255, 255, 0.92) !important;
  font-size: 26rpx !important;
  font-weight: 700 !important;
  line-height: 1.2 !important;
}

.dock-skip::after { border: none; }

.dock-btn {
  flex: 1;
  width: auto !important;
  height: 108rpx !important;
  min-height: 108rpx !important;
  margin: 0 !important;
  padding: 0 20rpx !important;
  border-radius: 28rpx !important;
  background: var(--signal) !important;
  color: var(--graphite-ink) !important;
  font-weight: 900 !important;
  font-size: 32rpx !important;
  line-height: 1.2 !important;
}

.dock-btn::after { border: none; }

/* 高于 bottom-nav(z-index:100)，避免组歇被底栏遮挡 */
.rest {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: none;
  align-items: flex-end;
  background: rgba(18, 35, 27, 0.48);
}

.rest.show { display: flex; }

.rest-sheet {
  width: 100%;
  background: var(--linen-1);
  border-radius: 56rpx 56rpx 0 0;
  /* 预留底栏高度，避免按钮落在导航后面 */
  padding: 44rpx 40rpx calc(48rpx + 120rpx + env(safe-area-inset-bottom));
  text-align: center;
  box-sizing: border-box;
}

.rest-eyebrow {
  font-size: 20rpx;
  letter-spacing: 2.5rpx;
  color: var(--accent);
  font-weight: 850;
}

.rest-timer {
  margin: 10rpx 0;
  font-size: 108rpx;
  font-weight: 900;
  color: var(--graphite-ink);
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
}

.rest-p {
  font-size: 22rpx;
  color: var(--muted-2);
}

.rest-actions {
  display: flex;
  justify-content: center;
  margin-top: 32rpx;
}

.rest-go {
  width: 100%;
  margin: 0 !important;
  height: 96rpx !important;
  min-height: 96rpx !important;
  padding: 0 16rpx !important;
  border-radius: 28rpx !important;
  font-size: 30rpx !important;
  font-weight: 800 !important;
  line-height: 1.2 !important;
}

.rest-go { background: var(--accent) !important; color: var(--on-accent) !important; }
.rest-go::after { border: none; }

.exercise-done {
  position: fixed;
  inset: 0;
  z-index: 210;
  display: none;
  background: var(--linen-1);
  text-align: center;
  padding: 140rpx 48rpx calc(48rpx + 120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
}

.exercise-done.show { display: block; }

.done-badge {
  width: 148rpx;
  height: 148rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: var(--mint-1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 68rpx;
  animation: card-enter 0.4s ease;
}

.done-h2 {
  margin-top: 28rpx;
  font-size: 52rpx;
  font-weight: 800;
}

.done-p {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--muted-2);
  line-height: 1.7;
}

.done-summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin: 36rpx 0 28rpx;
}

.done-cell {
  background: var(--surface);
  border: 1rpx solid var(--linen-3);
  border-radius: 30rpx;
  padding: 22rpx 8rpx;
}

.done-b {
  display: block;
  font-size: 34rpx;
  font-weight: 750;
}

.done-s {
  display: block;
  margin-top: 6rpx;
  font-size: 18rpx;
  color: var(--muted-2);
}

.done-finish { margin-top: 12rpx !important; }

@media (max-width: 340px) {
  .controls { grid-template-columns: 1fr; }
  .carousel-wrap { height: 480rpx; }
}

 .new-training{width:100%;margin:28rpx 0;padding:24rpx;border-radius:20rpx;}
.free-empty{padding:64rpx 12rpx;}
.compact-heading,.compact-set-row{display:grid;grid-template-columns:56rpx minmax(0,1fr) minmax(0,1fr) 44rpx 72rpx;align-items:center;gap:10rpx;padding:12rpx 0;}
.compact-heading{font-size:22rpx;color:var(--muted);}.compact-set-row{border-top:1rpx solid var(--line);min-height:100rpx;}
.compact-set-row button{margin:0;min-height:76rpx;border-radius:14rpx;}
.compact-set-row .set-type{font-size:26rpx;background:var(--surface-raised);color:var(--ink);}.compact-set-row .is-warmup{color:#b57618;}
.compact-set-row .set-value{display:flex;position:relative;justify-content:center;align-items:center;padding:24rpx 4rpx 8rpx;background:var(--surface-raised);border:1rpx solid var(--line);font-size:30rpx;font-weight:600;}
.set-unit{position:absolute;top:4rpx;left:10rpx;font-size:18rpx;font-weight:400;color:var(--muted);}
.compact-set-row .set-check{background:var(--surface-raised);border:2rpx solid var(--line);color:var(--muted);font-size:42rpx;line-height:1;}
.compact-set-row .is-checked,.set-is-done .set-value{background:var(--accent);border-color:var(--accent);color:#fff;}.set-is-done .set-unit{color:#fff;opacity:.8;}
.group-delete{color:var(--muted);font-size:26rpx;}.group-tools{display:flex;align-items:center;justify-content:space-between;margin:20rpx 0;}.group-tools .secondary{padding:16rpx 24rpx;}
.compact-history{padding:16rpx 0;border-bottom:1rpx solid var(--line);display:flex;flex-direction:column;gap:6rpx;font-size:24rpx;}
.set-editor-mask{position:fixed;inset:0;background:rgba(0,0,0,.3);z-index:500;}.set-editor{position:fixed;left:0;right:0;z-index:501;background:var(--surface);color:var(--ink);padding:28rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));border-radius:28rpx 28rpx 0 0;}.set-editor-head,.set-editor-foot{display:flex;align-items:center;justify-content:space-between;gap:16rpx;}.set-editor-input{height:100rpx;margin:24rpx 0;padding:16rpx;background:var(--surface-raised);border:2rpx solid var(--accent);border-radius:16rpx;font-size:42rpx;}.set-editor-foot text{font-size:22rpx;color:var(--muted);}.set-editor-foot button{padding:18rpx 24rpx;}

.set-editor-options{display:flex;gap:16rpx;margin:24rpx 0;}.set-editor-options button{flex:1;padding:20rpx;}.set-editor-options .type-selected{border-color:var(--accent);color:var(--accent);}
