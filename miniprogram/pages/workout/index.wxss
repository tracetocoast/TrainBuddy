@import "../../styles/interaction.wxss";
@import "../../styles/field-notes.wxss";

.page {
  padding-bottom: calc(240rpx + env(safe-area-inset-bottom));
}

/* 微信原生 button 文字垂直居中：去掉默认行高偏移 */
.page button,
.workout-exec button {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  text-align: center !important;
  line-height: 1.2 !important;
  box-sizing: border-box;
}

.page button.primary,
.page button.secondary,
.page button.entry-btn {
  min-height: 88rpx;
  height: 88rpx;
  padding: 0 24rpx !important;
}

.page .twobtn > button,
.workout-entry-btns > button {
  width: 100%;
  margin: 0 !important;
}

.workout-entry-btns {
  display: grid;
  gap: 12rpx;
  margin: 20rpx 0 8rpx;
}

.draft-toggle { margin: 8rpx auto; }
.draft-list { display: grid; grid-template-columns: minmax(0, 1fr); border-top: 1rpx solid var(--line); }
.draft-list .draft-row {
  flex-direction: column;
  gap: 8rpx;
  width: 100%;
  min-height: 88rpx;
  padding: 16rpx;
  border-bottom: 1rpx solid var(--line);
  background: transparent;
  color: var(--ink);
  font-size: 28rpx;
  overflow-wrap: anywhere;
}
.draft-row::after { border: 0; }

.entry-btn {
  font-size: 26rpx !important;
  font-weight: 650 !important;
}

.workout-exec.is-session {
  --ink: var(--pine-ink);
  --muted: var(--muted-2);
  --paper: var(--linen-1);
  --surface: var(--linen-1);
  --line: var(--linen-3);
  --green-dark: var(--graphite);
  --green-ink: var(--graphite-ink);
  --green-soft: var(--mint-1);
  background: var(--paper);
  color: var(--ink);
  min-height: 100vh;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
}

.wheel-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 8rpx 0;
}

.wheel-back,
.wheel-more {
  width: 72rpx !important;
  height: 72rpx !important;
  min-height: 72rpx !important;
  margin: 0 !important;
  padding: 0 !important;
  border-radius: 50% !important;
  background: var(--surface) !important;
  color: var(--green-ink) !important;
  font-size: 40rpx !important;
  font-weight: 600;
}

.wheel-more {
  color: var(--muted) !important;
  font-size: 32rpx !important;
}

.wheel-back::after,
.wheel-more::after { border: none; }

.wheel-back-space { width: 72rpx; height: 72rpx; }

.wheel-top-title {
  flex: 1;
  text-align: center;
  margin: 0 12rpx;
  min-width: 0;
}

.wheel-top-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.wheel-top-mode {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--muted);
}

.wheel-footer {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 24rpx;
  margin-bottom: 24rpx;
  align-items: stretch;
}

.wheel-footer .secondary,
.wheel-footer .link {
  width: 100% !important;
  margin: 0 !important;
  min-height: 80rpx !important;
  height: 80rpx !important;
  padding: 0 20rpx !important;
}

.info-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.baseline {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 30rpx;
  background: var(--green-soft);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.baseline-small {
  font-size: 20rpx;
  color: var(--muted);
}

.baseline-value {
  font-size: 32rpx;
  font-weight: 750;
  color: var(--green-ink);
  font-variant-numeric: tabular-nums;
}

.adjust-note {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: var(--muted);
  line-height: 1.45;
}

.setline {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 28rpx;
}

.setline-small {
  font-size: 20rpx;
  color: var(--muted);
}

.setline-no {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-top: 4rpx;
}

.setline-b {
  font-size: 50rpx;
  font-weight: 850;
  color: var(--green-ink);
  line-height: 1;
}

.set-bar {
  height: 12rpx;
  margin-top: 12rpx;
  border-radius: 99rpx;
  background: var(--linen-3);
  overflow: hidden;
}

.set-bar-fill {
  height: 100%;
  border-radius: 99rpx;
  background: var(--accent);
  transition: width 0.35s ease;
}

.ix-reduced .set-bar-fill { transition: none; }

.controls {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 24rpx;
}

.control {
  background: var(--linen-1);
  border: 1rpx solid var(--line);
  border-radius: 34rpx;
  padding: 20rpx;
}

.control-label {
  display: block;
  font-size: 20rpx;
  color: var(--muted);
  margin-bottom: 12rpx;
}

.stepper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.step {
  width: 64rpx !important;
  height: 64rpx !important;
  min-width: 64rpx !important;
  min-height: 64rpx !important;
  margin: 0 !important;
  padding: 0 !important;
  border-radius: 50% !important;
  background: var(--surface) !important;
  color: var(--green-ink) !important;
  font-size: 34rpx !important;
  font-weight: 500 !important;
  line-height: 1 !important;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
}

.step::after { border: none; }

.value-wrap {
  flex: 1;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4rpx;
}

.value {
  font-size: 44rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}

.unit {
  font-size: 20rpx;
  color: var(--muted);
}

.complete-btn {
  width: 100% !important;
  height: 96rpx !important;
  min-height: 96rpx !important;
  margin-top: 26rpx !important;
  padding: 0 20rpx !important;
  border-radius: 32rpx !important;
  font-size: 30rpx !important;
  font-weight: 850 !important;
  line-height: 1.2 !important;
}

.complete-btn.done { background: var(--green-dark) !important; }

.locked-tools {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tool {
  flex: 1;
  margin: 0 !important;
  min-height: 72rpx !important;
  height: 72rpx !important;
  padding: 0 8rpx !important;
  background: transparent !important;
  border: 1rpx solid var(--line) !important;
  border-radius: 22rpx !important;
  color: var(--muted) !important;
  font-size: 22rpx !important;
  line-height: 1.2 !important;
}

.tool::after { border: none; }

.pending-hint {
  margin-top: 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--warm-ink);
}

.next {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 32rpx;
  background: var(--linen-2);
}

.next-ico {
  width: 68rpx;
  height: 68rpx;
  border-radius: 24rpx;
  background: var(--mint-2);
  color: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  flex: none;
}

.next-b {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
}

.next-s {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--muted);
}

@media (max-width: 340px) {
  .controls { grid-template-columns: 1fr; }
}

.workout-exec .new-training { width: 100% !important; max-width: none; margin: 24rpx 0; border-radius: 20rpx; }
.free-empty { padding: 48rpx 12rpx; text-align: center; }
.compact-heading,
.compact-set-row {
  display: grid;
  grid-template-columns: 44px minmax(0, 1.15fr) minmax(0, 1fr) 44px;
  align-items: center;
  gap: 6px;
  padding: 6px;
  border: 1px solid transparent;
}

.compact-heading { color: var(--muted); font-size: 12px; text-align: center; }
.column-unit { font-size: 10px; }
.compact-set-row { border-top-color: var(--line); border-radius: 8px; }
.compact-set-row button {
  width: 100%;
  min-width: 0;
  min-height: 44px;
  padding: 0;
  margin: 0;
  border-radius: 8px;
}
.compact-set-row .set-type { background: var(--surface-raised); color: var(--ink); font-size: 14px; }
.compact-set-row .is-warmup { color: var(--warn-ink); }
.compact-set-row .set-value {
  width: 100%;
  min-width: 0;
  height: 44px;
  border: 1rpx solid var(--line);
  border-radius: 8px;
  background: var(--surface-raised);
  color: var(--ink);
  font-size: 16px;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  text-align: center;
}
.compact-set-row .set-value:focus { border-color: var(--accent); }
.set-placeholder { color: var(--muted); }
.compact-set-row .set-check {
  height: 44px;
  border: 1px solid var(--accent);
  background: var(--surface-raised);
  color: var(--accent);
  font-size: 12px;
  font-weight: 700;
}
.compact-set-row .set-check::after { border: none; }
.compact-set-row.set-is-done { background: var(--ok-bg); border-color: var(--ok-line); }
.set-is-done .set-value { border-color: transparent; background: transparent; }
.compact-set-row .is-checked { background: var(--ok-bg); color: var(--ok-ink); font-size: 18px; }
.inline-training-status {
  position: fixed;
  z-index: 5;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(112rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 4rpx 12rpx;
  background: var(--ok-bg);
  color: var(--ok-ink);
  border: 1rpx solid var(--ok-line);
  border-radius: 16rpx;
  font-size: 24rpx;
}
.group-tools { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8rpx 14rpx; margin: 12rpx 0; }
.group-tools .action-tool {
  width: auto;
  min-height: 44px;
  margin: 0;
  padding: 0 16rpx;
  background: transparent;
  color: var(--ink);
  font-size: 26rpx;
}
.action-tool::after { border: 0; }
.group-tools .action-tool-main { color: var(--ok-ink); font-weight: 650; }
.group-tools-secondary .action-tool { font-size: 24rpx; color: var(--muted); }
.group-tools-secondary .action-tool-remove { color: var(--danger-ink); }
.group-tools .action-tool[disabled] { color: var(--disabled-ink); opacity: .75; }
.workout-exercise-history { padding: 8rpx 12rpx; border-top: 1rpx solid var(--line); border-bottom: 1rpx solid var(--line); }
.compact-history { padding: 16rpx 0; display: flex; flex-direction: column; gap: 6rpx; font-size: 24rpx; color: var(--ink); overflow-wrap: anywhere; }
.compact-history + .compact-history { border-top: 1rpx solid var(--line); }
.workout-action { display: grid; grid-template-columns: minmax(0, 1fr); border-top: 1rpx solid var(--line); }
.workout-action .workout-action-head { width: 100% !important; max-width: none; min-height: 60px; padding: 8px 0; background: transparent; color: var(--ink); }
.workout-action-head::after { border: 0; }
.workout-action-header-grid { width: 100%; display: grid; grid-template-columns: 40px minmax(0, 1fr) 40px; align-items: center; gap: 8px; }
.workout-action-thumb-slot { height: 40px; }
.workout-action-thumb { display: block; width: 40px; height: 40px; border-radius: 6px; background: var(--surface-raised); }
.workout-action-copy { min-width: 0; text-align: center; }
.workout-action-name { display: block; font-size: 17px; font-weight: 700; overflow-wrap: anywhere; }
.action-chevron { color: var(--muted); }
.workout-action-detail { padding: 4px 0 16px; text-align: center; color: var(--ink); }
.workout-action-detail .sub, .workout-action-copy .sub { color: var(--muted); }
.workout-weight-hint { margin-top: 12rpx; }
.set-row-feedback, .set-row-menu { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 8px; font-size: 12px; color: var(--muted); }
.set-row-feedback, .set-row-menu { justify-content: center; align-items: center; }
.set-row-menu .link, .set-row-feedback .link { min-height: 44px; padding: 0 10rpx; margin: 0; }

.training-start {
  padding: 28rpx;
  background: var(--fn-inset);
  color: var(--fn-ink);
  border-radius: 20rpx;
}
.training-start-title { font-size: 34rpx; font-weight: 700; }
.training-start-note { font-size: 24rpx; color: var(--fn-muted); }
.training-start .primary { background: var(--fn-clay); color: #fff; border-color: var(--fn-clay); }
.compact-set-row .set-check.is-skipped { border-color: var(--line); color: var(--muted); font-size: 11px; }
.compact-set-row .set-type.is-warmup { background: var(--warn-soft); color: var(--warn-ink); }

.workout-exec.is-session.field-notes {
  --paper: var(--fn-paper);
  --ink: var(--fn-ink);
  --muted: var(--fn-muted);
  --line: var(--fn-line);
  --accent: var(--fn-clay);
  --surface: var(--fn-paper);
  --surface-raised: var(--fn-inset);
  padding: 0 50rpx calc(32rpx + env(safe-area-inset-bottom));
}
.fn-workout-nav { display: grid; grid-template-columns: 72rpx minmax(0, 1fr) 112rpx; align-items: center; text-align: center; font-weight: 700; }
.fn-back { font-size: 40rpx; }
.fn-workout-heading { padding: 26rpx 0 24rpx; }
.fn-workout-heading .fn-title { font-size: 58rpx; margin: 18rpx 0; }
.fn-workout-meta, .fn-exercise-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8rpx; }
.fn-progress { height: 4rpx; background: var(--fn-line); margin-top: 32rpx; }
.fn-progress view { height: 100%; background: var(--fn-clay); }
.field-notes .workout-action { border-top: 0; border-bottom: 1rpx solid var(--fn-line); }
.field-notes .workout-action .workout-action-head { justify-content: space-between !important; min-height: 92rpx; text-align: left !important; }
.fn-exercise-copy { display: flex; gap: 20rpx; align-items: baseline; min-width: 0; }
.fn-exercise-copy .fn-numbers, .fn-exercise-name { font-size: 28rpx; font-weight: 700; overflow-wrap: anywhere; }
.field-notes .fn-expanded { text-align: left; }
.fn-expanded .fn-title { font-size: 49rpx; margin: 0 0 10rpx; }
.fn-exercise-top .fn-meta { color: var(--fn-muted); font-weight: 400; letter-spacing: 2rpx; }
.field-notes .compact-heading, .field-notes .compact-set-row {
  grid-template-columns: minmax(0, .9fr) minmax(0, 1.15fr) minmax(0, .95fr) minmax(44px, .8fr);
  gap: 2rpx;
  border: 0;
  border-bottom: 1rpx solid var(--fn-line);
  padding: 0 4rpx;
  border-radius: 0;
  min-height: 94rpx;
}
.field-notes .compact-heading { min-height: 58rpx; }
.field-notes .compact-set-row.set-is-done { background: var(--fn-done-paper); }
.field-notes .compact-set-row .set-type { color: var(--fn-muted); background: transparent; font-size: 22rpx; }
.field-notes .compact-set-row .is-warmup { color: var(--fn-clay); font-weight: 700; }
.field-notes .compact-set-row .set-value { background: transparent; border: 1rpx solid transparent; color: var(--fn-ink); font-family: var(--fn-number); }
.field-notes .compact-set-row .set-value:focus { border-color: var(--fn-clay); }
.field-notes .compact-set-row .set-check { position: relative; border: 0; background: transparent; color: var(--fn-muted); z-index: 0; }
.field-notes .compact-set-row .set-check::before { content: ""; position: absolute; z-index: -1; top: 50%; left: 50%; width: 25px; height: 25px; transform: translate(-50%, -50%); border: 1px solid #AFA397; border-radius: 50%; }
.field-notes .compact-set-row .is-checked { color: #fff; }
.field-notes .compact-set-row .is-checked::before { background: var(--fn-done); border-color: var(--fn-done); }
.field-notes .compact-set-row .is-skipped::before { display: none; }
.field-notes .group-tools .action-tool-main, .field-notes .wheel-footer .link, .field-notes .inline-training-status .link { color: var(--fn-clay); }
.field-notes .group-tools { margin: 0; }
.field-notes .wheel-footer { flex-direction: row; flex-wrap: wrap; justify-content: center; margin: 0; }
.field-notes .wheel-footer .link { width: auto !important; }
.field-notes .new-training { margin: 8rpx 0; color: var(--fn-clay); border-color: var(--fn-line); background: transparent; }
.field-notes .inline-training-status { bottom: env(safe-area-inset-bottom); left: 24rpx; right: 24rpx; color: var(--fn-ink); background: var(--fn-inset); border-color: var(--fn-line); border-radius: 0; }
.field-notes .inline-training-status .fn-numbers { font-size: 38rpx; font-weight: 700; }
.fn-rest-space { height: 160rpx; }
