@import "../../styles/interaction.wxss";
.aset {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #f1f4ee;
  border-radius: 24rpx;
}

.aset-main {
  margin-bottom: 12rpx;
}

.aset-no {
  font-weight: 600;
  font-size: 26rpx;
  margin-right: 12rpx;
}

.aset-inputs {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
  flex-wrap: wrap;
}

.mini-field {
  width: 120rpx;
  padding: 10rpx 12rpx;
  background: var(--surface);
  border: 2rpx solid #e0e7dc;
  border-radius: 12rpx;
  font-size: 24rpx;
  text-align: center;
}

.aset-actions {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.aset-actions > button { flex: 1; }

.aset { display:block !important;border-radius:16rpx !important; }
.aset-inputs { display:block !important; }
.aset-inputs training-number-control { margin:16rpx 0; }
.aset-actions { display:flex !important;gap:16rpx;margin-top:20rpx; }
.aset-actions button { flex:1;min-height:96rpx; }
.page { padding-bottom:calc(300rpx + env(safe-area-inset-bottom)); }
.ix-workout-dock { position:fixed;left:24rpx;right:24rpx;bottom:calc(124rpx + env(safe-area-inset-bottom));display:flex;align-items:center;gap:20rpx;padding:20rpx;background:#17202b;color:#fff;border-radius:16rpx;z-index:30;box-shadow:0 8rpx 24rpx rgba(17,19,24,.15); }
.dock-summary { flex:1;min-width:0;display:flex;flex-direction:column;font-size:22rpx; }
.dock-number { font-size:28rpx;font-weight:700;font-variant-numeric:tabular-nums; }
.dock-complete { background:#c7f36b;color:#17202b;min-height:48px;padding:0 20rpx;border-radius:12rpx;font-size:26rpx;font-weight:700; }
