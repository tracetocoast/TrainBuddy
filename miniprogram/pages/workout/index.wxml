<page-meta background-color="{{pageBg}}" />
<view class="page interaction-scope workout-exec {{session ? 'is-session' : ''}} {{reduced ? 'ix-reduced' : ''}} {{skinClass}}">
  <view class="card sub" wx:if="{{loading}}">正在读取训练…</view>
  <view class="ix-error" wx:if="{{loadError}}">{{loadError}}<button class="secondary" bindtap="onRetryLoad">重试</button></view>
  <view class="ix-error" wx:if="{{saveError}}">{{saveError}}</view>

  <view class="top" wx:if="{{!session}}">
    <view class="brand">
      <brand-logo class="brand-emblem-slot" />练搭子
      <text class="brand-sub">TRAIN BUDDY</text>
    </view>
  </view>

  <block wx:if="{{!session}}">
    <view class="eyebrow">TRAINING LOG</view>
    <view class="title">训练</view>
    <view class="workout-entry-btns">
      <button wx:if="{{resumableSession}}" class="primary" bindtap="onResumeTraining" disabled="{{loading || loadError}}">继续上次训练</button>
      <button class="{{resumableSession ? 'secondary' : 'primary'}}" bindtap="onNewTraining" disabled="{{loading || loadError}}">新建训练</button>
    </view>
    <button class="link draft-toggle" wx:if="{{resumableSessions.length > 1}}" bindtap="onToggleDrafts" aria-expanded="{{showDrafts}}">{{showDrafts ? '收起未完成训练' : '查看未完成训练（' + resumableSessions.length + '）'}}</button>
    <view wx:if="{{showDrafts && resumableSessions.length > 1}}" class="draft-list">
      <button class="draft-row" wx:for="{{resumableSessions}}" wx:key="session_id" data-id="{{item.session_id}}" bindtap="onResumeTraining">
        <text>{{item.title}}</text>
        <text class="sub">{{item.business_date}} · {{item.exercises.length}} 个动作<text wx:if="{{item.exercises.length}}"> · {{item.exercises[0].name}}</text></text>
      </button>
    </view>
    <button class="link" wx:if="{{!resumableSession}}" bindtap="goPlans">从模板开始</button>
    <report-history section="latest"/>
    <view class="head">
      <view class="head-title">我的待练计划</view>
      <button class="link" bindtap="goExercises">动作库 ↗</button>
    </view>
    <view class="card" wx:for="{{plans}}" wx:key="plan_id">
      <view class="card-title">{{item.published.title}}</view>
      <view class="sub">{{item.scheduleText || '今日待练'}} · v{{item.published.version}}</view>
      <button class="primary" style="width:100%;margin-top:16rpx" data-id="{{item.plan_id}}" bindtap="onStart">开始训练</button>
    </view>
    <view class="card sub" wx:if="{{!plans.length && !hasPublishedPlans}}">还没有训练计划。去动作库挑选动作，或先体验入门模板。</view>
    <view class="card sub" wx:if="{{!plans.length && hasPublishedPlans}}">今日没有待练计划。非今日安排或已完成的可到「全部计划」查看与调整日期。</view>
    <button class="secondary" style="width:100%;margin-top:16rpx" bindtap="onEnsureDefault" wx:if="{{!plans.length && !hasPublishedPlans}}">体验下肢训练模板</button>
    <button class="secondary" style="width:100%;margin-top:16rpx" bindtap="goPlans" wx:if="{{!plans.length && hasPublishedPlans}}">查看全部计划</button>
    <report-history section="history"/>
  </block>

  <block wx:else>
    <view class="wheel-top">
      <button class="wheel-back" bindtap="onSessionBack" aria-label="返回训练首页">‹</button>
      <view class="wheel-top-title">
        <text class="wheel-top-name">{{session.title}}</text>
        <text class="wheel-top-mode">{{session.exercises.length}} 个动作</text>
      </view>
      <button class="wheel-more" bindtap="goEditPlan" wx:if="{{session.plan_id}}" aria-label="编辑计划">···</button>
      <view class="wheel-back-space" wx:else></view>
    </view>

    <view class="free-empty" wx:if="{{!session.exercises.length}}"><view class="title">从第一个动作开始</view><view class="sub">选择本次要练的动作。</view></view>
    <button class="primary new-training" bindtap="onAddActions" disabled="{{savingSet || finishing}}">＋ 添加动作</button>
    <view class="workout-action" wx:for="{{session.exercises}}" wx:for-item="ex" wx:key="id">
      <button class="workout-action-head" data-id="{{ex.id}}" bindtap="onToggleExercise" aria-expanded="{{ex.id === lockedExerciseId}}">
        <view class="workout-action-header-grid">
          <view class="workout-action-thumb-slot">
            <image wx:if="{{ex.imageUrl && !imageFailed[ex.id]}}" class="workout-action-thumb" src="{{ex.imageUrl}}" mode="aspectFit" data-id="{{ex.id}}" binderror="onExerciseImageError" />
          </view>
          <view class="workout-action-copy"><text class="workout-action-name">{{ex.name}}</text><text class="sub">{{ex.sets.length}} 组</text></view>
          <text class="action-chevron">{{ex.id === lockedExerciseId ? '⌃' : '⌄'}}</text>
        </view>
      </button>
      <view class="workout-action-detail" wx:if="{{ex.id === lockedExerciseId && focusView}}">
          <view class="info-meta">{{focusView.doneInExercise}} / {{focusView.setTotal}} 组已完成 · {{focusView.muscle}}</view>
          <view class="sub" wx:if="{{ex.referenceDate}}">参考上次 · {{ex.referenceDate}}</view>
          <view class="compact-heading"><text>组</text><text>重量 <text class="column-unit">kg</text></text><text>次数</text><text>完成</text></view>
          <view class="compact-set">
            <view class="compact-set-row {{set.state === 'done' ? 'set-is-done' : ''}}" wx:for="{{ex.sets}}" wx:for-item="set" wx:key="id">
              <button class="set-type {{set.setType === 'warmup' ? 'is-warmup' : ''}}" data-sid="{{set.id}}" data-kind="{{set.setType}}" bindtap="onOpenSetEditor" disabled="{{savingSet || finishing}}" aria-label="调整本组类型">{{set.setType === 'warmup' ? '热' : set.setNo}}</button>
              <input class="set-value" type="digit" value="{{set.actualWeight == null ? '' : set.actualWeight}}" placeholder="—" placeholder-class="set-placeholder" data-sid="{{set.id}}" data-field="actualWeight" bindinput="onSetField" bindblur="onSetEditEnd" bindconfirm="onSetEditEnd" cursor-spacing="24" disabled="{{savingSet || finishing || set.state === 'done'}}" aria-label="第 {{set.setNo}} 组重量，公斤" />
              <input class="set-value" type="number" value="{{set.actualReps == null ? '' : set.actualReps}}" placeholder="—" placeholder-class="set-placeholder" data-sid="{{set.id}}" data-field="actualReps" bindinput="onSetField" bindblur="onSetEditEnd" bindconfirm="onSetEditEnd" cursor-spacing="24" disabled="{{savingSet || finishing || set.state === 'done'}}" aria-label="第 {{set.setNo}} 组次数" />
              <button class="set-check {{set.state === 'done' ? 'is-checked' : ''}}" data-sid="{{set.id}}" data-state="{{set.state === 'done' ? 'pending' : 'done'}}" bindtap="onSetState" disabled="{{savingSet || finishing}}" aria-label="{{set.state === 'done' ? '本组已完成，点击撤销' : '完成本组'}}">{{set.state === 'done' ? '✓' : '完成'}}</button>
              <view class="set-row-feedback" wx:if="{{setSaveErrors[set.id] || pending[set.id]}}">
                <text>{{setSaveErrors[set.id] || '待同步'}}</text><button class="link" wx:if="{{setSaveErrors[set.id]}}" data-sid="{{set.id}}" bindtap="onSetEditEnd">重试</button>
              </view>
              <view class="set-row-menu" wx:if="{{setEditor.sid === set.id}}">
                <button class="link" data-kind="warmup" data-sid="{{set.id}}" bindtap="onSetType" disabled="{{savingSet || finishing}}">热身组</button>
                <button class="link" data-kind="working" data-sid="{{set.id}}" bindtap="onSetType" disabled="{{savingSet || finishing}}">正式组</button>
                <button class="link" wx:if="{{set.setNo > 1 && set.state !== 'done'}}" data-sid="{{set.id}}" bindtap="onCopyPrevious" disabled="{{savingSet || finishing}}">沿用上组</button>
                <button class="link" data-sid="{{set.id}}" bindtap="onChangeGroup" disabled="{{savingSet || finishing}}">删除</button>
              </view>
            </view>
          </view>

          <view class="sub workout-weight-hint">重量按当前动作计重方式填写</view>
          <view class="group-tools">
            <button class="action-tool action-tool-main" bindtap="onChangeGroup" disabled="{{savingSet || finishing}}">＋ 新增一组</button>
            <button class="action-tool" bindtap="onExerciseHistory" aria-expanded="{{showHistory}}">{{showHistory ? '收起动作历史' : '动作历史'}}</button>
          </view>
          <view class="workout-exercise-history" wx:if="{{showHistory}}">
            <view class="compact-history" wx:for="{{exerciseHistory}}" wx:key="sessionId"><text class="sub">{{item.date}}</text><text>{{item.summary}}</text></view>
            <view class="sub" wx:if="{{!exerciseHistory.length}}">暂无已完成训练记录</view>
          </view>
          <view class="group-tools group-tools-secondary">
            <button class="action-tool" wx:if="{{focusView.exerciseId}}" data-id="{{focusView.exerciseId}}" bindtap="goExerciseDetail">动作详情</button>
            <button class="action-tool" wx:if="{{focusView.state === 'pending'}}" data-sid="{{focusView.setId}}" data-state="skipped" bindtap="onSetState" disabled="{{savingSet || finishing}}">跳过第 {{focusView.setNo}} 组</button>
            <button class="action-tool action-tool-remove" bindtap="onRemoveAction" disabled="{{savingSet || finishing}}">移除动作</button>
          </view>
          <view class="pending-hint" wx:if="{{focusView.pendingLocal}}">本机待同步</view>
      </view>
    </view>
    <view class="inline-training-status" wx:if="{{restVisible}}"><text>{{restSeconds ? '组间休息 ' + restText : '休息结束'}}</text><button class="link" bindtap="closeRest">{{restSeconds ? '结束休息' : '关闭'}}</button></view>
    <view class="wheel-footer">
      <button class="secondary" bindtap="onFinish" disabled="{{finishing || savingSet}}" loading="{{finishing}}">结束训练</button>
      <button class="link" bindtap="onRestPreference">休息设置</button>
      <button class="link" bindtap="onAbandon" disabled="{{finishing || savingSet}}">放弃本次</button>
    </view>
  </block>
  <bottom-nav active="workout" />
</view>
