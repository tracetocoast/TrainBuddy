<page-meta background-color="{{pageBg}}" />
<view class="page interaction-scope workout-exec {{session ? 'is-session' : ''}} {{reduced ? 'ix-reduced' : ''}} {{skinClass}}">
  <view class="ix-preference" wx:if="{{!session}}"><text>减少动态效果与触觉</text><switch checked="{{reduced}}" bindchange="onMotion" color="#28744e"/></view>
  <view class="card sub" wx:if="{{loading}}">正在读取训练…</view>
  <view class="ix-error" wx:if="{{loadError}}">{{loadError}}<button class="secondary" bindtap="reload">重新加载</button></view>
  <view class="ix-error" wx:if="{{saveError}}">{{saveError}}</view>

  <view class="top" wx:if="{{!session}}">
    <view class="brand">
      <brand-logo class="brand-emblem-slot" />练搭子
      <text class="brand-sub">TRAIN BUDDY</text>
    </view>
  </view>

  <block wx:if="{{!session}}">
    <view class="eyebrow">TRAINING LOG</view>
    <view class="title">训练</view>
    <button class="primary new-training" bindtap="onNewTraining">＋ 新建训练</button>
    <report-history/>
    <view class="head">
      <view class="head-title">我的待练计划</view>
      <button class="link" bindtap="goExercises">动作库 ↗</button>
    </view>
    <view class="card" wx:for="{{plans}}" wx:key="plan_id">
      <view class="card-title">{{item.published.title}}</view>
      <view class="sub">{{item.scheduleText || '今日待练'}} · v{{item.published.version}}</view>
      <button class="primary" style="width:100%;margin-top:16rpx" data-id="{{item.plan_id}}" bindtap="onStart">开始训练</button>
    </view>
    <view class="card sub" wx:if="{{!plans.length && !hasPublishedPlans}}">还没有训练计划。去动作库挑选动作，或先体验入门模板。</view>
    <view class="card sub" wx:if="{{!plans.length && hasPublishedPlans}}">今日没有待练计划。非今日安排或已完成的可到「全部计划」查看与调整日期。</view>
    <button class="secondary" style="width:100%;margin-top:16rpx" bindtap="onEnsureDefault" wx:if="{{!plans.length && !hasPublishedPlans}}">体验下肢训练模板</button>
    <button class="secondary" style="width:100%;margin-top:16rpx" bindtap="goPlans" wx:if="{{!plans.length && hasPublishedPlans}}">查看全部计划</button>
  </block>

  <block wx:else>
    <view class="wheel-top">
      <button class="wheel-back" bindtap="onSessionBack" aria-label="{{phase === 'locked' ? '返回选择动作' : '返回计划列表'}}">‹</button>
      <view class="wheel-top-title">
        <text class="wheel-top-name">{{session.title}}</text>
        <text class="wheel-top-mode">{{phase === 'locked' ? '当前动作 · 已锁定' : (phase === 'exerciseDone' ? '动作完成' : '选择训练动作')}}</text>
      </view>
      <button class="wheel-more" bindtap="goEditPlan" wx:if="{{session.plan_id}}" aria-label="编辑计划">···</button>
      <view class="wheel-back-space" wx:else></view>
    </view>

    <!-- 摩天轮选择 -->
    <block wx:if="{{phase === 'picker'}}">
      <view class="free-empty" wx:if="{{!wheelItems.length}}"><view class="title">从第一个动作开始</view><view class="sub">选择今天想练的动作，随时添加和调整。</view></view>
      <button class="primary new-training" bindtap="onAddActions">＋ 添加动作</button>
      <view class="wheel-section" wx:if="{{wheelItems.length}}">
        <view class="wheel-eyebrow">TODAY'S WORKOUT</view>
        <view class="wheel-h1">先选一个动作开始</view>
        <view class="wheel-sub">左右滑动，像摩天轮一样选择今天想先练的动作。</view>
        <view class="plan-dots">
          <view class="plan-dot {{item.active ? 'active' : ''}}" wx:for="{{planDots}}" wx:for-index="dotIdx" wx:key="dotIdx"></view>
        </view>
        <view class="wheel-mode">
          <text class="wheel-mode-on">自由选择</text>
          <text>共 {{wheelItems.length}} 个动作</text>
        </view>
      </view>

      <view wx:if="{{wheelItems.length}}"
        class="carousel-wrap"
        bindtouchstart="onWheelTouchStart"
        bindtouchend="onWheelTouchEnd"
      >
        <view class="carousel-glow"></view>
        <view class="wheel">
          <view
            class="wheel-card {{item.selected ? 'selected' : ''}} {{item.complete ? 'is-done' : ''}}"
            wx:for="{{wheelItems}}"
            wx:key="id"
            style="{{item.style}}"
            data-index="{{index}}"
            bindtap="onPickWheelCard"
          >
            <view class="wheel-pic">
              <image
                wx:if="{{item.imageUrl && !item.imageFailed}}"
                class="wheel-pic-img"
                src="{{item.imageUrl}}"
                mode="aspectFit"
                data-id="{{item.id}}"
                binderror="onWheelImageError"
              />
              <text wx:else class="wheel-pic-icon">{{item.icon}}</text>
            </view>
            <text class="wheel-card-name">{{item.name}}</text>
            <text class="wheel-card-meta">{{item.complete ? '已完成' : item.meta}}</text>
          </view>
        </view>
      </view>

      <view class="selection-hint">← 左右滑动选择 · 点击卡片也可以选择 →</view>
      <view class="selected-name" wx:if="{{selectedCard}}">
        <text class="selected-name-b">{{selectedCard.name}}</text>
        <text class="selected-name-s">{{selectedCard.meta}} · 计划 {{selectedCard.baselineLabel}}</text>
      </view>
      <button class="wheel-start" bindtap="onStartSelectedExercise" disabled="{{!selectedCard || selectedCard.complete}}">
        {{selectedCard.complete ? '该动作已完成' : '开始此动作'}}
      </button>
      <view class="wheel-footer">
        <button class="secondary" bindtap="onFinish" disabled="{{finishing || savingSet}}" loading="{{finishing}}">结束训练</button>
        <button class="link" bindtap="onAbandon" disabled="{{finishing || savingSet}}">放弃本次</button>
      </view>
    </block>

    <!-- 锁定执行：放大进入 -->
    <block wx:if="{{phase === 'locked' && focusView}}">
      <view id="focus-card" class="current-card {{reduced ? '' : 'current-card-pop'}}">
        <view class="info">
          <view class="info-name">{{focusView.exerciseName}}</view>
          <view class="info-meta">{{focusView.muscle}} · 第 {{focusView.exerciseOrder}} / {{focusView.exerciseTotal}} 个动作</view>

          <view class="sub">点击组号切换热身 / 正式，右侧勾选完成本组。</view>
          <view class="compact-heading"><text>组</text><text>重量 kg</text><text>次数</text><text></text><text>完成</text></view>
          <view class="compact-set" wx:for="{{session.exercises}}" wx:for-item="ex" wx:key="id" wx:if="{{ex.id === lockedExerciseId}}">
            <view class="compact-set-row {{set.state === 'done' ? 'set-is-done' : ''}}" wx:for="{{ex.sets}}" wx:for-item="set" wx:key="id">
              <button class="set-type {{set.setType === 'warmup' ? 'is-warmup' : ''}}" data-sid="{{set.id}}" data-kind="{{set.setType}}" bindtap="onOpenSetEditor" disabled="{{savingSet || finishing}}" aria-label="调整本组类型">{{set.setType === 'warmup' ? '热' : set.setNo}}</button>
              <button class="set-value" data-sid="{{set.id}}" data-field="actualWeight" bindtap="onOpenSetEditor" disabled="{{savingSet || finishing}}"><text class="set-unit">kg</text><text>{{set.actualWeight == null ? '—' : set.actualWeight}}</text></button>
              <button class="set-value" data-sid="{{set.id}}" data-field="actualReps" bindtap="onOpenSetEditor" disabled="{{savingSet || finishing}}"><text class="set-unit">次</text><text>{{set.actualReps == null ? '—' : set.actualReps}}</text></button>
              <button class="group-delete" data-sid="{{set.id}}" bindtap="onChangeGroup" disabled="{{savingSet || finishing}}" aria-label="删除本组">−</button>
              <button class="set-check {{set.state === 'done' ? 'is-checked' : ''}}" data-sid="{{set.id}}" data-state="{{set.state === 'done' ? 'pending' : 'done'}}" bindtap="onSetState" disabled="{{savingSet || finishing || restVisible}}" aria-label="{{set.state === 'done' ? '重新编辑本组' : '完成本组'}}">✓</button>
            </view>
          </view>
          <view class="sub">{{focusView.muscle}} · 重量按当前动作计重方式填写</view>
          <view class="group-tools"><button class="secondary" bindtap="onChangeGroup" disabled="{{savingSet || finishing}}">＋ 新增一组</button><button class="link" bindtap="onRemoveAction" disabled="{{savingSet || finishing}}">移除动作</button></view>
          <button class="link" bindtap="onExerciseHistory">动作历史 ›</button>
          <view wx:if="{{showHistory}}">
            <view class="compact-history" wx:for="{{exerciseHistory}}" wx:key="sessionId"><text>{{item.date}}</text><text>{{item.summary}}</text></view>
            <view class="sub" wx:if="{{!exerciseHistory.length}}">暂无已完成训练记录</view>
          </view>
          <view class="locked-tools" wx:if="{{focusView.exerciseId}}">
            <button class="tool" data-id="{{focusView.exerciseId}}" bindtap="goExerciseDetail">动作详情</button>
          </view>
          <view class="pending-hint" wx:if="{{focusView.pendingLocal}}">本机待同步</view>
        </view>
      </view>

      <view class="next" wx:if="{{nextHint}}">
        <view class="next-ico">→</view>
        <view class="grow">
          <text class="next-b">{{nextHint.title}}</text>
          <text class="next-s">{{nextHint.line}}</text>
        </view>
      </view>
    </block>
  </block>
  <bottom-nav active="workout" />
</view>

<view class="proto-dock" wx:if="{{session && phase === 'locked' && focusView && !restVisible}}">
  <text class="dock-big">{{focusView.weightText}}kg × {{focusView.repsText}}次 · 第 {{focusView.setNo}} 组</text>
  <view class="dock-actions">
    <button
      class="dock-skip"
      data-sid="{{focusView.setId}}"
      data-state="skipped"
      bindtap="onSetState"
      wx:if="{{focusView.state !== 'skipped'}}"
      disabled="{{savingSet || finishing}}"
    >跳过</button>
    <button
      class="dock-btn"
      data-sid="{{focusView.setId}}"
      data-state="done"
      bindtap="onSetState"
      disabled="{{savingSet || finishing}}"
      loading="{{savingSet}}"
    >{{savingSet ? '保存中' : '完成本组'}}</button>
  </view>
</view>

<view class="rest {{restVisible ? 'show' : ''}}" wx:if="{{session}}" catchtouchmove="noop">
  <view class="rest-sheet">
    <view class="rest-eyebrow">REST BETWEEN SETS</view>
    <view class="rest-timer">{{restText}}</view>
    <view class="rest-p">休息一下，准备下一组。</view>
    <view class="rest-actions">
      <button class="rest-go" bindtap="closeRest">直接进入下一组</button>
    </view>
  </view>
</view>

<view class="exercise-done {{phase === 'exerciseDone' ? 'show' : ''}}" wx:if="{{session && exerciseDone}}">
  <view class="done-badge">✓</view>
  <view class="done-h2">动作完成</view>
  <view class="done-p">{{exerciseDone.name}}已经完成。临时调整不会改变你的训练计划。</view>
  <view class="done-summary">
    <view class="done-cell"><text class="done-b">{{exerciseDone.doneSets}}</text><text class="done-s">完成组数</text></view>
    <view class="done-cell"><text class="done-b">{{exerciseDone.weight}}</text><text class="done-s">默认重量 kg</text></view>
    <view class="done-cell"><text class="done-b">{{exerciseDone.reps}}</text><text class="done-s">默认次数</text></view>
  </view>
  <button class="wheel-start" bindtap="onChooseNextExercise">选择下一个动作</button>
  <button class="link done-finish" bindtap="onFinish">结束整次训练</button>
</view>

<view class="set-editor-mask" wx:if="{{setEditor}}" bindtap="onCloseSetEditor"></view>
<view class="set-editor {{skinClass}}" wx:if="{{setEditor}}" style="bottom:{{editorKeyboardHeight}}px" catchtouchmove="noop">
  <view class="set-editor-head"><view><text class="card-title">第 {{setEditor.no}} 组</text><view class="sub">{{setEditor.field === 'type' ? '调整训练组' : (setEditor.field === 'actualWeight' ? '实际重量 · kg' : '实际次数')}}</view></view><button class="link" bindtap="onCloseSetEditor">收起</button></view>
  <input wx:if="{{setEditor.field !== 'type'}}" class="set-editor-input" type="{{setEditor.field === 'actualWeight' ? 'digit' : 'number'}}" value="{{setEditor.value}}" focus="{{true}}" adjust-position="{{false}}" bindinput="onEditorInput" bindkeyboardheightchange="onEditorKeyboard" placeholder="输入数值"/>
  <view class="set-editor-options">
    <button class="secondary {{setEditor.kind === 'warmup' ? 'type-selected' : ''}}" data-kind="warmup" bindtap="onSetType" disabled="{{savingSet}}">热身组</button>
    <button class="secondary {{setEditor.kind === 'working' ? 'type-selected' : ''}}" data-kind="working" bindtap="onSetType" disabled="{{savingSet}}">正式组</button>
  </view>
  <view class="set-editor-foot"><text>输入会暂存，勾选后同步</text><button class="primary" bindtap="onCloseSetEditor">完成输入</button></view>
</view>
