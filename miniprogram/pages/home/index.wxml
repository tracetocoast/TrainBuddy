<view class="page home-page">
  <view class="top">
    <view class="brand">
      <brand-logo class="brand-emblem-slot" />练搭子</view>
    <button class="msg-btn" bindtap="goProfile" aria-label="打开个人中心">{{avatarChar}}</button>
  </view>
  <role-switcher />
  <block wx:if="{{role === 'student'}}">
    <view class="welcome">
      <view class="title">今天，也进步一点</view>
      <view class="sub">跟着自己的节奏，练出好状态。</view>
    </view>
    <view class="daily-card">
      <view class="daily-intro">
        <view class="grow">
          <text class="daily-label">今日训练</text>
          <view class="daily-title">准备好动起来了吗？</view>
          <view class="sub">选择你的计划，逐组记录进步。</view>
        </view>
        <view class="training-emblem" aria-hidden="true"><brand-logo size="126" /></view>
      </view>
      <button class="primary" bindtap="goWorkout">开始训练</button>
    </view>
    <view class="head">
      <view class="head-title">接下来的课程</view>
      <button class="link" bindtap="goBooking">去约课 ›</button>
    </view>
    <view class="card flex" wx:if="{{nextBooking}}" bindtap="goNextBooking">
      <view class="ico blue">▦</view>
      <view class="grow">
        <view class="card-title">{{nextBooking.course_name}}</view>
        <view class="sub">{{nextBooking.dateKey}} {{nextBooking.startLabel}}–{{nextBooking.endLabel}}</view>
        <view class="sub">{{coachName}} · {{nextBooking.statusLabel}}</view>
      </view>
      <text class="chevron">›</text>
    </view>
    <view class="card flex" wx:elif="{{!hasBinding}}">
      <view class="ico blue">＋</view>
      <view class="grow">
        <view class="card-title">找到你的训练搭档</view>
        <view class="sub">绑定教练后，即可查看时间并约课。</view>
      </view>
      <button class="link" bindtap="goBind">绑定 ›</button>
    </view>
    <view class="card flex" wx:else bindtap="goBooking">
      <view class="ico blue">▦</view>
      <view class="grow">
        <view class="card-title">还没有预约课程</view>
        <view class="sub">看看 {{coachName}} 的可约时间。</view>
      </view>
      <text class="chevron">›</text>
    </view>
    <view class="head">
      <view class="head-title">一点点，积累成改变</view>
      <button class="link" bindtap="goGrowth">查看成长 ›</button>
    </view>
    <view class="stats">
      <view class="stat">
        <text class="stat-value">{{hasStats ? weekCount : '—'}}</text>
        <text class="stat-label">本周训练</text>
      </view>
      <view class="stat">
        <text class="stat-value">{{planRateText}}</text>
        <text class="stat-label">计划完成率</text>
      </view>
      <view class="stat">
        <text class="stat-value">{{streak || '—'}}</text>
        <text class="stat-label">连续记录天数</text>
      </view>
    </view>
    <view class="head">
      <view class="head-title">训练之外，也照顾好自己</view>
    </view>
    <view class="quick-grid">
      <button class="quick-card" bindtap="goDiary">
        <text class="quick-icon orange">✎</text>
        <view class="grow">
          <view class="card-title">每日日记</view>
          <view class="sub">饮食、饮水与状态</view>
        </view>
        <text class="chevron">›</text>
      </button>
      <button class="quick-card" bindtap="goExercises">
        <text class="quick-icon violet">↗</text>
        <view class="grow">
          <view class="card-title">学习动作</view>
          <view class="sub">看要点，练得更稳</view>
        </view>
        <text class="chevron">›</text>
      </button>
    </view>
  </block>
  <block wx:elif="{{role === 'coach' && canSwitchCoach}}">
    <view class="welcome">
      <view class="title">今天，陪他们进步</view>
      <view class="sub">安排课程，留下每一次训练的记录。</view>
    </view>
    <view class="daily-card">
      <view class="daily-label">教练工作台</view>
      <view class="daily-title">{{pendingCoachCount ? '有预约等你确认' : '把指导安排得更从容'}}</view>
      <view class="coach-counts">
        <view>
          <text class="stat-value">{{pendingCoachCount}}</text>
          <text class="sub">待确认预约</text>
        </view>
        <view>
          <text class="stat-value">{{boundCount}}</text>
          <text class="sub">绑定学员</text>
        </view>
      </view>
      <button class="primary" bindtap="goBooking">查看排课</button>
    </view>
    <view class="head">
      <view class="head-title">我的学员</view>
    </view>
    <view class="card" wx:for="{{sessions}}" wx:key="studentId">
      <view class="flex">
        <view class="ico blue">↗</view>
        <view class="grow">
          <view class="card-title">{{item.name}}</view>
          <view class="sub">训练计划与课后记录</view>
        </view>
      </view>
      <view class="twobtn">
        <button class="secondary" data-student="{{item.name}}" data-id="{{item.studentId}}" bindtap="goStudentProfile">学员档案</button>
        <button class="primary" data-student="{{item.name}}" data-id="{{item.studentId}}" bindtap="goRecordFor">记录训练</button>
      </view>
    </view>
    <view class="card" wx:if="{{!sessions.length}}">
      <view class="card-title">一起开始第一节课</view>
      <view class="sub">在个人中心生成邀请码，邀请学员加入。</view>
      <button class="secondary" style="margin-top:20rpx" bindtap="goProfile">邀请学员</button>
    </view>
  </block>
</view>
<bottom-nav active="home" />
