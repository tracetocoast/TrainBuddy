<page-meta background-color="{{pageBg}}" />
<view class="page home-page {{role === 'coach' ? 'coach-scope workbench' : ''}} field-notes">
  <view class="top">
    <view class="home-greet">
      <view class="fn-kicker">{{role === 'coach' ? 'COACH DESK' : 'TRAINBUDDY / FIELD NOTES'}}</view>
      <view class="title">{{role === 'coach' ? '今天的课，按计划进行。' : '今天，好好练。'}}</view>
      <view class="sub home-date">{{greetName}} · {{todayLabel}}</view>
    </view>
    <button class="msg-btn" bindtap="goProfile" aria-label="账户与身份设置">{{avatarChar}}</button>
  </view>

  <view class="ui-state" wx:if="{{loading}}">正在同步课程…</view>
  <view class="ui-state ui-state-error" wx:if="{{syncError || bookingError}}">{{syncError || bookingError}}<button class="link" bindtap="refreshPage">重新加载</button></view>

  <block wx:if="{{role === 'coach' && canSwitchCoach}}">
    <view class="workbench-entry">
      <button class="record-launch" bindtap="goRecord" aria-label="记录训练，先选择学员，再开始语音或文字录入">
        <view class="record-launch-icon"><ui-icon name="mic" tone="white" size="52"/></view>
        <view class="record-launch-copy">
          <text class="record-launch-title">记录训练</text>
          <text class="record-launch-hint">选定学员 · 语音或文字录入</text>
        </view>
        <ui-icon name="chevron" tone="white" size="32"/>
      </button>
    </view>

    <view class="task-overview">
      <button class="task-chip" bindtap="goBooking">
        <text class="task-chip-value">{{todayCourseCount}}</text>
        <text class="task-chip-label">今日课程</text>
      </button>
      <button class="task-chip {{pendingCoachCount ? 'task-chip-warn' : ''}}" bindtap="goPendingBooking">
        <text class="task-chip-value">{{pendingCoachCount}}</text>
        <text class="task-chip-label">待确认预约</text>
      </button>
      <button class="task-chip" bindtap="goBooking">
        <text class="task-chip-value">{{todayDoneCourseCount}}</text>
        <text class="task-chip-label">今日已完成</text>
      </button>
    </view>

    <view class="head"><view class="head-title">今日课程</view><button class="link" bindtap="goBooking">完整日程 ›</button></view>
    <view class="course-row" wx:for="{{todayCourses}}" wx:key="booking_id">
      <button class="course-summary" data-id="{{item.booking_id}}" bindtap="goCourse">
        <view class="course-time">{{item.startLabel}}</view>
        <view class="course-person">
          <view class="card-title">{{item.student_name}}</view>
          <view class="sub">{{item.course_name}}</view>
          <view class="course-status-row">
            <ui-icon name="{{item.statusIcon}}" tone="{{item.statusTone === 'ok' ? 'green' : 'muted'}}" size="24"/>
            <text class="statuspill {{item.statusTagClass}}">{{item.statusLabel}}</text>
          </view>
        </view>
      </button>
      <button class="secondary course-record" data-id="{{item.booking_id}}" bindtap="goCourseRecord">记录</button>
    </view>
    <view class="quiet-empty" wx:if="{{!todayCourses.length && !loading && !bookingError && !syncError}}">今天暂无课程，仍可为已绑定学员记录训练。</view>

    <view class="head"><view class="head-title">辅助工具</view></view>
    <view class="aux-tools">
      <button bindtap="goPosture"><ui-icon name="body" size="36"/><text>体态评估</text><ui-icon name="chevron" size="26"/></button>
      <button bindtap="goInvite"><ui-icon name="invite" size="36"/><text>邀请学员</text><ui-icon name="chevron" size="26"/></button>
    </view>
  </block>

  <block wx:elif="{{role === 'student'}}">

    <view class="editorial-photo"><image src="/assets/field-notes/editorial-barbell.jpg" mode="aspectFill"/><view class="editorial-caption"><text>下一次私教课</text><text class="editorial-date">{{nextBooking ? nextBooking.dateDisplay + ' ' + nextBooking.startLabel : '为下一次进步留好时间'}}</text></view></view>
    <view class="head"><view class="head-title">下一次课程</view></view>
    <button class="booking-card card-press" wx:if="{{nextBooking}}" bindtap="goNextBooking">
      <view class="booking-time-block">
        <text class="booking-weekday">{{nextBooking.weekdayDisplay}}</text>
        <text class="booking-date">{{nextBooking.dateDisplay}}</text>
        <text class="booking-hm">{{nextBooking.startLabel}}</text>
      </view>
      <view class="booking-body">
        <view class="card-title">{{nextBooking.course_name || '私教课'}}</view>
        <view class="sub">{{coachName}}</view>
        <view class="course-status-row">
          <ui-icon name="{{nextBooking.statusIcon}}" tone="{{nextBooking.statusTone === 'ok' ? 'green' : 'muted'}}" size="24"/>
          <text class="statuspill {{nextBooking.statusTagClass}}">{{nextBooking.statusLabel}}</text>
        </view>
      </view>
      <ui-icon name="chevron" size="28"/>
    </button>
    <view class="home-empty" wx:elif="{{!loading && !bookingError}}">
      <view class="card-title">{{hasBinding ? '还没有下一次课程' : '连接你的教练'}}</view>
      <view class="sub">{{hasBinding ? '查看可约时间，安排下一次训练。' : '绑定后接收课后训练表和教练反馈。'}}</view>
      <button class="primary home-empty-cta" wx:if="{{hasBinding}}" bindtap="goBooking">查看可约时间</button>
      <button class="primary home-empty-cta" wx:else bindtap="goBind">绑定教练</button>
    </view>

    <view class="head"><view class="head-title">今日训练</view></view>
    <button class="summary-card card-press" bindtap="onTrainingCta">
      <view class="grow">
        <view class="card-title">{{trainingTitle}}</view>
        <view class="sub" wx:if="{{trainingSubtitle}}">{{trainingSubtitle}}</view>
        <view class="progress summary-progress" wx:if="{{activeSession && totalSets}}">
          <view class="progress-bar" style="width: {{progressPercent}}%;"></view>
        </view>
        <view class="sub" wx:if="{{activeSession && totalSets}}">已完成 {{doneSets}}/{{totalSets}} 组 · {{progressPercent}}%</view>
        <view class="sub" wx:elif="{{todayPlanDone}}">今日计划已完成</view>
        <view class="sub" wx:elif="{{!todayPlan && !activeSession && !trainingError}}">自由练习，或从已有计划开始。</view>
        <view class="sub ui-state-inline-error" wx:if="{{trainingError}}">{{trainingError}}</view>
      </view>
      <text class="summary-cta">{{trainingAction}} ›</text>
    </button>

    <report-history compact/>
    <button class="week-note" bindtap="goGrowth"><view><text class="fn-kicker">THIS WEEK</text><view class="week-count">{{hasStats ? weekCount : '—'}}<text>本周完成训练</text></view></view><text class="summary-cta">训练进展 ↗</text></button>
    <button class="link" bindtap="onToggleHomeTools" aria-expanded="{{showHomeTools}}">更多训练工具 {{showHomeTools ? '收起' : '展开'}}</button>
    <view class="quick-grid" wx:if="{{showHomeTools}}">
      <button class="quick-card card-press" bindtap="goWorkout">
        <ui-icon name="play" tone="green" size="36"/>
        <view class="grow"><view class="card-title">开始训练</view><view class="sub">{{trainingAction}}</view></view>
      </button>
      <button class="quick-card card-press" bindtap="goPlans">
        <ui-icon name="home" tone="green" size="36"/>
        <view class="grow"><view class="card-title">训练计划</view><view class="sub">编排与发布</view></view>
      </button>
      <button class="quick-card card-press" bindtap="goBookingEntry">
        <ui-icon name="booking" tone="green" size="36"/>
        <view class="grow"><view class="card-title">约课</view><view class="sub">{{hasBinding ? '可约时间与预约' : '先绑定教练'}}</view></view>
      </button>
      <button class="quick-card card-press" bindtap="goDiary">
        <ui-icon name="check" tone="green" size="36"/>
        <view class="grow"><view class="card-title">日记</view><view class="sub">饮食与状态记录</view></view>
      </button>
      <button class="quick-card card-press" bindtap="goCoach">
        <ui-icon name="students" tone="green" size="36"/>
        <view class="grow"><view class="card-title">教练反馈</view><view class="sub">课后表与建议</view></view>
      </button>
      <button class="quick-card card-press" bindtap="goGrowth">
        <ui-icon name="body" tone="green" size="36"/>
        <view class="grow"><view class="card-title">查看进展</view><view class="sub">周数据与趋势</view></view>
      </button>
    </view>
  </block>
<bottom-nav active="home"/>
</view>
