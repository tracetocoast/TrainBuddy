.home-page { padding-top:4rpx; }
.home-brand-caption { display:block;color:var(--muted);font-size:18rpx;font-weight:400;letter-spacing:.5rpx;margin-top:6rpx; }
.home-date { display:flex;align-items:center;justify-content:space-between;color:var(--muted);font-size:24rpx;margin:12rpx 0 20rpx; }
.home-date text { font-size:16rpx;letter-spacing:2rpx; }
.daily-card { padding:32rpx;background:var(--graphite);color:#f3f5f7;border:0;border-radius:24rpx;overflow:hidden; }
.hero-caption { display:flex;justify-content:space-between;align-items:center;font-size:23rpx;letter-spacing:1rpx;color:#c0cbd7; }
.hero-live { padding:6rpx 12rpx;background:#2b3542;color:var(--signal);font-size:20rpx;letter-spacing:0;border-radius:6rpx; }
.daily-title { font-size:44rpx;line-height:1.3;font-weight:750;letter-spacing:-1rpx;margin:28rpx 0 14rpx; }
.home-training-sub { font-size:25rpx;color:#b9c4d1;line-height:1.7; }
.training-metrics { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16rpx;padding:28rpx 0;margin-top:8rpx; }
.training-metrics > view { color:#b9c4d1;font-size:21rpx;border-right:1rpx solid #3b4654; }
.training-metrics > view:last-child { border-right:0; }
.training-metrics text { display:block;color:#f3f5f7;font-size:38rpx;line-height:1.2;font-weight:700;font-variant-numeric:tabular-nums;margin-bottom:8rpx; }
.training-start { display:flex;justify-content:space-between;align-items:center;width:100% !important;min-height:52px;padding:20rpx 26rpx;background:var(--signal);color:var(--graphite);border-radius:14rpx;font-size:30rpx;font-weight:700;margin-top:24rpx; }
.training-start[disabled] { background:#3b4654;color:#b9c4d1; }
.training-start text { font-size:36rpx; }
.hero-plan-link { min-height:44px;width:100% !important;color:#c0cbd7;font-size:22rpx;display:flex;align-items:center;justify-content:center;margin-top:8rpx; }
.training-progress { height:8rpx;background:#394452;border-radius:4rpx;overflow:hidden;margin:4rpx 0 16rpx; }
.training-progress > view { height:100%;background:var(--signal);border-radius:4rpx; }
.home-quote { color:var(--muted);font-size:22rpx;text-align:center;margin:20rpx 0 4rpx;line-height:1.7; }
.home-stats { border:1rpx solid var(--line);border-radius:18rpx;background:#fff;gap:0; }
.home-stats .stat { border:0;border-right:1rpx solid var(--line);border-radius:0;background:transparent;margin:18rpx 0;padding:10rpx 8rpx; }
.home-stats .stat:last-child { border-right:0; }
.stat-unit { font-size:20rpx;font-weight:400;color:var(--muted);margin-left:6rpx; }
.coach-home-row { display:flex;align-items:center;gap:20rpx;width:100% !important;padding:24rpx;background:#fff;border:1rpx solid var(--line);border-radius:18rpx;text-align:left; }
.home-row-symbol { width:68rpx;height:76rpx;display:flex;align-items:center;justify-content:center;background:#edf1ff;color:var(--accent);font-size:24rpx;font-weight:700;border-radius:10rpx;flex:none; }
.chevron { color:var(--muted);font-size:36rpx;flex:none; }
.home-recent-list { background:#fff;border:1rpx solid var(--line);border-radius:18rpx;padding:0 24rpx; }
.home-recent-row { display:flex;align-items:center;gap:18rpx;padding:24rpx 0;border-bottom:1rpx solid var(--line); }
.home-recent-row:last-child { border-bottom:0; }
.recent-date { font-size:21rpx;color:var(--muted);width:120rpx;flex:none; }
.recent-finish { font-size:21rpx;color:#19704c; }
.home-empty { padding:30rpx 24rpx;background:#fff;border:1rpx dashed #bbc7d7;border-radius:18rpx;color:var(--muted); }
.home-empty .secondary { margin-top:20rpx;width:100%; }
.quick-grid { display:flex;flex-direction:column;border-top:1rpx solid var(--line); }
.quick-card { display:flex;align-items:center;gap:20rpx;width:100% !important;padding:24rpx 0;border-bottom:1rpx solid var(--line);border-radius:0;text-align:left; }
.quick-index { width:48rpx;flex:none;font-size:23rpx;font-weight:700;color:var(--accent); }
.coach-primary-tools { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx;margin-top:20rpx; }
.course-row { display:flex;align-items:center;gap:20rpx;width:100% !important;padding:24rpx 0;border-bottom:1rpx solid var(--line);text-align:left; }
.course-time { font-size:30rpx;font-weight:700;font-variant-numeric:tabular-nums;flex:none;border-left:4rpx solid var(--accent);padding-left:16rpx; }
.course-time text { display:block;font-size:22rpx;font-weight:400;color:var(--muted);margin-top:6rpx; }
.coach-student-card { padding:24rpx;background:#fff;border:1rpx solid var(--line);border-radius:18rpx;margin-bottom:14rpx; }
.student-initial { display:flex;align-items:center;justify-content:center;width:68rpx;height:68rpx;border-radius:12rpx;background:var(--surface-raised);font-size:19rpx;font-weight:700;overflow:hidden;flex:none; }
