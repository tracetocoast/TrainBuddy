.welcome {
  margin: 12rpx 0 28rpx;
}

.welcome .title {
  margin-top: 0;
}

.daily-card { padding: 30rpx; border: 1rpx solid #304351; background: linear-gradient(145deg,#243a4b,#172432); border-radius: 28rpx; }

.daily-intro {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 26rpx;
}

.daily-label {
  display: inline-block;
  color: #9fb9cc;
  font-size: 23rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.daily-title {
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1.4;
  margin-bottom: 10rpx;
}

.daily-card .primary {
  width: 100%;
}

.blue {
  background: #213849;
  color: #b7cbd9;
}
.orange {
  background: #302e2a;
  color: #c5b6a0;
}
.violet {
  background: #293348;
  color: #a4b7d8;
}

.chevron {
  font-size: 38rpx;
  color: #afbec6;
  flex-shrink: 0;
}

.quick-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.quick-card {
  display: flex;
  width: 100%;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border: 2rpx solid #304351;
  border-bottom-width: 5rpx;
  border-radius: 26rpx;
  text-align: left;
}

.quick-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  font-size: 36rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.coach-counts {
  display: flex;
  gap: 70rpx;
  margin: 24rpx 0;
}

.quick-card {
  width: 100% !important;
}

.home-page .flex > .link {
  flex: 0 0 auto;
}

.training-emblem { display: flex; align-items: center; justify-content: center; width: 156rpx; height: 160rpx; border-radius: 50%; background: radial-gradient(ellipse,rgba(137,178,207,.16),transparent 72%); flex-shrink: 0; }
