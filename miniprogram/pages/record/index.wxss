.student-chip {
  min-width: 140rpx;
  padding: 18rpx 20rpx;
}

.quick-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.quick-btn {
  margin: 0;
}

.seg-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.aset {
  margin-top: 12rpx;
  padding: 12rpx;
  background: var(--surface-raised);
  border-radius: 999rpx;
}

.aset-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.aset-no {
  font-weight: 600;
  min-width: 48rpx;
}

.mini-field {
  width: 110rpx;
  padding: 8rpx 10rpx;
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 10rpx;
  font-size: 24rpx;
  text-align: center;
}

.rec-btn {
  width: 100%;
  margin-top: 16rpx;
  min-height: 96rpx;
}

.rec-on {
  background: #ffffff !important;
  color: #ffffff !important;
}

.chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: var(--surface);
  border: 2rpx solid var(--line);
  font-size: 22rpx;
  font-weight: 600;
  color: var(--muted);
}

.chip.on {
  background: #edf1ff;
  border-color: #b7c6f9;
  color: var(--ink);
}

.warn {
  color: #9a612d;
}

.conflict {
  margin-top: 10rpx;
  padding: 10rpx;
  background: #fff3e3;
  border-radius: 12rpx;
}

.hidden {
  background: var(--surface-raised);
  border-style: dashed;
}

.patch-row {
  display: flex;
  gap: 8rpx;
  margin-top: 8rpx;
  flex-wrap: wrap;
}

.rec-on { background: #cf593b !important; color: #ffffff !important; }
.aset { border-radius:14rpx; }
.rec-on { background:#b42332 !important;color:#fff !important; }
.mini-field { height:88rpx;min-height:44px;font-size:30rpx;font-weight:650;font-variant-numeric:tabular-nums; }
.quick-btn,.chip { border-radius:10rpx;min-height:44px; }
.record-entry-tabs { display:flex;gap:6rpx;border:1rpx solid var(--line);border-radius:14rpx;background:var(--surface-raised);padding:6rpx;margin-top:28rpx; }
.record-entry-tabs button { flex:1;width:0 !important;min-height:44px;border-radius:10rpx;font-size:26rpx;color:var(--muted); }
.record-entry-tabs button.on { background:#fff;color:var(--ink);font-weight:700; }
.record-number { flex:1;min-width:0; }
.record-number > text { display:block;font-size:20rpx;color:var(--muted);margin-bottom:6rpx; }
.record-number .mini-field { width:100%;box-sizing:border-box; }
.aset-line { flex-wrap:nowrap;gap:12rpx;align-items:flex-end; }
.aset-no { padding-bottom:20rpx;min-width:38rpx; }
.aset-line .primary { padding:16rpx;min-height:44px; }
