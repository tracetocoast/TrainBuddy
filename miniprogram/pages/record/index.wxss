.student-chip {
  min-width: 140rpx;
  padding: 18rpx 20rpx;
}

.quick-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.quick-btn {
  margin: 0;
}

.seg-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #eef0e9;
}

.aset {
  margin-top: 12rpx;
  padding: 12rpx;
  background: #f2f4ed;
  border-radius: 14rpx;
}

.aset-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.aset-no {
  font-weight: 800;
  min-width: 48rpx;
}

.mini-field {
  width: 110rpx;
  padding: 8rpx 10rpx;
  background: #fff;
  border: 2rpx solid #e4e7dd;
  border-radius: 10rpx;
  font-size: 24rpx;
  text-align: center;
}

.rec-btn {
  width: 100%;
  margin-top: 16rpx;
  min-height: 96rpx;
}

.rec-on {
  background: #ff6b4a !important;
  color: #fff !important;
}

.chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 2rpx solid #e4e7dd;
  font-size: 22rpx;
  font-weight: 700;
  color: #74796d;
}

.chip.on {
  background: #c8ff36;
  border-color: #c8ff36;
  color: #151812;
}

.warn {
  color: #b85c00;
}

.conflict {
  margin-top: 10rpx;
  padding: 10rpx;
  background: #fff8e8;
  border-radius: 12rpx;
}

.hidden {
  background: #eceee6;
  border-style: dashed;
}

.patch-row {
  display: flex;
  gap: 8rpx;
  margin-top: 8rpx;
  flex-wrap: wrap;
}
