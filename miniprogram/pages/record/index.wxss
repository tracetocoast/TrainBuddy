.student-chip {
  min-width: 140rpx;
  padding: 18rpx 20rpx;
}

.quick-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.quick-btn {
  margin: 0;
}

.seg-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #e0e7dc;
}

.aset {
  margin-top: 12rpx;
  padding: 12rpx;
  background: #f1f4ee;
  border-radius: 14rpx;
}

.aset-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.aset-no {
  font-weight: 600;
  min-width: 48rpx;
}

.mini-field {
  width: 110rpx;
  padding: 8rpx 10rpx;
  background: var(--surface);
  border: 2rpx solid #e0e7dc;
  border-radius: 10rpx;
  font-size: 24rpx;
  text-align: center;
}

.rec-btn {
  width: 100%;
  margin-top: 16rpx;
  min-height: 96rpx;
}

.rec-on {
  background: #ffffff !important;
  color: #ffffff !important;
}

.chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: var(--surface);
  border: 2rpx solid #e0e7dc;
  font-size: 22rpx;
  font-weight: 600;
  color: #6e7c72;
}

.chip.on {
  background: #e6f0e4;
  border-color: #a5c5a7;
  color: #25352c;
}

.warn {
  color: #9a612d;
}

.conflict {
  margin-top: 10rpx;
  padding: 10rpx;
  background: #fff3e3;
  border-radius: 12rpx;
}

.hidden {
  background: #f1f4ee;
  border-style: dashed;
}

.patch-row {
  display: flex;
  gap: 8rpx;
  margin-top: 8rpx;
  flex-wrap: wrap;
}

.rec-on { background: #cf593b !important; color: #ffffff !important; }
