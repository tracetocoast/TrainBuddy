@import "../../styles/body.wxss";
.map-page { padding: 26rpx 28rpx calc(46rpx + env(safe-area-inset-bottom)); background: #fff; }
.map-toolbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28rpx; }.map-title { font-size: 32rpx; color: #272c31; font-weight: 600; }
.unit-switch { display: flex; border-radius: 40rpx; padding: 4rpx; background: #f0f0f2; }.unit-switch button { width: 74rpx !important; min-height: 48rpx; padding: 8rpx 0; font-size: 24rpx; border-radius: 40rpx; color: #34383c; }.unit-switch button.on { background: #fff; }
.map-tabs { display: flex; background: #f0f0f2; border-radius: 40rpx; padding: 5rpx; gap: 6rpx; margin-bottom: 28rpx; }.map-tabs button { flex: 1; width: 0 !important; padding: 14rpx; border-radius: 36rpx; color: #30353a; font-size: 28rpx; }.map-tabs button.on { background: #fff; font-weight: 700; }
.map-summaries { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 18rpx; }.map-summaries button { width: 100% !important; min-width: 0; border-radius: 18rpx; padding: 22rpx 18rpx; background: #f5f5f6; text-align: left; }.summary-label { color: #20262b; font-size: 26rpx; font-weight: 600; }.summary-date { font-size: 21rpx; color: #7c8085; margin-top: 12rpx; }.summary-value { display: flex; align-items: baseline; flex-wrap: wrap; gap: 5rpx; color: #087bfa; font-size: 39rpx; font-weight: 700; margin-top: 32rpx; }.summary-value text { color: #a0a3a8; font-size: 20rpx; font-weight: 400; }
.body-map { position: relative; height: 980rpx; margin-top: 28rpx; }.body-illustration { position: absolute; width: 330rpx; height: 902rpx; top: 0; left: 50%; margin-left: -165rpx; }
.map-tag { position: absolute; width: 180rpx; z-index: 1; }.tag-left { left: 20rpx; }.tag-right { right: 12rpx; }.map-value-row { width: 100% !important; display: block; background: transparent; padding: 0; min-height: 47rpx; text-align: left; font-size: 28rpx; font-weight: 600; color: #087bfa; line-height: 1.55; }.body-side { font-size: 24rpx; }.paired-label { font-size: 25rpx; font-weight: 600; color: #087bfa; margin-bottom: 2rpx; }
.map-connector { position: absolute; width: var(--reach); height: 2rpx; background: #d2dfe9; top: 100%; pointer-events: none; }.tag-left .map-connector { left: 0; width: calc(100% + var(--reach)); }.tag-right .map-connector { right: 0; width: calc(100% + var(--reach)); }
.map-connector view { position: absolute; width: 14rpx; height: 14rpx; border: 3rpx solid #d2dfe9; box-shadow: 0 0 0 3rpx #edf2f6; background: #b2c7d7; border-radius: 50%; top: -6rpx; }.tag-left .map-connector view { right: 0; }.tag-right .map-connector view { left: 0; }
.map-instruction { text-align: center; color: #a1a9b1; font-size: 22rpx; line-height: 1.8; margin: 0 0 22rpx; }.map-history-entry { display: flex; justify-content: space-between; gap: 16rpx; align-items: center; width: 100% !important; min-height: 84rpx; padding: 22rpx 18rpx; border-radius: 16rpx; background: #f5f5f6; font-size: 26rpx; color: #087bfa; }.map-history-entry text:last-child { color: #8b98a2; font-size: 23rpx; }
.chart-metric-picker { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0 26rpx; font-size: 30rpx; color: #344f63; }.chart-metric-picker text { font-size: 24rpx; color: #8b98a2; }
.measurement-weekdays,.measurement-calendar { display: grid; grid-template-columns: repeat(7,minmax(0,1fr)); text-align: center; gap: 10rpx; }.measurement-weekdays { color: #a1a9b1; font-size: 22rpx; margin-bottom: 16rpx; }.measurement-day { width: 100% !important; height: 82rpx; border-radius: 16rpx; font-size: 28rpx; color: #596c7b; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5rpx; }.measurement-day.selected { background: #eaf3ff; color: #087bfa; }.calendar-measure-dot { width: 7rpx; height: 7rpx; border-radius: 50%; background: #087bfa; }.calendar-selected-date { font-size: 27rpx; margin: 32rpx 0 16rpx; color: #344f63; }.calendar-record { padding: 20rpx 0; border-top: 1rpx solid #edf1f4; color: #344f63; font-size: 26rpx; }.calendar-record view:last-child { margin-top: 8rpx; font-size: 24rpx; color: #8b98a2; }
