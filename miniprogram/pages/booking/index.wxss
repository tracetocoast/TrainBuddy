.dates {
  white-space: nowrap;
  margin: 26rpx 0;
  width: 100%;
}

.date-btn {
  display: inline-flex;
  margin-right: 12rpx;
}

.seg {
  display: flex;
  gap: 8rpx;
  margin: 20rpx 0;
  padding: 8rpx;
  background: #f3f5f7;
  border-radius: 20rpx;
}

.seg-btn {
  flex: 1;
  border: 0;
  background: transparent;
  padding: 16rpx 8rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #757a6d;
  line-height: 1.2;
}

.seg-btn.on {
  background: #fff;
  color: #151812;
}

.week-grid {
  display: flex;
  gap: 8rpx;
  margin-top: 16rpx;
}

.week-col {
  flex: 1;
  background: #fff;
  border: 2rpx solid #e5e5e5;
  border-radius: 16rpx;
  padding: 16rpx 4rpx;
  text-align: center;
}

.week-hd {
  font-size: 18rpx;
  color: #777777;
  white-space: pre-line;
  line-height: 1.3;
}

.week-n {
  font-size: 36rpx;
  font-weight: 800;
  margin-top: 10rpx;
}
