@import "../../styles/interaction.wxss";
@import "../../styles/coach.wxss";

.booking-page {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.statuspill-muted {
  background: var(--tint-2);
  color: var(--muted);
  border-color: var(--line);
}

.schedule-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 28rpx 0 12rpx;
}
.schedule-tools {
  padding: 20rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--coach-radius);
  background: var(--surface);
}
.schedule-tools .secondary {
  width: 100% !important;
}

.coach-scope .seg {
  border-radius: 16rpx;
  gap: 4rpx;
  padding: 6rpx;
}
.coach-scope .seg-btn {
  min-height: 44px;
  border-radius: 12rpx;
  font-size: 24rpx;
}
.coach-scope .dates {
  margin: 24rpx 0;
}
.coach-scope .date-btn {
  width: 96rpx !important;
  min-width: 96rpx;
  min-height: 118rpx;
  margin-right: 10rpx;
  padding: 12rpx 8rpx;
  border-radius: 18rpx;
}

.dates {
  white-space: nowrap;
  margin: 26rpx 0;
  width: 100%;
}

.date-btn {
  position: relative;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100rpx !important;
  min-width: 100rpx;
  margin-right: 12rpx !important;
  padding: 18rpx 8rpx 14rpx;
  box-sizing: border-box;
}
.date-week {
  font-size: 20rpx;
  line-height: 1.2;
}
.date-mark {
  position: absolute;
  top: 6rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 16rpx;
  line-height: 1;
  white-space: nowrap;
  color: var(--accent);
  font-weight: 600;
}
.date-btn.is-today:not(.chosen) {
  border-color: var(--green-strong);
  background: var(--mint-1);
  color: var(--deep-green);
  box-shadow: inset 0 0 0 2rpx rgba(40, 116, 78, 0.12);
}
.date-btn.is-today:not(.chosen) .date-day {
  color: var(--deep-green);
}
.date-btn.is-closed:not(.chosen) {
  opacity: 0.55;
  border-style: dashed;
}
.date-btn.is-open:not(.chosen) .date-mark {
  color: var(--accent);
}
.date-btn.chosen .date-mark {
  color: rgba(255, 255, 255, 0.92);
}
.date-btn.chosen::after {
  content: '已选';
  display: block;
  margin-top: 4rpx;
  font-size: 16rpx;
  line-height: 1;
  color: rgba(255, 255, 255, 0.9);
}
.date-press {
  transform: scale(0.96);
  opacity: 0.92;
}

.seg {
  display: flex;
  gap: 8rpx;
  margin: 20rpx 0;
  padding: 8rpx;
  background: var(--surface-raised);
  border-radius: 20rpx;
}
.seg-btn {
  flex: 1;
  border: 0;
  background: transparent;
  padding: 16rpx 8rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--muted);
  line-height: 1.2;
}
.seg-btn.on {
  background: var(--surface);
  color: var(--ink);
}

/* 加载 */
.bk-load {
  margin: 12rpx 0 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: var(--tint-1);
  border: 1rpx solid var(--line);
  color: var(--muted);
  font-size: 24rpx;
}
.bk-load-bar {
  height: 6rpx;
  border-radius: 999rpx;
  margin-bottom: 12rpx;
  background: linear-gradient(90deg, var(--ix-soft), var(--accent), var(--ix-soft));
  background-size: 200% 100%;
  animation: bkBarSlide 1.5s linear infinite;
}
@keyframes bkBarSlide {
  from { background-position: 100% 0; }
  to { background-position: -100% 0; }
}

/* 摘要 */
.bk-summary {
  background: var(--surface);
  padding: 24rpx;
  border: 1rpx solid var(--blue-line);
  border-radius: 24rpx;
  margin: 20rpx 0;
}
.bk-summary-on {
  border-color: var(--green-strong);
  box-shadow: 0 8rpx 24rpx rgba(40, 116, 78, 0.08);
}
.bk-summary-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 12rpx;
}
.bk-summary-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid var(--tint-2);
  font-size: 25rpx;
}
.bk-summary-row:last-of-type {
  border-bottom: 0;
  margin-bottom: 8rpx;
}
.bk-k {
  color: var(--muted);
  flex-shrink: 0;
}
.bk-v {
  color: var(--ink);
  font-weight: 500;
  text-align: right;
  min-width: 0;
  word-break: break-word;
}

/* 时段按钮网格 */
.slot-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.slot-btn {
  width: 100% !important;
  margin: 0 !important;
  padding: 20rpx 18rpx;
  border-radius: 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  text-align: left;
  box-sizing: border-box;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
}
.slot-btn::after {
  border: none;
}
.slot-btn-open {
  border-color: var(--green-strong);
}
.slot-btn-off {
  opacity: 0.55;
  background: var(--tint-1);
  border-style: dashed;
}
.slot-btn-on {
  border-color: var(--accent);
  background: var(--mint-1);
  box-shadow: inset 0 0 0 2rpx rgba(40, 116, 78, 0.18);
}
.slot-btn-press {
  transform: scale(0.98);
}
.slot-btn-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}
.slot-btn-time {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.slot-btn-mark {
  flex-shrink: 0;
  font-size: 18rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: var(--tint-2);
  color: var(--muted);
}
.slot-btn-on .slot-btn-mark {
  background: var(--accent);
  color: var(--on-accent);
  font-weight: 600;
}
.slot-btn-off .slot-btn-mark {
  background: var(--linen-1);
  color: var(--muted-2);
}
.slot-btn-name {
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.slot-btn-sub {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--muted);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bk-card {
  padding: 22rpx 20rpx;
  margin-bottom: 12rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
}
.bk-card-press {
  opacity: 0.92;
}
.pending-card {
  border-color: var(--warn-line);
  background: linear-gradient(180deg, var(--linen-1) 0%, var(--surface) 55%);
}

/* 教练时间轴 */
.timeline {
  margin-top: 8rpx;
}
.timeline-item {
  display: flex;
  gap: 12rpx;
  min-width: 0;
}
.timeline-rail {
  width: 28rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 10rpx;
}
.timeline-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--green-strong);
  border: 3rpx solid var(--ix-soft);
  flex-shrink: 0;
}
.timeline-line {
  flex: 1;
  width: 2rpx;
  background: var(--line);
  margin-top: 6rpx;
  min-height: 24rpx;
}
.timeline-item:last-child .timeline-line {
  opacity: 0;
}
.timeline-body {
  flex: 1;
  min-width: 0;
  padding-bottom: 18rpx;
}
.timeline-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  margin-bottom: 8rpx;
}
.timeline-time {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}
.timeline-flag {
  font-size: 18rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: var(--ix-soft);
  color: var(--deep-green);
  flex-shrink: 0;
}
.timeline-item.is-upcoming .timeline-dot {
  background: var(--accent);
  box-shadow: 0 0 0 6rpx rgba(40, 116, 78, 0.15);
}
.timeline-item.is-upcoming .timeline-flag {
  background: var(--accent);
  color: var(--on-accent);
}
.timeline-item.is-live .timeline-dot {
  background: var(--warm-ink);
  box-shadow: 0 0 0 6rpx rgba(174, 112, 67, 0.16);
}
.timeline-item.is-live .timeline-flag {
  background: var(--warm-tint);
  color: var(--warm-ink);
}
.schedule-course {
  padding: 18rpx 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  background: var(--surface);
  min-height: 96rpx;
  box-sizing: border-box;
}
.timeline-item.is-upcoming .schedule-course {
  border-color: var(--green-strong);
  background: var(--mint-1);
}
.timeline-item.is-live .schedule-course {
  border-color: var(--warn-line);
  background: var(--linen-1);
}
.schedule-course .slot {
  width: 100%;
}
.schedule-course .statuspill {
  max-width: 140rpx;
  white-space: normal;
  text-align: center;
}
.schedule-course .card-title {
  margin-bottom: 4rpx;
}
.schedule-course .sub {
  font-size: 23rpx;
}
.open-slots-toggle {
  margin-top: 24rpx;
  max-width: none;
  font-weight: 400;
}
.open-slot-chip {
  display: inline-block;
  margin: 8rpx 8rpx 0 0;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: var(--ix-soft);
  border: 1rpx solid var(--green-strong);
  color: var(--deep-green);
  font-size: 22rpx;
}

.week-grid {
  display: flex;
  gap: 8rpx;
  margin-top: 16rpx;
}
.week-col {
  flex: 1;
  min-width: 0;
  margin: 0 !important;
  width: auto !important;
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  padding: 16rpx 2rpx;
  text-align: center;
  box-sizing: border-box;
}
.week-col::after {
  border: none;
}
.week-col.is-today {
  border-color: var(--green-strong);
  background: var(--mint-1);
}
.week-col.is-selected {
  border-color: var(--accent);
  box-shadow: inset 0 0 0 2rpx rgba(40, 116, 78, 0.16);
}
.week-hd {
  font-size: 18rpx;
  color: var(--muted);
  white-space: pre-line;
  line-height: 1.3;
}
.week-day {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  color: var(--ink);
}
.week-n {
  font-size: 36rpx;
  font-weight: 600;
  margin-top: 10rpx;
  color: var(--ink);
}
.week-hint {
  margin-top: 6rpx;
  font-size: 18rpx;
  color: var(--muted);
  line-height: 1.3;
}
.week-hint.is-pending {
  color: var(--warm-ink);
  font-weight: 600;
}

.skin-dark .slot-btn-open {
  background: var(--surface-raised);
  border-color: var(--green-strong);
}
.skin-dark .slot-btn-on {
  background: var(--mint-3);
  border-color: var(--accent);
  box-shadow: none;
}
.skin-dark .slot-btn-off {
  opacity: 1;
  background: var(--paper);
  border-color: var(--line);
  border-style: dashed;
}
.skin-dark .slot-btn-off .slot-btn-mark {
  background: var(--tint-2);
  color: var(--muted-2);
}
.skin-dark .bk-summary .submit {
  background: var(--accent) !important;
  color: var(--on-accent) !important;
}
.skin-dark .bk-summary .submit.is-disabled {
  background: var(--disabled-bg) !important;
  color: var(--disabled-ink) !important;
}

.ix-reduced .bk-load-bar,
.ui-reduced .bk-load-bar {
  animation: none !important;
}
.ix-reduced .date-btn,
.ix-reduced .slot-btn,
.ix-reduced .week-col {
  transition: none !important;
}

@media (prefers-reduced-motion: reduce) {
  .bk-load-bar {
    animation: none !important;
  }
}

@media (max-width: 360px) {
  .slot-grid {
    grid-template-columns: 1fr;
  }
}
