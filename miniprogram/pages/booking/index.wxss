@import "../../styles/interaction.wxss";
.dates {
  white-space: nowrap;
  margin: 26rpx 0;
  width: 100%;
}

.date-btn {
  display: inline-flex;
  margin-right: 12rpx;
}

.seg {
  display: flex;
  gap: 8rpx;
  margin: 20rpx 0;
  padding: 8rpx;
  background: var(--surface-raised);
  border-radius: 20rpx;
}

.seg-btn {
  flex: 1;
  border: 0;
  background: transparent;
  padding: 16rpx 8rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--muted);
  line-height: 1.2;
}

.seg-btn.on {
  background: var(--surface);
  color: var(--ink);
}

.week-grid {
  display: flex;
  gap: 8rpx;
  margin-top: 16rpx;
}

.week-col {
  flex: 1;
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  padding: 16rpx 4rpx;
  text-align: center;
}

.week-hd {
  font-size: 18rpx;
  color: var(--muted);
  white-space: pre-line;
  line-height: 1.3;
}

.week-n {
  font-size: 36rpx;
  font-weight: 600;
  margin-top: 10rpx;
}

.booking-submit { background:#fff;padding:24rpx;border:1rpx solid #dce2e8;border-radius:16rpx;margin:20rpx 0; }
.booking-submit .sub { margin-bottom:16rpx; }
