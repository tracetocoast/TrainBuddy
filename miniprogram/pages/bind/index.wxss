.page-solo {
  padding-bottom: 60rpx;
}

.scope-row {
  display: flex;
  gap: 20rpx;
  align-items: center;
  background: var(--surface);
  border: 2rpx solid #e0e7dc;
  border-radius: 32rpx;
  padding: 22rpx;
  margin-top: 12rpx;
}

.check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  border: 2rpx solid #e0e7dc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
  background: var(--surface);
  font-weight: 600;
}

.check.on {
  background: #e6f0e4;
  border-color: #a5c5a7;
}

.check.on { background: #28744e; border-color: #28744e; color: #ffffff; }
