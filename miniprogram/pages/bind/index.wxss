.page-solo {
  padding-bottom: 60rpx;
}

.scope-row {
  display: flex;
  gap: 20rpx;
  align-items: center;
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  padding: 22rpx;
  margin-top: 12rpx;
}

.check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
  background: var(--surface);
  font-weight: 600;
}

.check.on {
  background: #eef4e9;
  border-color: #b7c6f9;
}

.check.on { background: var(--accent); border-color: var(--accent); color: #ffffff; }
