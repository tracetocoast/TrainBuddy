.page-solo {
  padding-bottom: 60rpx;
}

.scope-row {
  display: flex;
  gap: 20rpx;
  align-items: center;
  background: var(--surface);
  border: 2rpx solid #304351;
  border-radius: 24rpx;
  padding: 22rpx;
  margin-top: 12rpx;
}

.check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  border: 2rpx solid #40596d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
  background: var(--surface);
  font-weight: 800;
}

.check.on {
  background: #28465b;
  border-color: #52718a;
}
