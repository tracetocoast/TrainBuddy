<view class="ai-page">
  <view class="top">
    <view class="brand ai-brand">
      <text class="mark">↗</text>练搭子
      <text class="brand-sub ai-sub">TRAIN BUDDY</text>
    </view>
  </view>

  <role-switcher />

  <view class="eyebrow ai-eye">AI LAB · BODY INSIGHT</view>
  <view class="title ai-title">看见姿态，<br/>找到下一步。</view>
  <view class="sub ai-desc">用记录帮助你理解身体变化。AI 建议仅供训练参考。</view>

  <view class="aibox">
    <text class="pill">POSTURE SCAN 01</text>
    <view class="hero-title" style="margin:24rpx 0 0;color:#fff;">体态扫描</view>
    <view class="scan">
      <view class="silhouette">♙</view>
      <view class="scan-line"></view>
      <view class="scanlabel">
        <text>BODY ALIGNMENT</text>
        <text>READY TO SCAN</text>
      </view>
    </view>
    <view class="twobtn">
      <button class="darkbtn" bindtap="onFront">＋ 正面照片</button>
      <button class="darkbtn" bindtap="onSide">＋ 侧面照片</button>
    </view>
    <button class="primary" style="width:100%;margin-top:20rpx" bindtap="onScan">开始 AI 体态分析 ↗</button>
  </view>

  <view class="aimetrics">
    <view class="stat ai-stat"><strong>82/100</strong><span>示例姿态参考分</span></view>
    <view class="stat ai-stat"><strong>03</strong><span>建议关注方向</span></view>
  </view>

  <view class="note">当前为原型示例数据，不是对真实身体的评估，也不能替代医生或专业康复人员诊断。</view>

  <view class="head">
    <view class="head-title" style="color:#fff">阶段记录</view>
    <text class="tag">DEMO</text>
  </view>
  <view class="aibox">
    <view class="card-title" style="color:#fff">本阶段建议</view>
    <view class="sub ai-desc">核心稳定 · 髋踝活动度 · 动作控制</view>
    <button class="darkbtn" style="width:100%;margin-top:24rpx" bindtap="onReport">查看示例报告</button>
  </view>
</view>

<bottom-nav active="ai" />
