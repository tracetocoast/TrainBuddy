/* AI 宸ュ叿椤碉細鏆栫櫧 + 璁粌缁匡紱鍒嗘瀽鍖哄皯閲忔繁鑹茬鎶€鎰熺粏鑺?*/

.ai-page {
  min-height: 100vh;
  padding: 2rpx 32rpx calc(156rpx + env(safe-area-inset-bottom));
  background: var(--paper);
  color: var(--ink);
}
.ai-page button {
  margin-left: 0 !important;
  margin-right: 0 !important;
}
.ai-brand {
  color: var(--ink);
  font-size: 31rpx;
  font-weight: 500;
}
.ai-brand-detail {
  margin-left: 18rpx;
  font-size: 17rpx;
  letter-spacing: 3rpx;
  color: var(--muted);
}
.ai-services-label {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12rpx;
  margin: 12rpx 2rpx 18rpx;
  font-size: 24rpx;
  color: var(--muted);
}
.ai-service-count {
  font-size: 19rpx;
  letter-spacing: 1rpx;
  color: var(--muted);
  flex-shrink: 0;
}

/* 鈥斺€?宸ュ叿鍏ュ彛缃戞牸 鈥斺€?*/
.tool-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 14rpx;
  margin-bottom: 20rpx;
}
.tool-card-entry {
  width: 100% !important;
  margin: 0 !important;
  padding: 24rpx 0;
  border-radius: 6rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  text-align: left;
  box-shadow: none;
  transition:
    transform 0.2s cubic-bezier(0.34, 1.35, 0.64, 1),
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}
.tool-card-entry::after {
  border: none;
}
.tool-card-entry-on {
  border-color: var(--accent);
  box-shadow: none;
  background: var(--mint-1);
}
.tool-card-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ix-soft);
}
.tool-icon-food {
  background: var(--surface-raised);
}
.tool-icon-posture {
  background: var(--surface-raised);
}
.tool-icon-posture .tool-card-index {
  color: var(--muted);
}
.tool-icon-goal {
  background: var(--surface-raised);
}
.tool-card-index {
  font-size: 18rpx;
  letter-spacing: 1rpx;
  color: var(--accent);
  font-weight: 600;
}
.tool-card-body {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
  width: 100%;
}
.tool-card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}
.tool-card-blurb {
  font-size: 20rpx;
  line-height: 1.45;
  color: var(--muted);
}
.tool-card-action {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--accent);
  font-weight: 500;
}

.tool-panel {
  margin-top: 0;
}
.ai-desc.short {
  margin-bottom: 4rpx;
}

.aibox {
  padding: 32rpx 0;
  border: 0;
  border-top: 1rpx solid var(--line);
  border-radius: 0;
  margin-bottom: 22rpx;
  background: var(--surface);
  box-shadow: none;
}
.row-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}
.ai-section-number {
  font-size: 18rpx;
  color: var(--muted);
  letter-spacing: 3rpx;
}
.ai-badge {
  font-size: 19rpx;
  color: var(--accent);
  background: var(--ix-soft);
  border: 1rpx solid var(--green-strong);
  padding: 8rpx 16rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}
.ai-service-title {
  font-size: 35rpx;
  font-weight: 500;
  margin: 22rpx 0 12rpx;
  letter-spacing: 1rpx;
}
.ai-desc {
  font-size: 25rpx;
  line-height: 1.75;
  color: var(--muted);
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin: 24rpx 0;
}
.photo-slot {
  width: 100% !important;
  border: 1rpx dashed var(--green-strong);
  border-radius: 6rpx;
  background: var(--tint-1);
  padding: 20rpx 10rpx;
  color: var(--deep-green);
  text-align: center;
  overflow: hidden;
  transition: transform 0.18s cubic-bezier(0.34, 1.4, 0.64, 1), border-color 0.2s ease;
}
.photo-slot::after {
  border: none;
}
.photo-slot[disabled] {
  opacity: 0.6;
}
.photo-ready {
  border-style: solid;
  border-color: var(--green-strong);
  background: var(--ix-soft);
}
.photo-thumb {
  width: 100%;
  height: 200rpx;
  border-radius: 6rpx;
  display: block;
  margin-bottom: 12rpx;
  background: var(--mint-3);
}
.photo-frame {
  width: 60rpx;
  height: 78rpx;
  margin: 0 auto 14rpx;
  border: 1rpx solid var(--green-strong);
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface);
}
.photo-frame text {
  color: var(--accent);
  font-size: 32rpx;
  font-weight: 300;
}
.side-frame {
  width: 48rpx;
}
.photo-title {
  font-size: 27rpx;
  margin-bottom: 6rpx;
}
.photo-sub {
  font-size: 20rpx;
  line-height: 1.55;
  color: var(--muted);
}

.ai-primary,
.ai-outline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  width: 100% !important;
  min-height: 92rpx;
  border-radius: 6rpx;
  padding: 20rpx 28rpx;
  font-size: 27rpx;
  font-weight: 500;
  transition: transform 0.18s cubic-bezier(0.34, 1.4, 0.64, 1), opacity 0.15s ease;
}
.ai-primary::after,
.ai-outline::after {
  border: none;
}
.ai-primary {
  background: var(--accent);
  border: 1rpx solid var(--accent);
  color: var(--on-accent);
  box-shadow: none;
}
.ai-outline {
  background: var(--ix-soft);
  border: 1rpx solid var(--green-strong);
  color: var(--accent);
  margin-top: 20rpx;
}
.ai-primary[disabled],
.ai-outline[disabled] {
  opacity: 0.5;
  box-shadow: none;
}
.ai-btn-press {
  transform: scale(0.96);
  opacity: 0.92;
}

.ai-footnote {
  font-size: 20rpx;
  line-height: 1.75;
  color: var(--muted);
  margin-top: 16rpx;
}
.vision-timeline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 12rpx 12rpx;
  gap: 22rpx;
}
.vision-line {
  flex: 1;
  height: 2rpx;
  background: var(--line);
}
.vision-month {
  display: block;
  font-size: 48rpx;
  font-weight: 300;
  color: var(--warm-ink);
  font-family: Georgia, 'Times New Roman', serif;
}
.vision-caption {
  font-size: 20rpx;
  color: var(--muted);
}

.ai-settings {
  padding: 22rpx 24rpx 28rpx;
  margin-bottom: 12rpx;
  border-radius: 6rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
}
.ai-settings-title {
  font-size: 24rpx;
  color: var(--muted);
}
.mode-group {
  display: flex;
  gap: 20rpx;
}
.mode-item {
  display: flex;
  align-items: center;
  color: var(--muted);
  font-size: 23rpx;
}
.mode-item radio {
  transform: scale(0.7);
}
.hint {
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.7;
  margin-top: 12rpx;
}
.ai-motion {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--tint-2);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 23rpx;
  color: var(--muted);
}
.ai-motion switch {
  transform: scale(0.78);
  transform-origin: right center;
}

/* 鈥斺€?鐘舵€?/ 缁撴灉 鈥斺€?*/
.status-box.tone-warn {
  border-color: var(--warn-line);
  background: var(--surface-raised);
}
.status-box.tone-ok {
  border-color: var(--green-strong);
  background: var(--surface-raised);
}
.status-box.tone-err {
  border-color: var(--rose-line);
  background: var(--surface-raised);
}
.status-chip {
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
  background: var(--tint-2);
  color: var(--muted);
}
.status-chip.tone-ok {
  background: var(--mint-2);
  color: var(--deep-green);
}
.status-chip.tone-warn {
  background: var(--warm-tint);
  color: var(--warm-ink);
}
.status-chip.tone-err {
  background: var(--rose-tint);
  color: var(--danger);
}
.status-chip.tone-muted {
  background: var(--tint-2);
  color: var(--muted);
}

.status-steps {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 18rpx 0 8rpx;
}
.status-step {
  font-size: 22rpx;
  color: var(--muted-2);
  padding: 8rpx 14rpx;
  border-radius: 6rpx;
  background: var(--linen-1);
  flex-shrink: 0;
}
.status-step.on {
  color: var(--accent);
  background: var(--ix-soft);
}
.status-step.ok {
  color: var(--deep-green);
  background: var(--mint-3);
  font-weight: 500;
}
.status-step.err {
  color: var(--danger);
  background: var(--rose-tint);
  font-weight: 500;
}
.status-step.pulse {
  animation: aiSoftPulse 1.4s ease-in-out infinite;
}
.status-step-line {
  flex: 1;
  height: 2rpx;
  background: var(--line);
  min-width: 16rpx;
}
.status-pulse {
  margin-top: 16rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: var(--surface-raised);
  background-size: 200% 100%;
  animation: aiBarSlide 1.6s linear infinite;
}

.ai-result-title {
  font-size: 30rpx;
  color: var(--ink);
  margin-bottom: 12rpx;
}
.ai-error {
  color: var(--danger);
  font-size: 24rpx;
  margin-top: 12rpx;
  line-height: 1.55;
}
.item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 25rpx;
}
.item-row:last-of-type {
  border-bottom: none;
}
.item-row.tone-warn .item-val {
  color: var(--warm-ink);
  font-weight: 500;
}
.item-row.tone-ok .item-val {
  color: var(--deep-green);
}
.item-row.tone-muted .item-val {
  color: var(--muted-2);
}
.item-label {
  color: var(--muted);
}
.item-val {
  color: var(--ink);
  text-align: right;
}
.report-box {
  overflow: hidden;
  padding: 0;
}
.report-box .row-between,
.report-box > .ai-desc.short {
  padding-left: 32rpx;
  padding-right: 32rpx;
  background: var(--paper);
}
.report-box .row-between {
  padding-top: 28rpx;
  align-items: flex-start;
}
.report-box .ai-result-title {
  color: var(--ink);
  margin-bottom: 0;
}
.report-box > .ai-desc.short {
  color: var(--muted);
  padding-bottom: 28rpx;
  margin-bottom: 0;
}
.report-box .ai-badge {
  background: rgba(238, 244, 233, 0.12);
  border-color: rgba(212, 227, 204, 0.35);
  color: var(--muted);
}
.report-body {
  padding: 8rpx 32rpx 28rpx;
  background: var(--surface);
}
.ai-bottom-note {
  text-align: center;
  color: var(--muted);
  letter-spacing: 7rpx;
  font-size: 22rpx;
  padding: 24rpx 0 12rpx;
}
.linkish {
  width: 100% !important;
  color: var(--muted);
  font-size: 22rpx;
  padding: 18rpx 0;
  text-align: center;
}

.food-entry-button {
  justify-content: center;
  padding: 18rpx 10rpx;
  min-height: 84rpx;
  margin-top: 0;
  font-size: 26rpx;
}

.goal-photo-grid {
  grid-template-columns: 1fr;
}
.goal-thumb {
  width: 100%;
  height: 280rpx;
  border-radius: 6rpx;
  display: block;
  margin-bottom: 12rpx;
  background: var(--ix-soft);
}

.goal-result-box {
  padding-bottom: 24rpx;
}
.goal-result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.goal-result-title {
  margin-bottom: 0;
  flex: 1;
  min-width: 0;
}
.goal-result-hint {
  margin-top: 6rpx;
  margin-bottom: 8rpx;
  font-size: 22rpx;
}
.goal-node {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.goal-node:last-of-type {
  border-bottom: none;
  padding-bottom: 8rpx;
}
.goal-node-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
  min-width: 0;
}
.goal-node-title {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
  line-height: 1.4;
}
.goal-node-wm {
  font-size: 20rpx;
  color: var(--muted-2);
  line-height: 1.4;
}
.goal-node-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  width: 100%;
}
.goal-action-btn {
  width: auto !important;
  min-width: 0;
  flex: 0 0 auto;
  margin: 0 !important;
  padding: 12rpx 22rpx;
  line-height: 1.3;
  font-size: 24rpx;
  color: var(--accent);
  background: var(--tint-1);
  border: 1rpx solid var(--green-strong);
  border-radius: 6rpx;
  box-sizing: border-box;
  transition: transform 0.16s cubic-bezier(0.34, 1.4, 0.64, 1);
}
.goal-action-btn::after {
  border: none;
}
.goal-action-primary {
  background: var(--ix-soft);
  border-color: var(--accent);
  color: var(--deep-green);
  font-weight: 500;
}

/* 杩涘叆鍔ㄦ晥 */
.panel-enter {
  animation: aiFadeUp 0.32s cubic-bezier(0.34, 1.15, 0.64, 1);
}
.result-enter {
  animation: aiFadeUp 0.36s cubic-bezier(0.34, 1.15, 0.64, 1);
}

/* Bottom sheet */
.goal-sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  animation: aiMaskIn 0.22s ease;
}
.goal-sheet-backdrop {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(24, 32, 28, 0.48);
}
.goal-sheet {
  position: relative;
  z-index: 1;
  width: 100%;
  max-height: 86vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--paper);
  color: var(--ink);
  border-radius: 40rpx 40rpx 0 0;
  padding: 16rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  box-shadow: none;
}
.goal-sheet-body {
  flex: 1;
  height: 52vh;
  max-height: 52vh;
  margin-top: 8rpx;
}
.goal-sheet-enter {
  animation: aiSheetUp 0.38s cubic-bezier(0.34, 1.2, 0.64, 1);
}
.goal-sheet-handle {
  width: 64rpx;
  height: 8rpx;
  border-radius: 6rpx;
  background: var(--ink-2);
  margin: 4rpx auto 22rpx;
}
.goal-sheet-title {
  font-size: 34rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}
.goal-sheet-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--muted-2);
  line-height: 1.6;
}
.goal-cfg-block {
  margin-top: 34rpx;
}
.goal-cfg-label {
  font-size: 26rpx;
  color: var(--muted);
  margin-bottom: 16rpx;
}
.goal-cfg-option {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 18rpx 4rpx;
  font-size: 25rpx;
  line-height: 1.55;
  color: var(--muted);
}
.goal-cfg-option radio {
  transform: scale(0.82);
  margin-top: 4rpx;
}
.goal-sheet-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 36rpx;
}
.goal-sheet-btn {
  flex: 1;
  width: auto !important;
  border-radius: 999rpx !important;
}
.goal-sheet .secondary {
  background: transparent;
  border: 1rpx solid var(--ink-2);
  color: var(--muted);
}
.goal-sheet .primary {
  background: var(--accent);
  border: 1rpx solid var(--accent);
  color: var(--on-accent);
}

@keyframes aiSheetUp {
  from {
    transform: translateY(48%);
    opacity: 0.6;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}
@keyframes aiMaskIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
@keyframes aiFadeUp {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@keyframes aiSoftPulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.55;
  }
}
@keyframes aiBarSlide {
  from {
    background-position: 100% 0;
  }
  to {
    background-position: -100% 0;
  }
}

.ui-reduced .panel-enter,
.ui-reduced .result-enter,
.ui-reduced .goal-sheet-enter,
.ui-reduced .goal-sheet-mask,
.ix-reduced .panel-enter,
.ix-reduced .result-enter,
.ix-reduced .goal-sheet-enter,
.ix-reduced .goal-sheet-mask {
  animation: none !important;
}
.ui-reduced .status-step.pulse,
.ui-reduced .status-pulse,
.ix-reduced .status-step.pulse,
.ix-reduced .status-pulse,
.ui-reduced .tool-card-entry,
.ui-reduced .photo-slot,
.ui-reduced .ai-primary,
.ui-reduced .ai-outline,
.ui-reduced .goal-action-btn,
.ix-reduced .tool-card-entry,
.ix-reduced .photo-slot,
.ix-reduced .ai-primary,
.ix-reduced .ai-outline,
.ix-reduced .goal-action-btn {
  animation: none !important;
  transition: none !important;
}

@media (prefers-reduced-motion: reduce) {
  .panel-enter,
  .result-enter,
  .goal-sheet-enter,
  .goal-sheet-mask,
  .status-step.pulse,
  .status-pulse {
    animation: none !important;
  }
  .tool-card-entry,
  .photo-slot,
  .ai-primary,
  .ai-outline,
  .goal-action-btn {
    transition: none !important;
  }
}
