.ai-page { min-height: 100vh; padding: 0 32rpx calc(156rpx + env(safe-area-inset-bottom)); background: #fafbf7; color: #25352c; }
.ai-page button { margin-left: 0 !important; margin-right: 0 !important; }
.ai-brand { color: #25352c; font-size: 31rpx; font-weight: 500; }

.ai-brand-detail { margin-left: 18rpx; font-size: 17rpx; letter-spacing: 3rpx; color: #6e7c72; }
.ai-intro { position: relative; padding: 40rpx 0 44rpx; overflow: hidden; }
.ai-kicker { font-size: 17rpx; letter-spacing: 3rpx; color: #6e7c72; position: relative; z-index: 1; }
.ai-heading { margin: 24rpx 0 22rpx; font-size: 58rpx; line-height: 1.4; font-weight: 400; letter-spacing: 2rpx; position: relative; z-index: 1; }
.ai-lead { font-size: 25rpx; color: #6e7c72; line-height: 1.8; position: relative; z-index: 1; }
.ai-orbit { position: absolute; right: -56rpx; top: 66rpx; width: 282rpx; height: 282rpx; border: 1rpx solid #e0e7dc; border-radius: 50%; transform: rotate(-28deg); background: #ffffff; }
.orbit-inner { position: absolute; left: 48rpx; top: -10rpx; width: 160rpx; height: 300rpx; border: 1rpx solid #e0e7dc; border-radius: 50%; }
.orbit-point { position: absolute; top: 28rpx; left: 30rpx; width: 14rpx; height: 14rpx; background: #ffffff; border-radius: 50%; box-shadow: 0 0 24rpx rgba(188,220,239,.5); }
.ai-services-label { display: flex; justify-content: space-between; margin: 0 2rpx 20rpx; font-size: 24rpx; color: #6e7c72; }
.ai-service-count { font-size: 19rpx; letter-spacing: 3rpx; color: #6e7c72; }
.aibox { padding: 30rpx; border: 1rpx solid #e0e7dc; border-radius: 28rpx; margin-bottom: 22rpx; background: #ffffff; }
.row-between { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; }
.ai-section-number { font-size: 18rpx; color: #6e7c72; letter-spacing: 3rpx; }
.ai-badge { font-size: 19rpx; color: #28744e; border: 1rpx solid #e0e7dc; padding: 6rpx 13rpx; border-radius: 30rpx; }
.ai-service-title { font-size: 39rpx; font-weight: 500; margin: 28rpx 0 14rpx; letter-spacing: 1rpx; }
.ai-desc { font-size: 25rpx; line-height: 1.8; color: #6e7c72; }
.photo-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16rpx; margin: 28rpx 0; }
.photo-slot { width: 100% !important; border: 1rpx dashed #e0e7dc; border-radius: 20rpx; background: #f5f7f0; padding: 28rpx 10rpx; color: #25352c; text-align: center; }
.photo-slot[disabled] { opacity: .6; }
.photo-ready { border-style: solid; border-color: #e0e7dc; }
.photo-frame { width: 60rpx; height: 78rpx; margin: 0 auto 18rpx; border: 1rpx solid #e0e7dc; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; }
.photo-frame text { color: #28744e; font-size: 32rpx; font-weight: 300; }
.side-frame { width: 48rpx; }
.photo-title { font-size: 27rpx; margin-bottom: 8rpx; }
.photo-sub { font-size: 20rpx; line-height: 1.6; color: #6e7c72; }
.ai-primary,.ai-outline { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; width: 100% !important; min-height: 92rpx; border-radius: 18rpx; padding: 20rpx 26rpx; font-size: 27rpx; font-weight: 500; }
.ai-primary { background: #ffffff; border: 1rpx solid #e0e7dc; color: #6e7c72; }
.ai-outline { background: transparent; border: 1rpx solid #e0e7dc; color: #28744e; margin-top: 24rpx; }
.ai-primary[disabled],.ai-outline[disabled] { opacity: .5; }
.ai-footnote { font-size: 20rpx; line-height: 1.8; color: #6e7c72; margin-top: 18rpx; }
.vision-timeline { display: flex; align-items: center; justify-content: space-between; margin: 36rpx 12rpx; gap: 22rpx; }
.vision-month { display: block; font-size: 48rpx; font-weight: 300; color: #ae7043; font-family: Georgia,serif; }
.vision-caption { font-size: 20rpx; color: #6e7c72; }.vision-line { height: 1rpx; background: #ffffff; flex: 1; }
.ai-settings { padding: 22rpx 4rpx 30rpx; }.ai-settings-title { font-size: 24rpx; color: #6e7c72; }
.mode-group { display: flex; gap: 20rpx; }.mode-item { display: flex; align-items: center; color: #6e7c72; font-size: 23rpx; }.mode-item radio { transform: scale(.7); }
.hint { color: #6e7c72; font-size: 22rpx; line-height: 1.7; margin-top: 12rpx; }
.ai-result-title { font-size: 30rpx; color: #25352c; margin-bottom: 12rpx; }.ai-error { color: #b84d3b; font-size: 24rpx; margin-top: 12rpx; }
.item-row,.node-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 22rpx 0; border-bottom: 1rpx solid #e0e7dc; font-size: 25rpx; }
.item-label { color: #6e7c72; }.item-val { color: #25352c; text-align: right; }
.node-main { display: flex; flex-direction: column; gap: 8rpx; color: #25352c; }.wm { font-size: 20rpx; color: #6e7c72; }.node-actions { display: flex; gap: 12rpx; flex-shrink: 0; }
.mini-btn { border: 1rpx solid #e0e7dc; border-radius: 12rpx; padding: 12rpx 18rpx; font-size: 23rpx; color: #28744e; }
.ai-bottom-note { text-align: center; color: #6e7c72; letter-spacing: 7rpx; font-size: 22rpx; padding: 24rpx 0 12rpx; }
.linkish { width: 100% !important; color: #6e7c72; font-size: 22rpx; padding: 18rpx 0; text-align: center; }

.ai-intro { padding: 28rpx 0 34rpx; }
.ai-heading { font-size: 48rpx; color: #2e452f; }
.ai-kicker { color: #6e8861; }
.ai-orbit { opacity: .45; border-color: #d3dfc6; background: transparent; }
.orbit-inner { border-color: #c8d7b7; }
.orbit-point { background: #e8ad4b; box-shadow: none; }
.aibox { background: #ffffff; border-color: #e0e7dc; }
.ai-primary { background: #28744e; border-color: #28744e; color: #ffffff; }
.ai-outline { background: #eef4e9; border-color: #d4e3cc; color: #28744e; }
.photo-slot { background: #f7f9f2; border-color: #cbdac1; color: #486540; }
.ai-service-title { font-size: 35rpx; }

.food-entry-button { justify-content: center; padding: 18rpx 10rpx; min-height: 84rpx; margin-top: 0; font-size: 26rpx; }

.goal-photo-grid { grid-template-columns: 1fr; }
.goal-thumb { width: 100%; height: 280rpx; border-radius: 16rpx; display: block; margin-bottom: 12rpx; background: #eef4e9; }

.goal-result-box { padding-bottom: 24rpx; }
.goal-result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.goal-result-title { margin-bottom: 0; flex: 1; min-width: 0; }
.goal-result-desc { margin-top: 4rpx; color: #25352c; }
.goal-result-hint { margin-top: 6rpx; margin-bottom: 8rpx; font-size: 22rpx; }
.goal-node {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #e0e7dc;
}
.goal-node:last-of-type { border-bottom: none; padding-bottom: 8rpx; }
.goal-node-info { display: flex; flex-direction: column; gap: 8rpx; min-width: 0; }
.goal-node-title { font-size: 28rpx; color: #25352c; font-weight: 500; line-height: 1.4; }
.goal-node-status { font-size: 24rpx; color: #6e7c72; line-height: 1.4; }
.goal-node-wm { font-size: 20rpx; color: #9aa59b; line-height: 1.4; }
.goal-node-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  width: 100%;
}
.goal-action-btn {
  width: auto !important;
  min-width: 0;
  flex: 0 0 auto;
  margin: 0 !important;
  padding: 12rpx 22rpx;
  line-height: 1.3;
  font-size: 24rpx;
  color: #28744e;
  background: #f7f9f2;
  border: 1rpx solid #d4e3cc;
  border-radius: 12rpx;
  box-sizing: border-box;
}
.goal-action-btn::after { border: none; }
.goal-action-primary {
  background: #eef4e9;
  border-color: #28744e;
  color: #1f5c3d;
  font-weight: 500;
}

.goal-sheet-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 1000;
  background: rgba(24, 32, 28, 0.55);
  display: flex; align-items: flex-end; justify-content: center;
}
.goal-sheet {
  width: 100%; max-height: 86vh; overflow-y: auto;
  background: #1c2220; color: #f4f6f2;
  border-radius: 28rpx 28rpx 0 0;
  padding: 36rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.goal-sheet-title { font-size: 34rpx; font-weight: 500; letter-spacing: 1rpx; }
.goal-sheet-sub { margin-top: 10rpx; font-size: 22rpx; color: #9aa59b; line-height: 1.6; }
.goal-cfg-block { margin-top: 34rpx; }
.goal-cfg-label { font-size: 26rpx; color: #e8eee6; margin-bottom: 16rpx; }
.goal-cfg-option {
  display: flex; align-items: flex-start; gap: 14rpx;
  padding: 18rpx 4rpx; font-size: 25rpx; line-height: 1.55; color: #d7ddd4;
}
.goal-cfg-option radio { transform: scale(0.82); margin-top: 4rpx; }
.goal-sheet-actions { display: flex; gap: 16rpx; margin-top: 36rpx; }
.goal-sheet-btn { flex: 1; width: auto !important; }
.goal-sheet .secondary { background: transparent; border: 1rpx solid #3a4540; color: #c9d2c8; }
.goal-sheet .primary { background: #28744e; border: 1rpx solid #28744e; color: #fff; }
