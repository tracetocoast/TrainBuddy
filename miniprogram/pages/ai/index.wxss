/* TrainBuddy Precision Daylight · tools, result lists and native configuration panel. */
.ai-page { min-height:100vh;padding:0 32rpx calc(156rpx + env(safe-area-inset-bottom));background:var(--paper);color:var(--ink); }
.ai-brand { font-size:31rpx;font-weight:700; }
.ai-brand-detail { display:none; }
.ai-page-lead { margin-bottom:28rpx; }
.ai-services-label { display:flex;justify-content:space-between;align-items:baseline;gap:12rpx;margin:12rpx 0 18rpx;font-size:24rpx;font-weight:600;color:var(--muted); }
.ai-service-count { font-size:19rpx;flex:none; }
.tool-carousel { margin:0 -32rpx 8rpx; }
.tool-tabs { margin:0 32rpx 20rpx;padding:6rpx;border-radius:14rpx;background:var(--surface-raised);border:1rpx solid var(--line); }
.tool-tabs-inner { position:relative;display:flex;width:100%; }
.tool-tab-pill { position:absolute;top:0;left:0;width:33.333%;height:100%;border-radius:10rpx;background:#fff;transition:transform 200ms ease;pointer-events:none; }
.tool-tab { position:relative;z-index:1;flex:1;width:0 !important;min-height:44px;padding:14rpx 8rpx;border-radius:10rpx;background:transparent;display:flex;align-items:center;justify-content:center; }
.tool-tab-index { display:none; }
.tool-tab-label { font-size:26rpx;color:var(--muted);font-weight:500; }
.tool-tab-on .tool-tab-label { color:var(--ink);font-weight:700; }
.tool-tab-press { opacity:.75; }
.tool-swiper { width:100%; }
.tool-slide,.tool-slide-scroll { height:100%; }
.tool-slide-scroll { padding:0 8rpx; }
.tool-card { margin:0 6rpx 12rpx;min-height:0; }
.aibox { padding:30rpx;margin-bottom:22rpx;border:1rpx solid var(--line);border-radius:20rpx;background:#fff; }
.tool-card .photo-grid { margin:24rpx 0 12rpx; }
.tool-dots { display:flex;justify-content:center;align-items:center;gap:10rpx;padding:8rpx 0 18rpx; }
.tool-dot { width:10rpx;height:10rpx;border-radius:5rpx;background:#c8d1df; }
.tool-dot.on { width:28rpx;background:var(--accent); }
.row-between { display:flex;justify-content:space-between;align-items:center;gap:12rpx; }
.ai-section-number { color:var(--muted);font-size:18rpx;letter-spacing:2rpx;font-weight:600; }
.ai-badge { color:var(--accent);background:#edf1ff;padding:7rpx 12rpx;border-radius:6rpx;font-size:20rpx; }
.ai-service-title { font-size:38rpx;font-weight:750;line-height:1.3;margin:28rpx 0 14rpx;letter-spacing:-.5rpx; }
.ai-desc { color:var(--muted);font-size:25rpx;line-height:1.8; }
.photo-grid { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx;margin:28rpx 0; }
.photo-slot { width:100% !important;border:1rpx dashed #aebbd0;border-radius:14rpx;background:var(--paper);padding:26rpx 12rpx;color:var(--ink);text-align:center; }
.photo-slot[disabled] { opacity:.55; }
.photo-ready { border-style:solid;border-color:var(--accent);background:#edf1ff; }
.photo-frame { width:60rpx;height:78rpx;margin:0 auto 18rpx;border:1rpx solid var(--line);border-radius:8rpx;display:flex;align-items:center;justify-content:center;background:#fff; }
.photo-frame text { color:var(--accent);font-size:32rpx; }
.side-frame { width:48rpx; }
.photo-title { font-size:27rpx;font-weight:650;margin-bottom:8rpx; }
.photo-sub { font-size:22rpx;line-height:1.6;color:var(--muted); }
.ai-primary,.ai-outline { display:flex;align-items:center;justify-content:space-between;gap:16rpx;width:100% !important;min-height:48px;border-radius:14rpx;padding:20rpx 26rpx;font-size:27rpx;font-weight:650; }
.ai-primary { background:var(--accent);color:#fff; }
.ai-outline { margin-top:24rpx;background:#fff;border:1rpx solid var(--line);color:var(--accent); }
.ai-primary[disabled],.ai-outline[disabled] { background:#e8edf3;color:#69788b;border-color:var(--line); }
.ai-btn-press { opacity:.85; }
.ai-footnote { font-size:22rpx;line-height:1.8;color:var(--muted);margin-top:18rpx; }
.vision-timeline { display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin:28rpx 10rpx; }
.vision-month { display:block;color:var(--ink);font-size:48rpx;font-weight:750;font-variant-numeric:tabular-nums; }
.vision-caption { font-size:22rpx;color:var(--muted); }
.vision-line { flex:1;height:1rpx;background:var(--line); }
.ai-settings { padding:22rpx 24rpx;margin-bottom:22rpx;border:1rpx solid var(--line);border-radius:14rpx;background:#fff; }
.ai-settings-title { font-size:24rpx;color:var(--muted); }
.mode-group { display:flex;gap:16rpx; }
.mode-item { display:flex;align-items:center;font-size:24rpx;color:var(--ink); }
.mode-item radio { transform:scale(.8); }
.hint { margin-top:12rpx;color:var(--muted);font-size:22rpx;line-height:1.7; }
.ai-result-title { font-size:30rpx;font-weight:700;color:var(--ink);margin-bottom:12rpx; }
.ai-error { color:#b42332;font-size:24rpx;margin-top:12rpx; }
.item-row { display:flex;align-items:center;justify-content:space-between;gap:18rpx;padding:22rpx 0;border-bottom:1rpx solid var(--line);font-size:25rpx; }
.item-label { color:var(--muted); }
.item-val { color:var(--ink);text-align:right; }
.food-entry-button { justify-content:center;padding:18rpx 10rpx;margin-top:0;font-size:26rpx; }
.goal-photo-grid { grid-template-columns:1fr; }
.goal-thumb { width:100%;height:280rpx;border-radius:12rpx;display:block;margin-bottom:12rpx;background:var(--surface-raised); }
.goal-result-head { display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:8rpx; }
.goal-result-title { flex:1;min-width:0;margin-bottom:0; }
.goal-result-desc { color:var(--ink); }
.goal-result-hint { margin:6rpx 0 12rpx;font-size:22rpx; }
.goal-node { display:flex;flex-direction:column;gap:16rpx;padding:22rpx 0;border-bottom:1rpx solid var(--line); }
.goal-node-info { display:flex;flex-direction:column;gap:8rpx;min-width:0; }
.goal-node-title { color:var(--ink);font-size:28rpx;font-weight:650; }
.goal-node-status,.goal-node-wm { color:var(--muted);font-size:22rpx; }
.goal-node-actions { display:flex;flex-wrap:wrap;gap:12rpx;width:100%; }
.goal-action-btn { width:auto !important;min-height:44px;margin:0;padding:12rpx 20rpx;border:1rpx solid var(--line);border-radius:12rpx;background:#fff;color:var(--accent);font-size:24rpx; }
.goal-action-primary { background:#edf1ff;border-color:#b7c6f9; }
.ai-bottom-note { text-align:center;color:var(--muted);letter-spacing:4rpx;font-size:22rpx;padding:24rpx 0 12rpx; }
.linkish { width:100% !important;min-height:44px;color:var(--muted);font-size:22rpx;padding:18rpx 0;text-align:center; }
.goal-sheet-mask { position:fixed;inset:0;z-index:1000;background:rgba(23,32,43,.48);display:flex;align-items:flex-end;justify-content:center; }
.goal-sheet { width:100%;max-height:86vh;overflow-y:auto;background:#fff;color:var(--ink);border-radius:28rpx 28rpx 0 0;padding:16rpx 32rpx calc(28rpx + env(safe-area-inset-bottom)); }
.goal-sheet-enter { animation:aiSheetUp 280ms ease-out; }
.goal-sheet-handle { width:64rpx;height:8rpx;background:#c7d2e2;border-radius:4rpx;margin:4rpx auto 22rpx; }
.goal-sheet-title { font-size:34rpx;font-weight:700; }
.goal-sheet-sub { color:var(--muted);font-size:22rpx;margin-top:10rpx;line-height:1.7; }
.goal-cfg-block { margin-top:28rpx; }
.goal-cfg-label { color:var(--ink);font-size:26rpx;font-weight:650;margin-bottom:12rpx; }
.goal-cfg-option { display:flex;align-items:center;gap:14rpx;padding:14rpx 0;min-height:44px;font-size:25rpx;line-height:1.6;color:var(--ink); }
.goal-cfg-option radio { transform:scale(.85); }
.goal-sheet-actions { display:flex;gap:16rpx;margin-top:30rpx; }
.goal-sheet-btn { flex:1;width:0 !important;min-height:48px;border-radius:14rpx; }
@keyframes aiSheetUp { from { transform:translateY(32rpx);opacity:.5; } to { transform:translateY(0);opacity:1; } }
@media (prefers-reduced-motion:reduce) { .tool-tab-pill { transition:none; }.goal-sheet-enter { animation:none; } }