@import "../../styles/coach.wxss";

.profile-page {
  padding-bottom: 60rpx;
}

.profile-hero {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.profile-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: var(--ix-soft);
  color: var(--accent);
  font-size: 34rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.profile-hero-main {
  flex: 1;
  min-width: 0;
}

.section-block {
  margin-top: 28rpx;
}

.block-title {
  margin: 18rpx 0 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}

.profile-card {
  padding: 22rpx 20rpx;
  margin-bottom: 12rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
}

.profile-card.soft {
  background: var(--tint-1);
  color: var(--muted);
}

.profile-card.hidden {
  background: var(--surface-raised);
  border-style: dashed;
}

.profile-card.hidden .card-title {
  color: var(--muted);
}

.note-block {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: var(--ink);
  white-space: pre-wrap;
}

.prose-panel {
  padding: 20rpx;
  margin-bottom: 12rpx;
  background: var(--tint-1);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
}

.prose-field {
  min-height: 160rpx;
  background: var(--surface);
  line-height: 1.7;
}

.prose-card {
  background: var(--paper);
}

.save-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--deep-green);
}

.dates {
  white-space: nowrap;
  margin: 12rpx 0 18rpx;
  width: 100%;
}

.date-btn {
  position: relative;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 96rpx !important;
  min-width: 96rpx;
  min-height: 110rpx;
  margin-right: 10rpx !important;
  padding: 16rpx 8rpx 12rpx;
  border-radius: 18rpx;
  box-sizing: border-box;
}

.date-week {
  font-size: 20rpx;
}

.date-mark {
  position: absolute;
  top: 6rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 16rpx;
  color: var(--accent);
  font-weight: 600;
}

.date-btn.is-today:not(.chosen) {
  border-color: var(--green-strong);
  background: var(--mint-1);
  color: var(--deep-green);
}

.date-btn.chosen .date-mark {
  color: rgba(255, 255, 255, 0.92);
}

.date-pick {
  max-width: none;
  justify-content: flex-end;
  font-size: 22rpx;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.metric-card {
  padding: 18rpx 14rpx;
  border-radius: 20rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  min-width: 0;
}

.metric-card.is-empty {
  border-style: dashed;
  background: var(--paper);
}

.metric-label {
  display: block;
  font-size: 20rpx;
  color: var(--muted);
}

.metric-value-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  margin-top: 8rpx;
}

.metric-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  word-break: break-word;
}

.metric-card.is-empty .metric-value {
  color: var(--muted-2);
  font-weight: 400;
}

.metric-unit {
  font-size: 18rpx;
  color: var(--muted-2);
}

.metric-note {
  display: block;
  margin-top: 6rpx;
  font-size: 18rpx;
  color: var(--warm-ink);
}

.timeline-item {
  display: flex;
  gap: 12rpx;
}

.timeline-rail {
  width: 24rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 8rpx;
}

.timeline-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--accent);
  flex-shrink: 0;
}

.timeline-line {
  flex: 1;
  width: 2rpx;
  background: var(--line);
  margin-top: 6rpx;
  min-height: 20rpx;
}

.timeline-item:last-child .timeline-line {
  opacity: 0;
}

.timeline-body {
  flex: 1;
  min-width: 0;
  padding-bottom: 8rpx;
}

.timeline-date {
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
}

.health-toggle {
  margin: 20rpx 0 0;
  max-width: none;
}

@media (max-width: 360px) {
  .metric-grid {
    grid-template-columns: 1fr;
  }
}
