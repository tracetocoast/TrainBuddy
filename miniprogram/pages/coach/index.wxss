.space-caption { font-size: 22rpx; color: #7a8776; }
.coach-summary { display: flex; align-items: center; gap: 20rpx; background: #edf4e6; border: 1rpx solid #e0ead6; border-radius: 24rpx; padding: 26rpx; margin: 14rpx 0 28rpx; }
.coach-avatar { width: 76rpx; height: 76rpx; border-radius: 50%; background: #dfead4; color: #466941; display: flex; align-items: center; justify-content: center; font-size: 30rpx; flex: none; }
.coach-name { font-size: 31rpx; font-weight: 600; margin-bottom: 6rpx; }
.space-tabs { display: flex; gap: 6rpx; background: #f0f4eb; border-radius: 18rpx; padding: 5rpx; }
.space-tabs button { flex: 1; width: 0 !important; padding: 18rpx 4rpx; border-radius: 14rpx; color: #74806d; font-size: 26rpx; }.space-tabs button.on { background: #ffffff; color: #28744e; font-weight: 600; }
.section-intro { font-size: 23rpx; color: #7a8776; line-height: 1.8; margin: 24rpx 0; }
.session-card { border: 1rpx solid #e0e7dc; border-radius: 22rpx; background: #ffffff; margin-top: 20rpx; overflow: hidden; }
.session-head { width: 100% !important; display: flex; align-items: center; gap: 20rpx; padding: 26rpx; text-align: left; }.session-date { color: #809175; font-size: 22rpx; margin-bottom: 14rpx; }.expand-mark { color: #66845c; font-size: 32rpx; }
.coach-note { padding: 22rpx; margin: 0 24rpx 12rpx; border-radius: 16rpx; background: #f3f7ed; }.note-label { font-size: 23rpx; color: #6c875d; margin-bottom: 10rpx; }.note-text { font-size: 26rpx; color: #354932; line-height: 1.8; white-space: pre-wrap; overflow-wrap: anywhere; }
.session-exercise { padding: 24rpx; border-top: 1rpx solid #edf1e8; }.exercise-name { font-size: 27rpx; margin-bottom: 14rpx; font-weight: 500; }.session-set { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 6rpx; padding: 14rpx 0; font-size: 23rpx; color: #6e7c72; }.session-set text:last-child { text-align: right; }
.space-state,.space-empty { color: #71806b; font-size: 27rpx; text-align: center; padding: 64rpx 18rpx; }.space-empty view { font-size: 23rpx; line-height: 1.8; color: #899180; margin-top: 14rpx; }
.binding-empty,.booking-intro { padding: 50rpx 24rpx; }.empty-title { font-size: 35rpx; margin-bottom: 20rpx; font-weight: 500; }.binding-empty .primary,.booking-intro .primary { width: 100% !important; margin-top: 36rpx; }
.meal-toolbar { display: flex; justify-content: space-between; align-items: center; margin: 24rpx 0 16rpx; }.date-picker { padding: 16rpx 20rpx; border: 1rpx solid #e0e7dc; border-radius: 14rpx; font-size: 26rpx; background: #ffffff; }
.share-status { display: flex; justify-content: space-between; gap: 12rpx; align-items: center; font-size: 25rpx; margin: 16rpx 0 24rpx; }.share-status .sub { font-size: 22rpx; margin-top: 8rpx; }
.meal-card { padding: 24rpx; background: #ffffff; border: 1rpx solid #e0e7dc; border-radius: 20rpx; margin: 14rpx 0; }.meal-label { font-size: 22rpx; color: #8e763e; }.meal-food { font-size: 28rpx; margin-top: 12rpx; line-height: 1.6; overflow-wrap: anywhere; }.share-button { width: 100% !important; margin-top: 26rpx; }
.feedback-card { padding: 24rpx; border: 1rpx solid #dfe8d8; border-radius: 20rpx; background: #ffffff; margin-top: 18rpx; }.feedback-head { display: flex; flex-direction: column; gap: 8rpx; margin-bottom: 16rpx; font-size: 24rpx; color: #53764a; }.feedback-head text:last-child { color: #85907d; font-size: 21rpx; }
