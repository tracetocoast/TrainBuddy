<page-meta background-color="{{pageBg}}" />
<view class="page page-solo {{skinClass}}" wx:if="{{ex}}">
  <view class="eyebrow">EXERCISE · DETAIL</view>
  <image wx:if="{{ex.imageUrl}}" class="detail-photo" src="{{ex.imageUrl}}" mode="aspectFit" />
  <view class="title">{{ex.name}}</view>
  <view class="sub" wx:if="{{ex.nameEn && ex.nameEn !== ex.name}}">{{ex.nameEn}}</view>
  <view class="sub">{{ex.bodyPartLabel || ex.muscleGroup}} · {{ex.equipmentLabel || ex.equipment}}{{ex.targetLabel ? ' · ' + ex.targetLabel : ''}}{{ex.difficulty ? ' · ' + ex.difficulty : ''}}</view>

  <view class="head"><view class="head-title">步骤</view></view>
  <view class="card">
    <view class="sub" wx:for="{{ex.instructions}}" wx:key="*this">{{index + 1}}. {{item}}</view>
    <view class="sub" wx:if="{{!ex.instructions.length}}">暂无步骤说明。</view>
  </view>

  <view class="head" wx:if="{{ex.cues.length}}"><view class="head-title">关键要点</view></view>
  <view class="card" wx:if="{{ex.cues.length}}">
    <view class="sub" wx:for="{{ex.cues}}" wx:key="*this">· {{item}}</view>
  </view>

  <view class="head" wx:if="{{ex.commonErrors.length}}"><view class="head-title">常见错误</view></view>
  <view class="card" wx:if="{{ex.commonErrors.length}}">
    <view class="sub" wx:for="{{ex.commonErrors}}" wx:key="*this">· {{item}}</view>
  </view>

  <button class="secondary" style="width:100%;margin-top:16rpx" bindtap="onFav">
    {{ex.favorited ? '取消收藏' : '收藏动作'}}
  </button>
  <button class="primary" style="width:100%;margin-top:12rpx" bindtap="onAddPlan" disabled="{{adding}}">{{adding ? '加入中…' : '加入个人计划草稿 ↗'}}</button>
</view>
