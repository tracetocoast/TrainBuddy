.page-solo {
  padding-bottom: 60rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #e0e7dc;
  font-size: 26rpx;
}

.row:last-child {
  border-bottom: 0;
}

.k {
  color: #6e7c72;
}

.v {
  font-weight: 600;
}

.dates {
  white-space: nowrap;
  margin: 16rpx 0;
}

.date-btn {
  display: inline-flex;
  margin-right: 12rpx;
}
