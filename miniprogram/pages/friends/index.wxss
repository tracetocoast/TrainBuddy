.friends-page { padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); }.friends-heading { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.friend-manage { margin-top: 28rpx; padding: 26rpx; background: #ffffff; border: 1rpx solid var(--line); border-radius: 20rpx; }.consent-note { font-size: 23rpx; color: var(--muted); line-height: 1.9; margin: 14rpx 0 24rpx; }.friend-manage > .secondary,.preview-card .primary { width: 100% !important; }
.code-label { font-size: 25rpx; margin: 32rpx 0 16rpx; }.code-row { display: flex; gap: 12rpx; align-items: center; }.code-row input { width: 0; flex: 1; font-size: 24rpx; }.code-row button { width: auto !important; flex: none; }.invite-result { padding: 24rpx 0 4rpx; }.invite-result > view:first-child { color: var(--accent); font-size: 38rpx; letter-spacing: 5rpx; }.invite-result .sub { font-size: 21rpx; }.preview-card { border-top: 1rpx solid var(--line); margin-top: 24rpx; padding-top: 24rpx; }
.friend-state { text-align: center; color: var(--muted); padding: 50rpx 12rpx; font-size: 26rpx; line-height: 1.8; }.friend-state view { color: var(--muted); font-size: 23rpx; margin-top: 12rpx; }
.friend-selector { white-space: nowrap; margin-top: 28rpx; }.friend-chip { display: inline-flex; width: auto !important; padding: 16rpx 24rpx; margin-right: 12rpx !important; border: 1rpx solid var(--line); background: #ffffff; border-radius: 40rpx; color: var(--muted); font-size: 25rpx; }.friend-chip.on { background: #edf1ff; color: var(--accent); border-color: var(--line); }
.friend-week { padding: 26rpx; background: #edf1ff; border-radius: 20rpx; margin-top: 24rpx; }.week-title { font-size: 30rpx; }.week-title text { display: block; font-size: 23rpx; color: var(--muted); margin-top: 8rpx; }.week-days { display: grid; grid-template-columns: repeat(7,minmax(0,1fr)); gap: 8rpx; margin-top: 24rpx; text-align: center; }.week-days text { display: block; font-size: 21rpx; color: var(--muted); overflow: hidden; }.day-bar { margin-top: 12rpx; background: #e3ebdb; color: var(--muted); height: 48rpx; border-radius: 10rpx; display: flex; align-items: center; justify-content: center; font-size: 24rpx; }.day-bar.trained { background: var(--accent); color: #ffffff; }
.training-card { padding: 26rpx; border: 1rpx solid var(--line); border-radius: 20rpx; background: #ffffff; margin-top: 20rpx; }.training-date { color: var(--muted); font-size: 22rpx; margin-bottom: 12rpx; }.training-exercise { padding: 18rpx 0; border-bottom: 1rpx solid var(--surface-raised); font-size: 26rpx; }.training-exercise text { display: block; font-size: 23rpx; color: var(--muted); margin-top: 8rpx; line-height: 1.8; }
.comment { margin-top: 18rpx; padding: 20rpx; border-radius: 24rpx; background: #f5f8f0; font-size: 25rpx; line-height: 1.8; overflow-wrap: anywhere; white-space: pre-wrap; }.comment-author { color: var(--accent); font-size: 23rpx; margin-bottom: 8rpx; }.comment-author text { display: block; color: var(--muted); font-size: 20rpx; }.comment-field { margin-top: 24rpx; height: 130rpx !important; min-height: 130rpx !important; font-size: 24rpx; }.comment-send { width: 100% !important; padding: 16rpx; margin-top: 12rpx; border-radius: 999rpx; background: #edf1ff; color: var(--accent); font-size: 25rpx; }.comment-send[disabled] { color: var(--muted); }
.remove-friend { width: 100% !important; padding: 30rpx 0; color: #8d877a; font-size: 23rpx; margin-top: 30rpx; }
.code-row > .secondary { width: 110rpx !important; min-width: 110rpx; padding: 16rpx 12rpx; }
.code-row input { min-width: 0; }
