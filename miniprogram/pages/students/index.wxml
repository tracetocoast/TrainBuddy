<view class="page">
  <view class="top">
    <view class="brand">
      <brand-logo class="brand-emblem-slot" />练搭子
      <text class="brand-sub">TRAIN BUDDY</text>
    </view>
  </view>

  <role-switcher />

  <view class="eyebrow">YOUR PEOPLE · COACH CRM</view>
  <view class="title">学员管理</view>
  <view class="sub">查看训练执行、历史记录与下一轮计划。</view>
  <view class="ui-state" wx:if="{{loading}}">正在同步学员…</view>
  <view class="ui-state ui-state-error" wx:if="{{error}}">{{error}}<button class="link" bindtap="reload">重试加载</button></view>

  <input
    class="field"
    placeholder="搜索已绑定学员姓名…"
    value="{{keyword}}"
    bindinput="onSearch"
  />

  <view
    class="card flex"
    wx:for="{{filtered}}"
    wx:key="studentId"
    data-id="{{item.studentId}}"
    data-name="{{item.name}}"
    bindtap="onOpenStudent"
  >
    <view class="ico">{{item.avatar}}</view>
    <view class="grow">
      <view class="card-title">{{item.name}}</view>
      <view class="sub">{{item.desc}}</view>
    </view>
    <text class="tag">打开</text>
  </view>
  <view class="card sub" wx:if="{{!loading && !error && !filtered.length}}">暂无绑定学员。请生成邀请码让学员绑定。</view>

  <view class="diagnostic-tools"><button class="link" bindtap="onToggleDiagnostics">开发诊断与演示 {{showDiagnostics ? '收起' : '展开'}}</button><block wx:if="{{showDiagnostics}}">
  <view class="head">
    <view class="head-title">绑定权限检查</view>
    <text class="tag">未绑定不可见</text>
  </view>
  <input
    class="field"
    placeholder="输入未绑定学员 ID，如 u_stu_unbound_999"
    value="{{probeId}}"
    bindinput="onProbeInput"
  />
  <button class="secondary" style="width:100%;margin-top:16rpx" bindtap="onProbe">尝试访问</button>
  <view class="card sub" wx:if="{{probeResult}}">{{probeResult}}</view>

  <view class="head">
    <view class="head-title">待跟进</view>
    <text class="tag">示意</text>
  </view>
  <view class="card flex">
    <view class="ico">♡</view>
    <view class="grow">
      <view class="card-title">未授权时显示「记录不可见」</view>
      <view class="sub">不能把「看不到」当成「没运动」。</view>
    </view>
    <button class="link" bindtap="onContact">联系</button>
  </view>
  </block></view>
</view>

<bottom-nav active="students" />
