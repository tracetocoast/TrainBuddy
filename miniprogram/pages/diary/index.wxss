/* 每日记录 · 摘要 + Accordion */

.diary-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.diary-hero {
  padding: 8rpx 4rpx 8rpx;
}

.diary-kicker {
  font-size: 18rpx;
  letter-spacing: 3rpx;
  color: var(--deep-green);
}

.diary-title {
  margin-top: 14rpx;
  font-size: 44rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.diary-lead {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: var(--muted);
}

.diary-load-error {
  margin: 12rpx 0;
  padding: 18rpx 20rpx;
  border-radius: 6rpx;
  background: var(--rose-tint);
  border: 1rpx solid var(--rose-line);
  color: var(--danger);
  font-size: 24rpx;
  line-height: 1.55;
}

/* 日期条 */
.diary-dates {
  width: 100%;
  margin: 28rpx 0 8rpx;
}

.diary-dates-inner {
  display: inline-flex;
  gap: 12rpx;
  padding: 4rpx 2rpx 12rpx;
}

.date-chip {
  width: 92rpx !important;
  min-width: 92rpx;
  padding: 16rpx 0;
  margin: 0 !important;
  border-radius: 6rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  transition: transform 0.2s cubic-bezier(0.34, 1.4, 0.64, 1), background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

.date-chip-press {
  transform: scale(0.94);
  opacity: 0.9;
}

.date-chip-on {
  background: var(--green-soft);
  border-color: var(--green-strong);
  box-shadow: none;
  transform: translateY(-2rpx);
}

.date-week {
  font-size: 20rpx;
  color: var(--muted);
}

.date-chip-on .date-week {
  color: var(--deep-green);
}

.date-day {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.1;
}

/* 当天摘要 */
.diary-summary {
  padding: 24rpx;
  margin: 12rpx 0 18rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 6rpx;
  box-shadow: none;
}

.diary-summary-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.diary-summary-date {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.diary-daybar-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  justify-content: flex-end;
}

.diary-pill {
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  background: var(--surface-raised);
  color: var(--deep-green);
}

.diary-pill.soft {
  background: var(--tint-1);
  color: var(--muted);
}

.diary-pill-rest {
  background: var(--warm-tint);
  color: var(--warm-ink);
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 20rpx;
}

.summary-cell {
  padding: 16rpx 10rpx;
  border-radius: 6rpx;
  background: var(--tint-1);
  border: 1rpx solid var(--tint-2);
  text-align: center;
}

.summary-label {
  display: block;
  font-size: 20rpx;
  color: var(--muted);
}

.summary-value {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.25;
}

.summary-value.is-empty {
  color: var(--muted-2);
  font-weight: 400;
}

.diary-summary-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 18rpx;
}

.summary-coach {
  font-size: 22rpx;
  color: var(--muted);
  min-width: 0;
}

.diary-rest-btn {
  flex-shrink: 0;
  width: auto !important;
  margin: 0 !important;
  padding: 12rpx 20rpx;
  font-size: 22rpx;
  color: var(--accent);
  background: var(--ix-soft);
  border: 1rpx solid var(--green-strong);
  border-radius: 6rpx;
  transition: transform 0.18s cubic-bezier(0.34, 1.4, 0.64, 1);
}

.diary-rest-btn[disabled] {
  opacity: 0.45;
}

/* Accordion */
.acc {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.acc-item {
  overflow: hidden;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 6rpx;
  transition:
    transform 0.32s cubic-bezier(0.34, 1.35, 0.64, 1),
    box-shadow 0.32s ease,
    border-color 0.24s ease;
}

.acc-item.acc-open {
  box-shadow: none;
  border-color: var(--green-strong);
  transform: translateY(-2rpx);
}

.acc-filled:not(.acc-open) .acc-icon {
  background: var(--mint-3);
}

.acc-trigger {
  width: 100% !important;
  margin: 0 !important;
  padding: 26rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  text-align: left;
  background: transparent;
  border: none;
  transition: transform 0.18s cubic-bezier(0.34, 1.4, 0.64, 1);
}

.acc-trigger::after {
  border: none;
}

.acc-trigger-press {
  transform: scale(0.985);
  opacity: 0.92;
}

.acc-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 6rpx;
  background: var(--ix-soft);
  color: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  flex-shrink: 0;
  transition: background 0.22s ease, color 0.22s ease;
}

.acc-open .acc-icon {
  background: var(--accent);
  color: var(--on-accent);
}

.acc-trigger-main {
  flex: 1;
  min-width: 0;
}

.acc-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.acc-title {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
}

.acc-badge {
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: var(--ix-soft);
  color: var(--accent);
  border: 1rpx solid var(--green-strong);
}

.acc-hint {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.acc-chevron {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--tint-1);
  color: var(--muted);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  flex-shrink: 0;
  transition: transform 0.36s cubic-bezier(0.34, 1.4, 0.64, 1), background 0.2s ease, color 0.2s ease;
}

.acc-chevron-on {
  transform: rotate(180deg);
  background: var(--green-soft);
  color: var(--accent);
}

.acc-panel {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transition:
    max-height 0.4s cubic-bezier(0.34, 1.15, 0.64, 1),
    opacity 0.2s ease;
}

.acc-panel-on {
  max-height: 3200rpx;
  opacity: 1;
}

.acc-panel-inner {
  padding: 0 24rpx 28rpx;
}

/* 长文本区 */
.prose-card,
.prose-block {
  padding: 22rpx 20rpx;
  background: var(--tint-1);
  border: 1rpx solid var(--line);
  border-radius: 6rpx;
}

.prose-card {
  margin-bottom: 12rpx;
}

.prose-card:last-child {
  margin-bottom: 0;
}

.prose-textarea {
  margin-top: 8rpx;
  background: var(--surface);
  min-height: 160rpx;
  line-height: 1.75;
}

.coach-note-head {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: 12rpx;
}

.coach-note-who {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--deep-green);
}

.coach-note-meta {
  font-size: 21rpx;
  color: var(--muted);
}

.coach-note-text {
  font-size: 26rpx;
  line-height: 1.75;
  color: var(--ink);
  white-space: pre-wrap;
}

.coach-note-text.muted {
  color: var(--muted-2);
}

.diary-empty {
  padding: 28rpx 16rpx;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--muted-2);
  background: var(--paper);
  border-radius: 6rpx;
  border: 1rpx dashed var(--line);
}

.diary-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.diary-item {
  padding: 20rpx 18rpx;
  background: var(--tint-1);
  border-radius: 6rpx;
  border: 1rpx solid var(--tint-2);
}

/* 饮食卡片 */
.meal-card {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 16rpx;
  background: var(--tint-1);
  border-radius: 6rpx;
  border: 1rpx solid var(--tint-2);
}

.meal-photo {
  width: 112rpx;
  height: 112rpx;
  border-radius: 6rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--ix-soft);
}

.meal-photo image {
  width: 100%;
  height: 100%;
}

.meal-photo-empty,
.meal-photo-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: repeating-linear-gradient(
    -45deg,
    var(--ix-soft),
    var(--ix-soft) 8rpx,
    var(--tint-1) 8rpx,
    var(--tint-1) 16rpx
  );
}

.meal-photo-mark {
  font-size: 20rpx;
  color: var(--muted-2);
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  background: var(--glass-2);
}

.meal-body {
  flex: 1;
  min-width: 0;
}

.meal-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meal-method-note {
  margin-bottom: 16rpx;
  font-size: 23rpx;
  line-height: 1.65;
  color: var(--muted);
}

.meal-source {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.meal-source.is-photo {
  color: var(--warm-ink);
  background: var(--warm-tint);
}

.meal-source.is-hand {
  color: var(--muted);
  background: var(--tint-2);
}

.meal-hand-label {
  margin: 22rpx 0 10rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.meal-hand-btn {
  width: 100% !important;
  flex: none;
  margin-top: 16rpx !important;
}

.meal-macros {
  display: flex;
  gap: 8rpx;
  margin-top: 12rpx;
  flex-wrap: wrap;
}

.meal-macro {
  min-width: 84rpx;
  padding: 8rpx 10rpx;
  border-radius: 6rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
}

.meal-macro.kind-unknown {
  border-style: dashed;
}

.meal-macro.kind-value {
  border-color: var(--green-strong);
}

.meal-macro-name {
  display: block;
  font-size: 18rpx;
  color: var(--muted);
}

.meal-macro-val {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--ink);
}

.meal-macro.kind-unknown .meal-macro-val {
  color: var(--muted-2);
  font-weight: 400;
}

.meal-macro-val text {
  font-size: 18rpx;
  margin-left: 2rpx;
  color: var(--muted-2);
  font-weight: 400;
}

.diary-session-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.diary-item-title {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--ink);
  line-height: 1.4;
}

.diary-session-row .diary-item-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.diary-item-sets {
  flex: none;
  color: var(--muted);
  font-size: 25rpx;
  font-variant-numeric: tabular-nums;
}

.diary-item-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--muted);
  line-height: 1.55;
}

.diary-item-meta {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--muted-2);
}

.diary-text-btn {
  flex-shrink: 0;
  width: auto !important;
  margin: 0 !important;
  padding: 8rpx 4rpx;
  font-size: 23rpx;
  color: var(--warm-ink);
  background: transparent;
}

.diary-composer {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--tint-2);
}

.diary-input {
  width: 100%;
  min-height: 80rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  background: var(--tint-2);
  border-radius: 6rpx;
  font-size: 26rpx;
  color: var(--ink);
}

.diary-textarea {
  width: 100%;
  min-height: 140rpx;
  margin-top: 8rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  background: var(--tint-2);
  border-radius: 6rpx;
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.6;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 14rpx 0 4rpx;
}

.chip {
  width: auto !important;
  margin: 0 !important;
  padding: 12rpx 20rpx;
  border-radius: 6rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  font-size: 23rpx;
  color: var(--muted);
  transition: transform 0.15s ease, background 0.2s ease, border-color 0.2s ease;
}

.chip.on {
  background: var(--green-soft);
  border-color: var(--green-strong);
  color: var(--ink);
  font-weight: 500;
}

.chip[disabled] {
  opacity: 0.45;
}

.chip-press {
  transform: scale(0.96);
}

.form-field {
  width: calc(50% - 8rpx);
}

.form-field.full {
  width: 100%;
}

.form-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

/* 身体指标卡 */
.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.metric-card {
  padding: 20rpx 18rpx;
  border-radius: 6rpx;
  background: var(--tint-1);
  border: 1rpx solid var(--line);
}

.metric-label {
  display: block;
  font-size: 22rpx;
  color: var(--muted);
}

.metric-value-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 10rpx;
}

.metric-input {
  flex: 1;
  min-width: 0;
  font-size: 40rpx;
  font-weight: 500;
  color: var(--ink);
  height: 56rpx;
  line-height: 56rpx;
}

.metric-big {
  font-size: 40rpx;
  font-weight: 500;
  color: var(--ink);
  line-height: 1.1;
}

.metric-big.is-empty {
  color: var(--muted-2);
  font-weight: 400;
}

.metric-unit {
  font-size: 22rpx;
  color: var(--muted-2);
  flex-shrink: 0;
}

.fatigue-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}

.fatigue-chip {
  width: 56rpx !important;
  height: 56rpx;
  margin: 0 !important;
  padding: 0;
  border-radius: 6rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  font-size: 22rpx;
  color: var(--muted);
  display: flex;
  align-items: center;
  justify-content: center;
}

.fatigue-chip.on {
  background: var(--accent);
  border-color: var(--accent);
  color: var(--on-accent);
  font-weight: 600;
}

.metric-soreness {
  margin-top: 16rpx;
}

/* 饮水 */
.water-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.water-nums {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 6rpx;
}

.water-current {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1;
}

.water-unit,
.water-sep,
.water-goal {
  font-size: 24rpx;
  color: var(--muted);
}

.water-pct {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--accent);
}

.water-track {
  height: 18rpx;
  border-radius: 6rpx;
  background: var(--tint-2);
  overflow: hidden;
}

.water-fill {
  height: 100%;
  border-radius: 6rpx;
  background: var(--surface-raised);
  transition: width 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  min-width: 0;
}

.water-fill.water-pulse {
  animation: water-glow 0.7s ease;
}

@keyframes water-glow {
  0%,
  100% {
    filter: brightness(1);
  }
  50% {
    filter: brightness(1.08);
  }
}

.water-hint {
  margin: 12rpx 0 4rpx;
}

.water-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.water-input {
  width: 180rpx;
  min-height: 80rpx;
  padding: 16rpx;
  text-align: center;
  background: var(--tint-2);
  border-radius: 6rpx;
  font-size: 28rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.water-add {
  flex: 1;
  margin-top: 0 !important;
}

/* 保存态 */
.save-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--muted);
}

.save-hint.state-dirty {
  color: var(--warm-ink);
}

.save-hint.state-saving {
  color: var(--muted);
}

.save-hint.state-saved {
  color: var(--deep-green);
}

.save-hint.state-error {
  color: var(--danger);
}

.diary-primary {
  width: 100% !important;
  margin: 16rpx 0 0 !important;
  min-height: 84rpx;
  padding: 20rpx 24rpx;
  border-radius: 6rpx;
  background: var(--accent);
  border: 1rpx solid var(--accent);
  color: var(--on-accent);
  font-size: 27rpx;
  font-weight: 500;
  text-align: center;
  box-shadow: none;
  transition: transform 0.18s cubic-bezier(0.34, 1.4, 0.64, 1);
}

.diary-primary[disabled] {
  opacity: 0.55;
  box-shadow: none;
}

.diary-share-row {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.diary-ghost {
  flex: 1;
  width: auto !important;
  margin: 0 !important;
  min-height: 76rpx;
  padding: 18rpx 12rpx;
  border-radius: 6rpx;
  background: var(--surface);
  border: 1rpx solid var(--green-strong);
  color: var(--accent);
  font-size: 24rpx;
  text-align: center;
  transition: transform 0.18s cubic-bezier(0.34, 1.4, 0.64, 1);
}

.diary-btn-press {
  transform: scale(0.97);
  opacity: 0.92;
}

.diary-motion {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 8rpx 0 24rpx;
  padding: 18rpx 4rpx;
  font-size: 23rpx;
  color: var(--muted);
}

.diary-motion switch {
  transform: scale(0.78);
  transform-origin: right center;
}

.ui-reduced .acc-item,
.ui-reduced .acc-chevron,
.ui-reduced .acc-panel,
.ui-reduced .acc-icon,
.ui-reduced .date-chip,
.ui-reduced .water-fill,
.ix-reduced .acc-item,
.ix-reduced .acc-chevron,
.ix-reduced .acc-panel,
.ix-reduced .acc-icon,
.ix-reduced .date-chip,
.ix-reduced .water-fill {
  transition: none !important;
  animation: none !important;
}

@media (prefers-reduced-motion: reduce) {
  .acc-item,
  .acc-chevron,
  .acc-panel,
  .acc-icon,
  .date-chip,
  .water-fill,
  .chip,
  .diary-primary,
  .diary-ghost,
  .diary-rest-btn {
    transition: none !important;
    animation: none !important;
  }
}
