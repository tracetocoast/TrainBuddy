.page-solo {
  padding-bottom: 60rpx;
}

.dates {
  white-space: nowrap;
  margin: 20rpx 0;
}

.date-btn {
  display: inline-flex;
  margin-right: 12rpx;
}

.quick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
  align-items: center;
}

.chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: var(--surface);
  border: 2rpx solid #304351;
  font-size: 22rpx;
  font-weight: 700;
  color: #91a6b6;
}

.chip.on {
  background: #28465b;
  border-color: #52718a;
  color: #e4edf3;
}

.grow-input {
  flex: 1;
}

.aset-line {
  display: flex;
  gap: 12rpx;
  align-items: center;
  margin-top: 12rpx;
}

.mini-field {
  width: 160rpx;
  padding: 12rpx;
  background: #172735;
  border-radius: 12rpx;
  text-align: center;
}
