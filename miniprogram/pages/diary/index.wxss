.page-solo {
  padding-bottom: 60rpx;
}

.dates {
  white-space: nowrap;
  margin: 20rpx 0;
}

.date-btn {
  display: inline-flex;
  margin-right: 12rpx;
}

.quick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
  align-items: center;
}

.chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 2rpx solid #e4e7dd;
  font-size: 22rpx;
  font-weight: 700;
  color: #74796d;
}

.chip.on {
  background: #c8ff36;
  border-color: #c8ff36;
  color: #151812;
}

.grow-input {
  flex: 1;
}

.aset-line {
  display: flex;
  gap: 12rpx;
  align-items: center;
  margin-top: 12rpx;
}

.mini-field {
  width: 160rpx;
  padding: 12rpx;
  background: #f2f4ed;
  border-radius: 12rpx;
  text-align: center;
}
