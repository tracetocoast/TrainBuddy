.page-solo {
  padding-bottom: 60rpx;
}

.dates {
  white-space: nowrap;
  margin: 20rpx 0;
}

.date-btn {
  display: inline-flex;
  margin-right: 12rpx;
}

.quick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
  align-items: center;
}

.chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: var(--surface);
  border: 2rpx solid #e0e7dc;
  font-size: 22rpx;
  font-weight: 600;
  color: #6e7c72;
}

.chip.on {
  background: #e6f0e4;
  border-color: #a5c5a7;
  color: #25352c;
}

.grow-input {
  flex: 1;
}

.aset-line {
  display: flex;
  gap: 12rpx;
  align-items: center;
  margin-top: 12rpx;
}

.mini-field {
  width: 160rpx;
  padding: 12rpx;
  background: #f1f4ee;
  border-radius: 12rpx;
  text-align: center;
}
