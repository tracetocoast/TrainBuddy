<view class="page page-solo">
  <view class="eyebrow">DAILY LOG · S07</view>
  <view class="title">每日记录</view>
  <view class="sub">饮食 / 饮水 / 状态 / 特殊情况分开保存。共享按类别授权。</view>

  <scroll-view class="dates" scroll-x>
    <button
      wx:for="{{dateList}}"
      wx:key="dateKey"
      class="date-btn {{localDate === item.dateKey ? 'chosen' : ''}}"
      data-key="{{item.dateKey}}"
      bindtap="onPickDate"
    >{{item.weekday}}<b>{{item.day}}</b></button>
  </scroll-view>

  <view class="card flex" wx:if="{{view}}">
    <view class="grow">
      <view class="card-title">{{localDate}} {{view.restDay ? '· 休息日' : ''}}</view>
      <view class="sub">{{view.canEdit ? '可编辑' : '超出补录窗口'}}</view>
    </view>
    <button class="secondary" bindtap="onToggleRest" disabled="{{!view.canEdit}}">
      {{view.restDay ? '取消休息' : '记为休息'}}
    </button>
  </view>

  <!-- 训练自动关联 -->
  <view class="head"><view class="head-title">当天训练</view></view>
  <view class="card" wx:for="{{view.sessions}}" wx:key="id">
    <view class="card-title">{{item.title}}</view>
    <view class="sub">已完成 {{item.doneSets}} 组 · 自动关联</view>
  </view>
  <view class="card sub" wx:if="{{view && !view.sessions.length}}">当日暂无完成训练</view>

  <!-- 饮食 -->
  <view class="head">
    <view class="head-title">饮食</view>
    <text class="tag">{{view.shares.meal ? '已共享' : '未共享'}}</text>
  </view>
  <view class="card" wx:for="{{view.meals}}" wx:key="id">
    <view class="card-title">{{item.mealTypeLabel}} · {{item.foodText}}</view>
    <view class="sub">{{item.portionText || '份量未填'}}</view>
    <button class="link" data-id="{{item.id}}" bindtap="onDelMeal" wx:if="{{view.canEdit}}">删除</button>
  </view>
  <view class="quick-row" wx:if="{{view.canEdit}}">
    <input class="field grow-input" placeholder="食物描述" value="{{mealText}}" bindinput="onMealText" />
  </view>
  <view class="quick-row" wx:if="{{view.canEdit}}">
    <button class="chip {{mealType === item.key ? 'on' : ''}}" wx:for="{{mealTypes}}" wx:key="key" data-k="{{item.key}}" bindtap="onMealType">{{item.label}}</button>
  </view>
  <button class="secondary" style="width:100%;margin-top:8rpx" bindtap="onAddMeal" wx:if="{{view.canEdit}}">添加饮食</button>
  <view class="twobtn" style="margin-top:12rpx">
    <button class="secondary" bindtap="onShare" data-cat="meal">共享饮食</button>
    <button class="secondary" bindtap="onRevoke" data-cat="meal">撤回饮食</button>
  </view>

  <!-- 饮水 -->
  <view class="head"><view class="head-title">饮水</view></view>
  <view class="card">
    <view class="card-title">今日合计 {{view.waterTotalMl || 0}} ml</view>
    <view class="sub">仅支持分次累加，避免重复计</view>
    <view class="aset-line" wx:if="{{view.canEdit}}">
      <input class="mini-field" type="number" placeholder="ml" value="{{waterMl}}" bindinput="onWaterInput" />
      <button class="primary" bindtap="onAddWater">＋ 加水</button>
    </view>
  </view>

  <!-- 身体状态 -->
  <view class="head">
    <view class="head-title">身体状态</view>
    <text class="tag">{{view.shares.body_state ? '已共享' : '未共享'}}</text>
  </view>
  <view class="card">
    <view class="sub">睡眠（小时）</view>
    <input class="field" type="digit" value="{{sleepHours}}" bindinput="onSleep" disabled="{{!view.canEdit}}" />
    <view class="sub" style="margin-top:12rpx">疲劳 1–10（未填≠良好）</view>
    <input class="field" type="number" value="{{fatigue}}" bindinput="onFatigue" disabled="{{!view.canEdit}}" />
    <view class="sub" style="margin-top:12rpx">酸痛部位</view>
    <input class="field" value="{{soreness}}" bindinput="onSoreness" disabled="{{!view.canEdit}}" />
    <button class="secondary" style="width:100%;margin-top:12rpx" bindtap="onSaveBody" wx:if="{{view.canEdit}}">保存状态</button>
  </view>
  <view class="twobtn">
    <button class="secondary" bindtap="onShare" data-cat="body_state">共享状态</button>
    <button class="secondary" bindtap="onRevoke" data-cat="body_state">撤回状态</button>
  </view>

  <!-- 特殊情况 -->
  <view class="head">
    <view class="head-title">特殊情况</view>
    <text class="tag">{{view.shares.special ? '已共享' : '默认私密'}}</text>
  </view>
  <view class="quick-row">
    <button class="chip {{specialType === item.key ? 'on' : ''}}" wx:for="{{specialTypes}}" wx:key="key" data-k="{{item.key}}" bindtap="onSpecialType" disabled="{{!view.canEdit}}">{{item.label}}</button>
  </view>
  <textarea class="field" placeholder="可选描述，不强制填写" value="{{specialNote}}" bindinput="onSpecialNote" disabled="{{!view.canEdit}}" />
  <button class="secondary" style="width:100%;margin-top:12rpx" bindtap="onSaveSpecial" wx:if="{{view.canEdit}}">保存特殊情况</button>
  <view class="twobtn">
    <button class="secondary" bindtap="onShare" data-cat="special">共享特殊情况</button>
    <button class="secondary" bindtap="onRevoke" data-cat="special">撤回</button>
  </view>

  <view class="twobtn" style="margin-top:24rpx">
    <button class="secondary" bindtap="onShare" data-cat="workout_self">共享当日训练</button>
    <button class="secondary" bindtap="onRevoke" data-cat="workout_self">撤回训练共享</button>
  </view>
</view>
