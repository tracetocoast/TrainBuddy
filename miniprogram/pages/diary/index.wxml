<view class="page page-solo diary-page">
  <view class="diary-hero diary-enter" style="animation-delay: 0ms">
    <view class="diary-kicker">DAILY LOG</view>
    <view class="diary-title">每日记录</view>
    <view class="diary-lead">饮食、饮水、状态与特殊情况分开保存；共享按类别授权给教练。</view>
  </view>

  <scroll-view class="diary-dates diary-enter" style="animation-delay: 60ms" scroll-x enable-flex show-scrollbar="{{false}}">
    <view class="diary-dates-inner">
      <button
        wx:for="{{dateList}}"
        wx:key="dateKey"
        class="date-chip {{localDate === item.dateKey ? 'date-chip-on' : ''}}"
        data-key="{{item.dateKey}}"
        bindtap="onPickDate"
        hover-class="date-chip-press"
      >
        <text class="date-week">{{item.weekday}}</text>
        <text class="date-day">{{item.day}}</text>
      </button>
    </view>
  </scroll-view>

  <block wx:for="{{[enterTick]}}" wx:key="*this">
  <view class="diary-daybar diary-enter" style="animation-delay: 100ms" wx:if="{{view}}">
    <view class="diary-daybar-main">
      <view class="diary-daybar-date">{{localDate}}</view>
      <view class="diary-daybar-meta">
        <text class="diary-pill {{view.restDay ? 'diary-pill-rest' : ''}}">{{view.restDay ? '休息日' : '训练日'}}</text>
        <text class="diary-pill soft">{{view.canEdit ? '可编辑' : '补录已关闭'}}</text>
      </view>
    </view>
    <button
      class="diary-rest-btn"
      bindtap="onToggleRest"
      disabled="{{!view.canEdit}}"
      hover-class="diary-btn-press"
    >{{view.restDay ? '取消休息' : '记为休息'}}</button>
  </view>

  <!-- 当天训练 -->
  <view class="diary-section diary-enter" style="animation-delay: 140ms">
    <view class="diary-section-head">
      <view class="diary-section-title">当天训练</view>
      <text class="diary-section-count">{{view.sessions.length || 0}}</text>
    </view>
    <view class="diary-empty" wx:if="{{view && !view.sessions.length}}">当日暂无完成训练</view>
    <view class="diary-list" wx:else>
      <view class="diary-item" wx:for="{{view.sessions}}" wx:key="id">
        <view class="diary-item-title">{{item.title}}</view>
        <view class="diary-item-sub">已完成 {{item.doneSets}} 组 · 自动关联</view>
      </view>
    </view>
  </view>

  <!-- 饮食 -->
  <view class="diary-section diary-enter" style="animation-delay: 180ms">
    <view class="diary-section-head">
      <view class="diary-section-title">饮食</view>
      <text class="diary-share-tag {{view.shares.meal ? 'on' : ''}}">{{view.shares.meal ? '已共享' : '未共享'}}</text>
    </view>

    <view class="diary-empty" wx:if="{{view && !view.meals.length}}">还没有饮食记录</view>
    <view class="diary-list" wx:else>
      <view class="diary-item meal-item" wx:for="{{view.meals}}" wx:key="id">
        <view class="diary-item-body">
          <view class="diary-item-title">{{item.mealTypeLabel}}</view>
          <view class="diary-item-sub">{{item.foodText}}</view>
          <view class="diary-item-meta">{{item.portionText || '份量未填'}}</view>
        </view>
        <button
          class="diary-text-btn"
          data-id="{{item.id}}"
          bindtap="onDelMeal"
          wx:if="{{view.canEdit}}"
          hover-class="diary-btn-press"
        >删除</button>
      </view>
    </view>

    <view class="diary-composer" wx:if="{{view.canEdit}}">
      <input class="diary-input" placeholder="食物描述，例如：鸡胸肉沙拉" value="{{mealText}}" bindinput="onMealText" />
      <view class="chip-row">
        <button
          class="chip {{mealType === item.key ? 'on' : ''}}"
          wx:for="{{mealTypes}}"
          wx:key="key"
          data-k="{{item.key}}"
          bindtap="onMealType"
          hover-class="chip-press"
        >{{item.label}}</button>
      </view>
      <button class="diary-primary" bindtap="onAddMeal" hover-class="diary-btn-press">添加饮食</button>
    </view>

    <view class="diary-share-row">
      <button class="diary-ghost" bindtap="onShare" data-cat="meal" hover-class="diary-btn-press">共享饮食</button>
      <button class="diary-ghost" bindtap="onRevoke" data-cat="meal" hover-class="diary-btn-press">撤回饮食</button>
    </view>
  </view>

  <!-- 饮水 -->
  <view class="diary-section diary-enter" style="animation-delay: 220ms">
    <view class="diary-section-head">
      <view class="diary-section-title">饮水</view>
      <text class="diary-section-count">{{view.waterTotalMl || 0}} ml</text>
    </view>
    <view class="water-track">
      <view class="water-fill {{waterPulse ? 'water-pulse' : ''}}" style="width: {{waterPercent}}%;"></view>
    </view>
    <view class="diary-item-sub water-hint">分次累加，避免重复计 · 进度按 2000ml 参考</view>
    <view class="water-row" wx:if="{{view.canEdit}}">
      <input class="water-input" type="number" placeholder="ml" value="{{waterMl}}" bindinput="onWaterInput" />
      <button class="diary-primary water-add" bindtap="onAddWater" hover-class="diary-btn-press">＋ 加水</button>
    </view>
  </view>

  <!-- 身体状态 -->
  <view class="diary-section diary-enter" style="animation-delay: 260ms">
    <view class="diary-section-head">
      <view class="diary-section-title">身体状态</view>
      <text class="diary-share-tag {{view.shares.body_state ? 'on' : ''}}">{{view.shares.body_state ? '已共享' : '未共享'}}</text>
    </view>
    <view class="form-grid">
      <view class="form-field">
        <text class="form-label">睡眠（小时）</text>
        <input class="diary-input" type="digit" value="{{sleepHours}}" bindinput="onSleep" disabled="{{!view.canEdit}}" placeholder="例如 7.5" />
      </view>
      <view class="form-field">
        <text class="form-label">疲劳 1–10（未填≠良好）</text>
        <input class="diary-input" type="number" value="{{fatigue}}" bindinput="onFatigue" disabled="{{!view.canEdit}}" placeholder="1–10" />
      </view>
      <view class="form-field full">
        <text class="form-label">酸痛部位</text>
        <input class="diary-input" value="{{soreness}}" bindinput="onSoreness" disabled="{{!view.canEdit}}" placeholder="例如：右侧股四头" />
      </view>
    </view>
    <button class="diary-primary" bindtap="onSaveBody" wx:if="{{view.canEdit}}" hover-class="diary-btn-press">保存状态</button>
    <view class="diary-share-row">
      <button class="diary-ghost" bindtap="onShare" data-cat="body_state" hover-class="diary-btn-press">共享状态</button>
      <button class="diary-ghost" bindtap="onRevoke" data-cat="body_state" hover-class="diary-btn-press">撤回状态</button>
    </view>
  </view>

  <!-- 特殊情况 -->
  <view class="diary-section diary-enter" style="animation-delay: 300ms">
    <view class="diary-section-head">
      <view class="diary-section-title">特殊情况</view>
      <text class="diary-share-tag {{view.shares.special ? 'on' : ''}}">{{view.shares.special ? '已共享' : '默认私密'}}</text>
    </view>
    <view class="chip-row">
      <button
        class="chip {{specialType === item.key ? 'on' : ''}}"
        wx:for="{{specialTypes}}"
        wx:key="key"
        data-k="{{item.key}}"
        bindtap="onSpecialType"
        disabled="{{!view.canEdit}}"
        hover-class="chip-press"
      >{{item.label}}</button>
    </view>
    <textarea
      class="diary-textarea"
      placeholder="可选描述，不强制填写"
      value="{{specialNote}}"
      bindinput="onSpecialNote"
      disabled="{{!view.canEdit}}"
      maxlength="500"
      auto-height
    />
    <button class="diary-primary" bindtap="onSaveSpecial" wx:if="{{view.canEdit}}" hover-class="diary-btn-press">保存特殊情况</button>
    <view class="diary-share-row">
      <button class="diary-ghost" bindtap="onShare" data-cat="special" hover-class="diary-btn-press">共享特殊情况</button>
      <button class="diary-ghost" bindtap="onRevoke" data-cat="special" hover-class="diary-btn-press">撤回</button>
    </view>
  </view>

  <!-- 训练共享 -->
  <view class="diary-section diary-enter diary-section-last" style="animation-delay: 340ms">
    <view class="diary-section-head">
      <view class="diary-section-title">训练共享</view>
      <text class="diary-share-tag {{view.shares.workout_self ? 'on' : ''}}">{{view.shares.workout_self ? '已共享' : '未共享'}}</text>
    </view>
    <view class="diary-item-sub">将当日已完成训练共享给绑定教练；可随时撤回。</view>
    <view class="diary-share-row">
      <button class="diary-ghost" bindtap="onShare" data-cat="workout_self" hover-class="diary-btn-press">共享当日训练</button>
      <button class="diary-ghost" bindtap="onRevoke" data-cat="workout_self" hover-class="diary-btn-press">撤回训练共享</button>
    </view>
  </view>
  </block>
</view>
