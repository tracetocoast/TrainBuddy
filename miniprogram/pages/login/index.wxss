.login-page {
  padding: 48rpx 38rpx 80rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.brand-block {
  margin-bottom: 40rpx;
}

.big-mark {
  width: 80rpx;
  height: 80rpx;
  font-size: 40rpx;
  margin-bottom: 20rpx;
}

.brand-title {
  font-size: 64rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
}

.brand-en {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: #7c8175;
  margin: 8rpx 0 20rpx;
}

.demo-card {
  margin-top: 0;
}

.account-btn {
  display: block;
  width: 100%;
  text-align: left;
  background: #f2f4ed;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-top: 16rpx;
  box-sizing: border-box;
}

.account-btn.warn {
  background: #fff3ea;
}

.account-name {
  font-size: 28rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.privacy-row {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  margin-top: 28rpx;
}

.check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 2rpx solid #c5cbbd;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  flex-shrink: 0;
  background: #fff;
}

.check.on {
  background: #c8ff36;
  border-color: #c8ff36;
  font-weight: 800;
}

.foot-note {
  margin-top: 40rpx;
  text-align: center;
}
