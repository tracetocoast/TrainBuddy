.login-page {
  padding: 48rpx 38rpx 80rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.brand-block {
  margin-bottom: 28rpx; text-align: center;
}

.big-mark {
  width: 80rpx;
  height: 80rpx;
  font-size: 40rpx;
  margin: 0 auto 20rpx;
}

.brand-title {
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.brand-en {
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: #91a6b6;
  margin: 8rpx 0 20rpx;
}

.demo-card {
  margin-top: 0;
}

.account-btn {
  display: block;
  width: 100%;
  text-align: left; border: 2rpx solid #304351; border-bottom-width: 5rpx;
  background: #172735;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-top: 16rpx;
  box-sizing: border-box;
}

.account-btn.warn {
  background: #302e2a;
}

.account-name {
  font-size: 28rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.privacy-row {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  margin-top: 28rpx;
}

.check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 2rpx solid #40596d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  flex-shrink: 0;
  background: var(--surface);
}

.check.on {
  background: #66869e;
  border-color: #66869e;
  font-weight: 800;
}

.foot-note {
  margin-top: 40rpx;
  text-align: center;
}

.login-emblem { display: flex; justify-content: center; margin: 12rpx 0 28rpx; }
.brand-title { color: #e4edf3; font-weight: 500; letter-spacing: 4rpx; }

.check.on { background: #38566d; border-color: #68869a; color: #e4edf3; }
