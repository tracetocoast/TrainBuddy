.login-page {
  padding: 48rpx 38rpx 80rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.brand-block {
  margin-bottom: 28rpx; text-align: center;
}

.big-mark {
  width: 80rpx;
  height: 80rpx;
  font-size: 40rpx;
  margin: 0 auto 20rpx;
}

.brand-title {
  font-size: 52rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.brand-en {
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: #6e7c72;
  margin: 8rpx 0 20rpx;
}

.demo-card {
  margin-top: 0;
}

.account-btn {
  display: block;
  width: 100%;
  text-align: left; border: 2rpx solid #e0e7dc; border-bottom-width: 1rpx;
  background: #f1f4ee;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-top: 16rpx;
  box-sizing: border-box;
}

.account-btn.warn {
  background: #fff3e3;
}

.account-name {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.privacy-row {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  margin-top: 28rpx;
}

.check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 2rpx solid #e0e7dc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  flex-shrink: 0;
  background: var(--surface);
}

.check.on {
  background: #e6f0e4;
  border-color: #a5c5a7;
  font-weight: 600;
}

.foot-note {
  margin-top: 40rpx;
  text-align: center;
}

.login-emblem { display: flex; justify-content: center; margin: 12rpx 0 28rpx; }
.brand-title { color: #25352c; font-weight: 500; letter-spacing: 4rpx; }

.check.on { background: #e6f0e4; border-color: #e0e7dc; color: #25352c; }

.check.on { background: #28744e; border-color: #28744e; color: #ffffff; }
