.login-page { padding:48rpx 50rpx calc(60rpx + env(safe-area-inset-bottom)); min-height:100vh; background:var(--paper); }
.brand-block { margin-bottom:28rpx; }
.brand-title { font-family:"Songti SC","STSong",SimSun,serif; font-size:64rpx; line-height:1.3; white-space:pre-line; color:var(--ink); margin:32rpx 0; }
.login-editorial { display:block; width:100%; height:300rpx; margin-bottom:28rpx; }
.demo-card { margin-top:24rpx; }
.account-btn { display:block; width:100%; padding:24rpx 0; text-align:left; color:var(--ink); border-bottom:1rpx solid var(--line); }
.account-name { font-size:28rpx; font-weight:600; margin-bottom:8rpx; }
.privacy-row { display:flex; gap:16rpx; align-items:flex-start; margin-top:28rpx; }
.check { width:44px; height:44px; flex:none; border:1rpx solid var(--line); border-radius:6rpx; display:flex; align-items:center; justify-content:center; }
.check.on { background:var(--accent); color:var(--on-accent); border-color:var(--accent); }
.foot-note { margin-top:40rpx; color:var(--muted); font-size:22rpx; }
