.login-page {
  padding: 48rpx 38rpx 80rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.brand-block {
  margin-bottom: 28rpx; text-align: center;
}

.big-mark {
  width: 80rpx;
  height: 80rpx;
  font-size: 40rpx;
  margin: 0 auto 20rpx;
}

.brand-title {
  font-size: 52rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.brand-en {
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: var(--muted);
  margin: 8rpx 0 20rpx;
}

.demo-card {
  margin-top: 0;
}

.account-btn {
  display: block;
  width: 100%;
  text-align: left;
  border: 1rpx solid var(--line);
  background: #f7f9fc;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 16rpx;
  box-sizing: border-box;
  transition: transform 0.18s cubic-bezier(.2,.8,.2,1);
  box-shadow: 0 4rpx 16rpx rgba(23, 32, 43, 0.03);
}
.account-btn:active {
  transform: scale(0.97);
}

.account-btn.warn {
  background: #fff3e3;
}

.account-name {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.privacy-row {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  margin-top: 28rpx;
}

.check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  flex-shrink: 0;
  background: var(--surface);
}

.check.on {
  background: #eef4e9;
  border-color: #b7c6f9;
  font-weight: 600;
}

.foot-note {
  margin-top: 40rpx;
  text-align: center;
}

.login-emblem { display: flex; justify-content: center; margin: 12rpx 0 28rpx; }
.brand-title { color: var(--ink); font-weight: 500; letter-spacing: 4rpx; }

.check.on { background: #eef4e9; border-color: var(--line); color: var(--ink); }

.check.on { background: var(--accent); border-color: var(--accent); color: #ffffff; }
.login-page { padding-top:40rpx;background:var(--paper); }
.brand-block { text-align:left;padding:32rpx 0 20rpx; }
.login-emblem { justify-content:flex-start;margin:0 0 26rpx; }
.brand-title { font-size:56rpx;font-weight:750;color:var(--ink);letter-spacing:-1rpx; }
.brand-en { color:var(--muted);font-weight:600; }
.account-btn { border-radius:14rpx;background:var(--surface);box-shadow:none;border-left:4rpx solid var(--accent); }
.check { min-width:44px;min-height:44px; }
