.growth-page { padding-top: 8rpx; padding-bottom: calc(156rpx + env(safe-area-inset-bottom)); }
.growth-header { margin-bottom: 26rpx; }
.growth-brand { display: flex; align-items: center; gap: 14rpx; min-height: 54rpx; color: var(--ink); }
.growth-brand-copy { display: flex; flex-direction: column; justify-content: center; min-width: 0; gap: 2rpx; }
.growth-brand-name { font-size: 30rpx; font-weight: 750; line-height: 1.2; }
.growth-brand-en { color: var(--muted); font-size: 16rpx; letter-spacing: 2rpx; font-weight: 500; line-height: 1.2; }
.growth-title-row { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 24rpx; }
.growth-title-row .title { margin: 0; font-size: 44rpx; letter-spacing: -1rpx; }
.growth-title-row .sub { margin-top: 6rpx; }
.month-pill { flex: none; padding: 12rpx 18rpx; border: 1rpx solid var(--line); border-radius: 999rpx; color: var(--ink); background: var(--surface); font-size: 24rpx; }





















.section-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 30rpx 2rpx 16rpx; }
.section-title { color: var(--ink); font-size: 30rpx; font-weight: 700; letter-spacing: -.3rpx; }
.section-sub { margin-top: 4rpx; color: var(--muted); font-size: 25rpx; }
.section-meta { padding: 8rpx 14rpx; border-radius: 999rpx; color: var(--accent); background: var(--soft); font-size: 22rpx; }
.chart-card,.calendar-card,.day-panel,.record-list { padding: 20rpx 0; border:0; border-bottom:1rpx solid var(--line); border-radius:0; background:transparent; box-shadow:none; }
.chart-grid { position: relative; display: flex; align-items: flex-end; gap: 12rpx; height: 228rpx; padding: 12rpx 2rpx 0; }
.chart-guides { position: absolute; inset: 24rpx 0 36rpx; display: flex; flex-direction: column; justify-content: space-between; pointer-events: none; }
.chart-guides view { border-top: 1rpx solid var(--line); opacity: .72; }
.bar-col { position: relative; z-index: 1; flex: 1; min-width: 0; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; }
.bar-value { min-height: 25rpx; margin-bottom: 5rpx; color: var(--muted); font-size: 22rpx; font-variant-numeric: tabular-nums; }
.bar { width: 34rpx; max-width: 68%; min-height: 8rpx; margin-bottom: 8rpx; border-radius: 12rpx 12rpx 5rpx 5rpx; background:var(--accent); transition: height var(--ix-panel) ease; }
.bar-zero { background: var(--surface-raised); }
.bar-label { color: var(--muted); font-size: 22rpx; }
.chart-summary { min-height: 52rpx; margin-top: 12rpx; padding: 0 14rpx; display: flex; align-items: center; gap: 9rpx; border-radius: 14rpx; color: var(--muted); background: var(--paper); font-size: 24rpx; white-space:normal; }
.summary-dot { width: 10rpx; height: 10rpx; flex: none; border-radius: 50%; background: var(--accent); }
.summary-separator { color: var(--line); }
.summary-rate { margin-left: auto; color: var(--accent); font-weight: 700; }
.empty-card { padding: 26rpx 20rpx; border: 1rpx dashed var(--line); border-radius: 20rpx; color: var(--muted); background: var(--surface); text-align: center; font-size: 25rpx; }
.compact-head { margin-top: 34rpx; }
.highlight-row { display: flex; gap: 12rpx; overflow: hidden; }
.highlight-card { position: relative; flex: 1; min-width: 0; padding: 18rpx 14rpx 16rpx; border: 1rpx solid var(--line); border-radius: 20rpx; background: var(--surface); }
.highlight-mark { position: absolute; top: 16rpx; right: 14rpx; width: 9rpx; height: 9rpx; border-radius: 50%; background: var(--signal); }
.highlight-card .card-title { margin: 0; padding-right: 10rpx; overflow: hidden; color: var(--muted); font-size: 25rpx; white-space:normal; text-overflow: ellipsis; }
.highlight-value { margin-top: 12rpx; color: var(--ink); font-size: 32rpx; font-weight: 700; white-space:normal; }
.highlight-value text { color: var(--muted); font-size: 22rpx; font-weight: 500; }
.highlight-times { margin-left: 3rpx; }
.highlight-date { margin-top: 8rpx; color: var(--muted); font-size: 22rpx; }
.calendar-heading { margin-top: 36rpx; }
.month-switch { display: flex; align-items: center; gap: 8rpx; color: var(--accent); font-size: 24rpx; font-weight: 650; }
.month-arrow {
  width: 56rpx !important;
  height: 56rpx !important;
  min-height: 56rpx !important;
  margin: 0 !important;
  padding: 0 !important;
  border-radius: 50% !important;
  background: var(--surface-raised) !important;
  color: var(--accent) !important;
  font-size: 36rpx !important;
  line-height: 1 !important;
  display: flex !important;
  align-items: center;
  justify-content: center;
}
.month-arrow::after { border: none; }
.cal-weekdays,.cal-grid { display: grid; grid-template-columns: repeat(7,minmax(0,1fr)); text-align: center; }
.cal-weekdays { margin-bottom: 8rpx; color: var(--muted); font-size: 22rpx; }
.cal-cell { min-width: 0; min-height: 72rpx; margin: 2rpx; border: 1rpx solid transparent; border-radius: 16rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; }
.cal-cell.empty { visibility: hidden; }
.cal-cell.today { border-color: var(--ok-line); }
.cal-cell.selected { color: var(--on-accent); background: var(--accent); box-shadow:none; }
.cal-day { font-size: 26rpx; font-weight: 600; line-height: 1; }
.cal-dots { display: flex; justify-content: center; gap: 4rpx; min-height: 9rpx; margin-top: 6rpx; }
.cal-dots .dot { width: 7rpx; height: 7rpx; border-radius: 50%; }
.legend { display: flex; flex-wrap: wrap; gap: 10rpx 16rpx; margin-top: 16rpx; padding-top: 14rpx; border-top: 1rpx solid var(--line); }
.leg { display: flex; align-items: center; gap: 6rpx; color: var(--muted); font-size: 22rpx; }
.dot { width: 11rpx; height: 11rpx; border-radius: 50%; background: var(--soft); }
.dot-workout { background: var(--accent); }.dot-rest { background: var(--purple); }.dot-meal { background: #d99a3e; }.dot-body { background: #85a98a; }.dot-measure { background: var(--steel-ink); }.dot-incomplete { background: var(--danger); }
.day-panel { margin-top: 16rpx; }
.day-panel-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; }
.day-count { padding: 7rpx 12rpx; color: var(--accent); background: var(--soft); border-radius: 999rpx; font-size: 22rpx; }
.day-empty { padding: 14rpx 0; color: var(--muted); font-size: 25rpx; }
.tag-row { display: flex; flex-wrap: wrap; gap: 8rpx; margin: 4rpx 0 10rpx; }
.tag { padding: 8rpx 12rpx; border-radius: 999rpx; color: var(--accent); background: var(--soft); font-size: 22rpx; }
.day-detail-row,.record-item { min-height: 80rpx; display: flex; align-items: center; gap: 14rpx; border-top: 1rpx solid var(--line); }
.row-icon,.record-icon,.tool-icon { width: 48rpx; height: 48rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 14rpx; color: var(--accent); background: var(--soft); font-size: 24rpx; font-weight: 700; }
.measure-icon { color: var(--steel-ink); background: var(--blue-tint); }
.row-title,.record-main { flex: 1; min-width: 0; color: var(--ink); font-size: 28rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space:normal; }
.row-sets { flex: none; color: var(--muted); font-size: 25rpx; font-variant-numeric: tabular-nums; }
.row-sub { margin-top: 3rpx; color: var(--muted); font-size: 24rpx; line-height: 1.4; }
.day-measure-row .row-title { white-space: normal; }
.entry-arrow { color: var(--muted); font-size: 32rpx; }
.diary-button { width: 100%; min-height: 72rpx; margin-top: 12rpx; padding: 0 18rpx; display: flex; align-items: center; justify-content: space-between; border-radius: 16rpx; color: var(--accent); background: var(--soft); font-size: 26rpx; text-align: left; }
.body-entry { width: 100% !important; min-height: 112rpx; margin-top: 28rpx; padding: 18rpx 20rpx; display: flex; align-items: center; gap: 14rpx; border: 1rpx solid var(--line); border-radius:0; background: var(--surface); text-align: left; box-shadow: none; }
.body-entry-icon { width: 56rpx; height: 56rpx; flex: none; display: flex; align-items: flex-end; justify-content: center; gap: 5rpx; padding: 13rpx; box-sizing: border-box; border-radius: 16rpx; background: var(--soft); }
.body-entry-icon view { width: 6rpx; height: 18rpx; border-radius: 4rpx; background: var(--accent); }.body-entry-icon view:nth-child(2){height:29rpx}.body-entry-icon view:nth-child(3){height:23rpx}
.body-entry-title { color: var(--ink); font-size: 29rpx; font-weight: 700; }.body-entry-sub { margin-top: 4rpx; color: var(--muted); font-size: 25rpx; }
.mini-trend { width: 96rpx; height: 44rpx; display: flex; align-items: flex-end; justify-content: space-between; border-bottom: 1rpx solid var(--line); }
.mini-trend view { width: 7rpx; border-radius: 8rpx 8rpx 0 0; background: #8eb99b; }.mini-trend view:nth-child(1){height:14rpx}.mini-trend view:nth-child(2){height:23rpx}.mini-trend view:nth-child(3){height:18rpx}.mini-trend view:nth-child(4){height:32rpx}.mini-trend view:nth-child(5){height:38rpx}
.records-heading { margin-top: 36rpx; }.records-heading .link { flex: none; }
.record-list { padding: 0 16rpx; }.record-item { min-height: 76rpx; }.record-item:first-child { border-top: 0; }.record-icon { font-size: 20rpx; }
.tools-heading { margin-top: 36rpx; }
.points-card { position: relative; overflow: hidden; min-height: 92rpx; margin-bottom: 12rpx; padding: 18rpx 20rpx; display: flex; align-items: center; gap: 14rpx; border: 1rpx solid var(--line); border-radius:0; background:transparent; }
.points-icon { width: 48rpx; height: 48rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; color: var(--accent); background: var(--surface); font-size: 28rpx; }
.points-title,.tool-title { color: var(--ink); font-size: 28rpx; font-weight: 700; }.points-sub,.tool-sub { margin-top: 4rpx; color: var(--muted); font-size: 25rpx; }
.growth-tool-solo { width: 100%; min-height: 96rpx; margin-bottom: 12rpx; padding: 18rpx 20rpx; display: flex; align-items: center; gap: 14rpx; border: 1rpx solid var(--line); border-radius:0; background: var(--surface); text-align: left; }
.growth-tools-row { display: flex; gap: 12rpx; }
.growth-tool-tile { flex: 1; width: auto !important; min-width: 0; min-height: 96rpx; padding: 18rpx 16rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx; border: 1rpx solid var(--line); border-radius:0; background: var(--surface); text-align: left; }
.growth-tool { width: 100%; min-height: 86rpx; padding: 13rpx 0; display: flex; align-items: center; gap: 14rpx; border-radius: 0; background: transparent; text-align: left; }
.diary-tool { color: var(--warm-ink); background: var(--warm-tint); }.exercise-tool { color: var(--steel-ink); background: var(--blue-tint); }
.card-press:active,.body-entry:active,.points-card:active { opacity: .88; }
@media (max-width: 340px) { .chart-summary { font-size:22rpx; gap:6rpx; }.highlight-row { gap: 8rpx; }.highlight-card { padding: 16rpx 10rpx; }.highlight-value { font-size: 21rpx; }.mini-trend { display: none; }.legend { gap: 9rpx 12rpx; } }


.cal-training-label { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space:normal; font-size: 18rpx; color: var(--accent); }
.cal-cell.selected .cal-training-label { color: var(--on-accent); }
.history-tabs { display: flex; border-bottom: 1rpx solid var(--line); }
.history-tab { flex: 1; min-height: 44px; color: var(--muted); font-size: 26rpx; }
.history-tab.active { color: var(--accent); font-weight: 700; border-bottom: 2px solid var(--accent); }
.history-session { width: 100%; text-align: left; color: var(--ink); }

.growth-header .title { margin:28rpx 0; font-size:56rpx; }
.chart-summary { flex-wrap:wrap; }
.calendar-heading { margin-top:24rpx; }
