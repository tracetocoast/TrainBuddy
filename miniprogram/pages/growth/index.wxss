.chart {
  display: flex;
  align-items: flex-end;
  gap: 20rpx;
  height: 270rpx;
}

.bar-col {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.bar {
  width: 100%;
  max-width: 50rpx;
  border-radius: 14rpx 14rpx 6rpx 6rpx;
  margin-bottom: 10rpx;
  min-height: 8rpx;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 24rpx;
  margin-bottom: 16rpx;
}

.leg {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #91a6b6;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #66869e;
}

.dot-workout {
  background: #aac5d9;
}

.dot-rest {
  background: #9eafd0;
}

.dot-meal {
  background: #ffb347;
}

.dot-body {
  background: #5ec8ff;
}

.dot-incomplete {
  background: #e85d5d;
}

.cal-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  font-size: 22rpx;
  color: #91a6b6;
  margin-bottom: 8rpx;
}

.cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.cal-cell {
  min-height: 88rpx;
  border-radius: 16rpx;
  background: var(--surface);
  border: 2rpx solid #304351;
  padding: 8rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cal-cell.empty {
  background: transparent;
  border-color: transparent;
}

.cal-cell.today {
  border-color: #66869e;
}

.cal-cell.selected {
  background: #203748;
  border-color: #aac5d9;
}

.cal-day {
  font-size: 24rpx;
  font-weight: 700;
}

.cal-dots {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
  justify-content: center;
  margin-top: 6rpx;
}

.cal-dots .dot {
  width: 10rpx;
  height: 10rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.growth-summary { display: flex; align-items: center; justify-content: space-between; margin: 28rpx 0 20rpx; padding: 28rpx 32rpx; background: #1c2f3e; border: 1rpx solid #304858; border-radius: 28rpx; }
.growth-total { font-size: 70rpx; font-weight: 800; color: #bdd3e2; line-height: 1.3; margin-top: 8rpx; }
.growth-total text { font-size: 26rpx; margin-left: 12rpx; }

.growth-volume { margin-top: 18rpx; }
.body-entry { display: flex; align-items: center; gap: 22rpx; width: 100% !important; margin-top: 28rpx; padding: 26rpx; border: 2rpx solid #304351; border-radius: 24rpx; background: var(--surface); text-align: left; }
.body-entry-symbol { display: flex; align-items: flex-end; justify-content: center; gap: 7rpx; width: 68rpx; height: 68rpx; padding: 17rpx; background: #223847; border-radius: 20rpx; }
.body-entry-symbol view { width: 8rpx; border-radius: 4rpx; background: #9cbbd1; height: 22rpx; }
.body-entry-symbol view:nth-child(2) { height: 34rpx; }
.body-entry-symbol view:nth-child(3) { height: 27rpx; }
.body-entry-title { font-size: 29rpx; font-weight: 700; color: #d6e4ed; }
.body-entry-sub { font-size: 23rpx; color: #8593a0; margin-top: 6rpx; }
.body-entry-arrow { font-size: 38rpx; color: #a3b1bc; }

.growth-summary { background: linear-gradient(145deg,#243a4b,#172432); }
.growth-emblem { flex-shrink: 0; margin-left: 24rpx; }
