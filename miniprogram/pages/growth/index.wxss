.chart {
  display: flex;
  align-items: flex-end;
  gap: 20rpx;
  height: 270rpx;
}

.bar-col {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.bar {
  width: 100%;
  max-width: 50rpx;
  border-radius: 14rpx 14rpx 6rpx 6rpx;
  margin-bottom: 10rpx;
  min-height: 8rpx;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 24rpx;
  margin-bottom: 16rpx;
}

.leg {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #eef4e9;
}

.dot-workout {
  background: var(--accent);
}

.dot-rest {
  background: #ffffff;
}

.dot-meal {
  background: #e9ac45;
}

.dot-body {
  background: #6aa6a3;
}

.dot-incomplete {
  background: #d86d62;
}

.cal-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
}

.cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.cal-cell {
  min-height: 88rpx;
  border-radius: 24rpx;
  background: var(--surface);
  border: 2rpx solid var(--line);
  padding: 8rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cal-cell.empty {
  background: transparent;
  border-color: transparent;
}

.cal-cell.today {
  border-color: #b7c6f9;
}

.cal-cell.selected {
  background: #eef4e9;
  border-color: #b7c6f9;
}

.cal-day {
  font-size: 24rpx;
  font-weight: 600;
}

.cal-dots {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
  justify-content: center;
  margin-top: 6rpx;
}

.cal-dots .dot {
  width: 10rpx;
  height: 10rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.growth-summary { display: flex; align-items: center; justify-content: space-between; margin: 28rpx 0 20rpx; padding: 28rpx 32rpx; background: #ffffff; border: 1rpx solid var(--line); border-radius: 20rpx; }
.growth-total { font-size: 70rpx; font-weight: 600; color: var(--accent); line-height: 1.3; margin-top: 8rpx; }
.growth-total text { font-size: 26rpx; margin-left: 12rpx; }

.growth-volume { margin-top: 18rpx; }
.body-entry { display: flex; align-items: center; gap: 22rpx; width: 100% !important; margin-top: 28rpx; padding: 26rpx; border: 2rpx solid var(--line); border-radius: 20rpx; background: var(--surface); text-align: left; }
.body-entry-symbol { display: flex; align-items: flex-end; justify-content: center; gap: 7rpx; width: 68rpx; height: 68rpx; padding: 17rpx; background: #ffffff; border-radius: 20rpx; }
.body-entry-symbol view { width: 8rpx; border-radius: 4rpx; background: var(--accent); height: 22rpx; }
.body-entry-symbol view:nth-child(2) { height: 34rpx; }
.body-entry-symbol view:nth-child(3) { height: 27rpx; }
.body-entry-title { font-size: 29rpx; font-weight: 600; color: var(--ink); }
.body-entry-sub { font-size: 23rpx; color: var(--muted); margin-top: 6rpx; }
.body-entry-arrow { font-size: 38rpx; color: var(--muted); }

.growth-summary { background: #ffffff; }
.growth-emblem { flex-shrink: 0; margin-left: 24rpx; }

.growth-summary { background: #eef4e9; border-color: var(--line); }
.growth-total { color: var(--accent); font-weight: 500; }
.dot-rest { background: #9a90b0; }.body-entry-symbol { background: #eef4e9; }
.growth-summary { margin-top:24rpx;background:var(--graphite);color:#fafbf7;border-radius:22rpx;border:0;box-shadow:none; }
.growth-summary .sub { color:#b9c4d1; }
.growth-total { color:#fafbf7;font-weight:750; }
.growth-total text { color:#b9c4d1; }
.chart { border-radius:16rpx;box-shadow:none; }
.body-entry { border-radius:16rpx;box-shadow:none; }
.bar { border-radius:5rpx 5rpx 0 0; }
