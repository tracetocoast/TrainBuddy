.chart {
  display: flex;
  align-items: flex-end;
  gap: 20rpx;
  height: 270rpx;
}

.bar-col {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.bar {
  width: 100%;
  max-width: 50rpx;
  border-radius: 14rpx 14rpx 6rpx 6rpx;
  margin-bottom: 10rpx;
}
