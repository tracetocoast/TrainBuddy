.chart {
  display: flex;
  align-items: flex-end;
  gap: 20rpx;
  height: 270rpx;
}

.bar-col {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.bar {
  width: 100%;
  max-width: 50rpx;
  border-radius: 14rpx 14rpx 6rpx 6rpx;
  margin-bottom: 10rpx;
  min-height: 8rpx;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 24rpx;
  margin-bottom: 16rpx;
}

.leg {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #777777;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #a7df78;
}

.dot-workout {
  background: #58cc02;
}

.dot-rest {
  background: #9b7cff;
}

.dot-meal {
  background: #ffb347;
}

.dot-body {
  background: #5ec8ff;
}

.dot-incomplete {
  background: #e85d5d;
}

.cal-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  font-size: 22rpx;
  color: #777777;
  margin-bottom: 8rpx;
}

.cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.cal-cell {
  min-height: 88rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 2rpx solid #e5e5e5;
  padding: 8rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cal-cell.empty {
  background: transparent;
  border-color: transparent;
}

.cal-cell.today {
  border-color: #a7df78;
}

.cal-cell.selected {
  background: #effbdd;
  border-color: #58cc02;
}

.cal-day {
  font-size: 24rpx;
  font-weight: 700;
}

.cal-dots {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
  justify-content: center;
  margin-top: 6rpx;
}

.cal-dots .dot {
  width: 10rpx;
  height: 10rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.growth-summary { display: flex; align-items: center; justify-content: space-between; margin: 28rpx 0 20rpx; padding: 28rpx 32rpx; background: #f2fbe7; border: 2rpx solid #d7edbd; border-radius: 28rpx; }
.growth-total { font-size: 70rpx; font-weight: 800; color: #487b21; line-height: 1.3; margin-top: 8rpx; }
.growth-total text { font-size: 26rpx; margin-left: 12rpx; }
.growth-sprout { font-size: 98rpx; color: #58cc02; transform: rotate(12deg); }
.growth-volume { margin-top: 18rpx; }
.body-section-head { margin-top: 44rpx; }
.body-tabs { white-space: nowrap; width: 100%; padding-bottom: 12rpx; border-bottom: 2rpx solid #eef1f4; }
.body-tab { display: inline-block; width: auto !important; margin: 0 20rpx 0 0; padding: 12rpx 4rpx; font-size: 25rpx; color: #84909b; }
.body-tab.on { color: #304f68; font-weight: 800; border-bottom: 4rpx solid #304f68; }
.body-trend-top { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; margin: 24rpx 0; }
.body-current { font-size: 64rpx; line-height: 1.3; font-weight: 700; color: #243e54; }
.body-current text { font-size: 25rpx; margin-left: 10rpx; font-weight: 400; color: #7b8996; }
.body-delta { text-align: right; font-size: 24rpx; color: #536a7e; max-width: 50%; }
.body-ranges { display: flex; gap: 10rpx; margin-bottom: 20rpx; }
.body-range { flex: 1; width: 0 !important; padding: 12rpx; font-size: 24rpx; border-radius: 12rpx; color: #7b8996; background: #f6f8fa; }
.body-range.on { background: #e9eff5; color: #304f68; font-weight: 700; }
.body-chart { position: relative; width: 600rpx; height: 200rpx; margin: 12rpx auto; }
.body-grid-line { position: absolute; width: 100%; border-top: 1rpx dashed #e2e8ee; }
.grid-top { top: 20rpx; }.grid-middle { top: 100rpx; }.grid-bottom { top: 180rpx; }
.body-line { height: 4rpx; background: #527b9a; position: absolute; transform-origin: left center; }
.body-dot { position: absolute; width: 12rpx; height: 12rpx; margin: -4rpx 0 0 -6rpx; background: #527b9a; border: 2rpx solid #fff; border-radius: 50%; }
.body-chart-labels { display: flex; justify-content: space-between; gap: 12rpx; font-size: 21rpx; color: #8593a0; margin-top: 16rpx; }
.body-chart-empty { padding: 54rpx 0; text-align: center; color: #8c9aa6; font-size: 26rpx; line-height: 1.8; }
.body-tiles { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12rpx; margin-top: 16rpx; }
.body-tile { width: 100%; padding: 18rpx 12rpx; border: 2rpx solid #e5eaf0; border-radius: 20rpx; text-align: left; background: #fff; }
.body-tile.selected { border-color: #a5bccc; background: #f4f8fb; }
.body-field-label { color: #697d8d; font-size: 23rpx; margin-bottom: 8rpx; }
.body-field-label text { color: #9ba7af; margin-left: 6rpx; }
.body-tile-value { font-size: 32rpx; font-weight: 700; color: #304f68; }
.body-tile-value text { font-size: 20rpx; font-weight: 400; }
.body-tile-date { font-size: 19rpx; color: #8c9aa6; margin-top: 6rpx; }
.body-date { display: flex; justify-content: space-between; padding: 20rpx 0; font-size: 26rpx; color: #697d8d; }
.body-date text { color: #304f68; }
.body-form { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 22rpx 16rpx; }
.body-form-note { font-size: 22rpx; margin-top: 20rpx; }
.body-history-row { display: flex; gap: 16rpx; align-items: center; border-top: 1rpx solid #edf1f5; padding: 20rpx 0; font-size: 26rpx; }
.body-history-row .sub { font-size: 23rpx; }
.body-conflict { background: #fff5e5; border-radius: 16rpx; padding: 18rpx; margin-top: 16rpx; }
.body-tab { margin-right: 22rpx !important; padding: 14rpx 6rpx; }
