<view class="page">
  <view class="top">
    <view class="brand">
      <text class="mark">↗</text>练搭子
      <text class="brand-sub">TRAIN BUDDY</text>
    </view>
  </view>
  <role-switcher />
  <view class="eyebrow">YOUR PROGRESS · S08</view>
  <view class="title">每一点进步，都算数</view>
  <view class="growth-summary">
    <view class="grow">
      <view class="sub">本周完成训练</view>
      <view class="growth-total">{{summary && !summary.empty.sessionCount ? summary.sessionCount : '—'}}<text>次</text>
      </view>
    </view>
    <view class="growth-sprout" aria-hidden="true">✿</view>
  </view>
  <view class="stats">
    <view class="stat">
      <text class="stat-value">{{summary && summary.trainingDays ? summary.trainingDays : '—'}}</text>
      <text class="stat-label">训练天数</text>
    </view>
    <view class="stat">
      <text class="stat-value">{{summary && summary.planCompletionRate != null ? summary.planCompletionRate + '%' : '—'}}</text>
      <text class="stat-label">计划完成率</text>
    </view>
    <view class="stat">
      <text class="stat-value">{{summary && summary.diaryStreak ? summary.diaryStreak : '—'}}</text>
      <text class="stat-label">连续记录</text>
    </view>
  </view>
  <view class="sub growth-volume" wx:if="{{summary && !summary.empty.volume}}">本周累计训练量 {{summary.volumeKg}} kg×次</view>
  <!-- 本周柱状 -->
  <view class="head">
    <view class="head-title">本周训练节奏</view>
    <text class="tag">{{summary && !summary.empty.sessionCount ? '有数据' : '暂无'}}</text>
  </view>
  <view class="card chart" wx:if="{{summary && summary.bars && summary.bars.length}}">
    <view class="bar-col" wx:for="{{summary.bars}}" wx:key="date">
      <view class="bar" style="height: {{item.height || 8}}rpx; background: {{item.sets ? '#58cc02' : '#e5e5e5'}};"></view>
      <text class="sub">{{item.label}}</text>
    </view>
  </view>
  <view class="card sub" wx:else>完成第一次训练后，就能看到你的训练节奏。</view>
  <view class="head body-section-head"><view class="head-title">身体档案</view><button class="link" bindtap="onBodyOpen" disabled="{{bodyLoading || bodyError}}">＋ 记录数据</button></view>
  <view class="sub">看见身体的变化，而不只是体重。记录仅自己可见。</view>
  <view class="card" wx:if="{{bodyError}}"><view class="sub">{{bodyError}}</view><button class="link" bindtap="loadMeasurements">重新读取</button></view>
  <view class="sub" wx:if="{{bodyLoading}}">正在读取身体档案…</view>
  <view class="body-editor card" wx:if="{{bodyEditor}}">
    <view class="card-title">记录身体数据</view>
    <picker mode="date" value="{{bodyDate}}" start="1900-01-01" end="{{bodyToday}}" bindchange="onBodyDate" disabled="{{bodySaving}}"><view class="body-date">测量日期 <text>{{bodyDate}} ▾</text></view></picker>
    <view class="body-form"><view class="body-form-item" wx:for="{{bodyFields}}" wx:key="key"><view class="body-field-label">{{item.label}} <text>{{item.unit}}</text></view><input class="field" type="digit" value="{{item.value}}" placeholder="选填" data-index="{{index}}" bindinput="onBodyInput" disabled="{{bodySaving || bodyConflict}}" /></view></view>
    <view class="sub body-form-note">只填本次测量的项目；同日再次保存会更新该日记录。修改日期将载入对应日期的表单。上臂、大腿、小腿请始终记录同一侧，肩围为绕肩一周。保持相同测量条件更便于比较。</view>
    <view class="body-conflict" wx:if="{{bodyConflict}}"><view class="sub">该日数据已在另一处更新。当前输入已保留，可先备份，再载入最新记录。</view><button class="link" bindtap="onBodyReload">载入最新记录</button></view>
    <view class="twobtn"><button class="secondary" bindtap="onBodyClose" disabled="{{bodySaving}}">收起</button><button class="primary" bindtap="onBodySave" loading="{{bodySaving}}" disabled="{{bodySaving || bodyConflict}}">保存记录</button></view>
  </view>
  <view class="body-trend card">
    <scroll-view scroll-x class="body-tabs"><button wx:for="{{bodyMetrics}}" wx:key="key" class="body-tab {{bodyKey === item.key ? 'on' : ''}}" data-key="{{item.key}}" bindtap="onBodyMetric">{{item.label}}</button></scroll-view>
    <view class="body-trend-top"><view><view class="body-current">{{bodyTrend.latest}}<text>{{bodyTrend.metric.unit}}</text></view><view class="sub">{{bodyTrend.latestDate || '还没有这项记录'}}</view></view><view class="body-delta"><text>{{bodyTrend.deltaText}}</text><view class="sub" wx:if="{{bodyTrend.count > 1}}">所选区间首末对比</view></view></view>
    <view class="body-ranges"><button wx:for="{{[{key:'30',label:'30天'},{key:'90',label:'90天'},{key:'all',label:'全部'}]}}" wx:key="key" class="body-range {{bodyRange === item.key ? 'on' : ''}}" data-range="{{item.key}}" bindtap="onBodyRange">{{item.label}}</button></view>
    <view class="body-chart" wx:if="{{bodyTrend.count}}" aria-label="{{bodyTrend.metric.label}}趋势，共{{bodyTrend.count}}次记录，最新{{bodyTrend.latest}}{{bodyTrend.metric.unit}}，{{bodyTrend.deltaText}}"><view class="body-grid-line grid-top"></view><view class="body-grid-line grid-middle"></view><view class="body-grid-line grid-bottom"></view><view class="body-line" wx:for="{{bodyTrend.lines}}" wx:key="id" style="{{item.style}}"></view><view class="body-dot" wx:for="{{bodyTrend.dots}}" wx:key="date" style="left:{{item.x}}rpx;top:{{item.y}}rpx"></view></view>
    <view class="body-chart-empty" wx:else>从一次测量开始，<view>让每一份改变都有迹可循。</view></view>
    <view class="body-chart-labels" wx:if="{{bodyTrend.count}}"><text>{{bodyTrend.firstDate}}</text><text>{{bodyTrend.latestDate}}</text></view>
    <view class="body-chart-labels" wx:if="{{bodyTrend.count > 1}}"><text>最低 {{bodyTrend.min}} / 最高 {{bodyTrend.max}} {{bodyTrend.metric.unit}}</text><text>{{bodyTrend.count}} 次测量</text></view>
    <view class="sub body-form-note">{{bodyTrend.count === 1 ? '已有一次记录，再记录一次即可比较变化。' : '连线仅连接测量点；变化幅度不代表健康评价。'}}</view>
  </view>
  <view class="body-tiles"><button class="body-tile {{bodyKey === item.key ? 'selected' : ''}}" wx:for="{{bodyTiles}}" wx:key="key" data-key="{{item.key}}" bindtap="onBodyMetric"><view class="body-field-label">{{item.label}}</view><view class="body-tile-value">{{item.value}} <text>{{item.unit}}</text></view><view class="body-tile-date">{{item.date}}</view></button></view>
  <view class="body-history card" wx:if="{{bodyHistory.length}}"><view class="card-title">最近测量</view><view class="body-history-row" wx:for="{{bodyHistory}}" wx:key="date"><view class="grow"><view>{{item.date}}</view><view class="sub">{{item.text}}</view></view><button class="link" data-date="{{item.date}}" bindtap="onBodyOpen">修改</button></view></view>

  <!-- 多标记日历 -->
  <view class="head">
    <view class="head-title">{{monthLabel}} 日历</view>
    <button class="link" bindtap="goExercises">动作库 ↗</button>
  </view>
  <view class="legend">
    <view class="leg" wx:for="{{legend}}" wx:key="key">
      <view class="dot {{item.cls}}"></view>
      <text>{{item.label}}</text>
    </view>
  </view>
  <view class="cal-weekdays">
    <text wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="*this">{{item}}</text>
  </view>
  <view class="cal-grid">
    <view
    class="cal-cell {{item.empty ? 'empty' : ''}} {{item.isToday ? 'today' : ''}} {{item.isSelected ? 'selected' : ''}}"
    wx:for="{{calendarCells}}"
    wx:key="key"
    data-date="{{item.date}}"
    bindtap="onPickDay"
    >
    <text class="cal-day" wx:if="{{!item.empty}}">{{item.day}}</text>
    <view class="cal-dots" wx:if="{{item.hasAny}}">
      <view class="dot dot-{{d}}" wx:for="{{item.dots}}" wx:for-item="d" wx:key="*this"></view>
    </view>
  </view>
</view>
<view class="card" style="margin-top:16rpx" wx:if="{{dayDetail}}">
  <view class="card-title">{{dayDetail.date}}</view>
  <view class="sub" wx:if="{{dayDetail.empty}}">当日暂无标记</view>
  <view class="tag-row" wx:else>
    <text class="tag" wx:for="{{dayDetail.markers}}" wx:key="*this">{{item}}</text>
  </view>
  <view class="sub" wx:for="{{dayDetail.sessions}}" wx:key="id">{{item.title}} · {{item.doneSets}} 组</view>
  <button class="secondary" style="width:100%;margin-top:12rpx" bindtap="goDiary">打开日记编辑</button>
</view>
<view class="head">
  <view class="head-title">训练记录</view>
  <button class="link" bindtap="goWorkout">继续训练 ↗</button>
</view>
<block wx:if="{{records.length}}">
  <view class="card" wx:for="{{records}}" wx:key="id">{{item.text}}</view>
</block>
<view class="sub" wx:else>完成一次训练后，你的记录会显示在这里。</view>
</view>
<bottom-nav active="growth" />
