<wxs module="swipeAxis">
function point(event) {
  var list = event.touches
  if (!list || !list.length) list = event.changedTouches
  if (!list || !list.length) return null
  return list[0]
}

function numberOf(value, fallback) {
  var n = value * 1
  if (n !== n) return fallback
  return n
}

function start(event, ownerInstance) {
  var touch = point(event)
  var state = ownerInstance.getState()
  var dataset = event.currentTarget && event.currentTarget.dataset
  if (!touch) return
  state.startX = touch.clientX
  state.startY = touch.clientY
  state.axis = ''
  state.ready = 1
  state.offset = dataset ? numberOf(dataset.offset, 0) : 0
  state.startOffset = state.offset
  state.max = dataset ? numberOf(dataset.max, 104) : 104
  state.index = dataset ? dataset.index : ''
}

function move(event, ownerInstance) {
  var state = ownerInstance.getState()
  var touch = point(event)
  if (!touch) return
  if (!state.ready) {
    start(event, ownerInstance)
    return
  }
  var dx = touch.clientX - state.startX
  var dy = touch.clientY - state.startY
  if (!state.axis) {
    if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return
    state.axis = Math.abs(dx) > Math.abs(dy) ? 'x' : 'y'
  }
  if (state.axis !== 'x') return
  var offset = state.startOffset + dx
  if (offset > 0) offset = 0
  if (offset < -state.max) offset = -state.max
  state.offset = offset
  if (event.instance && event.instance.setStyle) {
    event.instance.setStyle({
      transform: 'translateX(' + offset + 'px)',
      transition: 'none'
    })
  }
  var method = 'onSwipeMove'
  var dataset = event.currentTarget && event.currentTarget.dataset
  if (dataset && dataset.moveMethod) method = dataset.moveMethod
  ownerInstance.callMethod(method, {
    clientX: touch.clientX,
    clientY: touch.clientY,
    touches: [{ clientX: touch.clientX, clientY: touch.clientY }]
  })
  return false
}

function end(event, ownerInstance) {
  var state = ownerInstance.getState()
  var dataset = event.currentTarget && event.currentTarget.dataset
  if (state.axis === 'x') {
    var open = state.offset < -state.max / 2
    var final = open ? -state.max : 0
    if (event.instance && event.instance.setStyle) {
      event.instance.setStyle({
        transform: 'translateX(' + final + 'px)',
        transition: 'transform 180ms ease'
      })
    }
    var snap = 'onSwipeSnap'
    if (dataset && dataset.snapMethod) snap = dataset.snapMethod
    ownerInstance.callMethod(snap, {
      index: state.index,
      si: dataset && dataset.si,
      offset: final
    })
  }
  state.ready = 0
  state.axis = ''
}

module.exports.start = start
module.exports.move = move
module.exports.end = end

</wxs>
<page-meta background-color="{{pageBg}}" />
<view class="page page-solo {{skinClass}}">
  <view class="eyebrow">TRAINING PLANS</view>
  <view class="title">计划列表</view>
  <view class="plan-filter">
    <button
      wx:for="{{filters}}"
      wx:key="key"
      class="plan-filter-item {{filterKey === item.key ? 'plan-filter-item-on' : ''}}"
      data-key="{{item.key}}"
      bindtap="onFilter"
    >{{item.label}}</button>
  </view>
  <view class="ui-state" wx:if="{{loading}}">正在读取计划…</view>
  <view class="ui-state ui-state-error" wx:if="{{error}}">{{error}}<button class="link" bindtap="onShow">重试加载</button></view>

  <view class="swipe-row" wx:for="{{plans}}" wx:key="plan_id">
    <view class="swipe-action" wx:if="{{item.can_edit}}">
      <button
        class="swipe-edit"
        catchtap="goEdit"
        data-id="{{item.plan_id}}"
      >编辑</button>
      <view
        class="trash-btn"
        catchtap="onAskDelete"
        data-id="{{item.plan_id}}"
        data-title="{{item.published ? item.published.title : (item.latest_draft && item.latest_draft.title) || '未命名计划'}}"
        aria-role="button"
        aria-label="删除计划"
      >
        <view class="trash-cap"></view>
        <view class="trash-lid"></view>
        <view class="trash-body">
          <view class="trash-line"></view>
          <view class="trash-line"></view>
        </view>
      </view>
    </view>
    <view
      class="swipe-front card plan-card {{item.swiping ? 'swiping' : ''}}"
      data-id="{{item.plan_id}}"
      data-index="{{index}}"
      data-can-edit="{{item.can_edit ? 1 : 0}}"
      data-offset="{{item.offset}}"
      data-max="{{actionWidth}}"
      data-move-method="onSwipeMove"
      data-snap-method="onSwipeSnap"
      capture-bind:touchstart="{{swipeAxis.start}}"
      bindtouchstart="onSwipeStart"
      bindtouchmove="{{swipeAxis.move}}"
      capture-bind:touchend="{{swipeAxis.end}}"
      bindtouchend="onSwipeEnd"
      capture-bind:touchcancel="{{swipeAxis.end}}"
      bindtouchcancel="onSwipeEnd"
      bindtap="goView"
      style="transform: translateX({{item.offset}}px);"
    >
      <template is="planBody" data="{{item, isStudent}}"/>
    </view>
  </view>
  <view class="card sub" wx:if="{{!loading && !error && hasPlans && !plans.length}}">当前分类暂无计划。</view>
  <view class="card sub" wx:if="{{!loading && !error && !hasPlans && !(isCoach && !studentId)}}">暂无计划。可以新建一份自己的训练计划，或从动作库加入动作后再编辑发布。</view>
  <view class="card sub" wx:if="{{isCoach && !studentId && !loading}}">先从学员列表进入一位学员，再为该学员新建计划。</view>

  <button class="primary" style="width:100%;margin-top:20rpx" bindtap="onCreatePlan" wx:if="{{canCreate}}" disabled="{{creating}}" loading="{{creating}}">新建训练计划</button>
</view>

<template name="planBody">
  <view class="card-title">
    {{item.published ? item.published.title : (item.latest_draft && item.latest_draft.title) || '未命名计划'}}
  </view>
  <view class="sub">{{item.author_role === 'coach' ? '教练制定' : '个人模板'}}</view>
  <view class="tag-row">
    <text class="tag" wx:if="{{item.published}}">已发布 v{{item.published.version}}</text>
    <text class="tag" wx:if="{{item.latest_draft}}">草稿 v{{item.latest_draft.version}}</text>
  </view>
  <view class="plan-cta" wx:if="{{item.published && isStudent}}">
    <button class="primary plan-start" data-id="{{item.plan_id}}" catchtap="goStart">开练</button>
  </view>
</template>
