<picker mode="{{mode}}" value="{{value}}" start="{{start}}" end="{{end}}" range="{{options}}" range-key="label" disabled="{{disabled}}" bindchange="select">
  <view class="picker {{disabled ? 'disabled' : ''}}" aria-label="{{label}}"><text class="label">{{label}}</text><text class="value">{{mode === 'date' ? (value || placeholder) : (options[value].label || placeholder)}}</text><text>⌄</text></view>
</picker>
