:host{display:block}.history{margin:40rpx 0;padding-bottom:24rpx;color:var(--ink)}.title{font-size:32rpx;font-weight:600;margin:32rpx 0 20rpx}.hint{font-size:24rpx;color:var(--muted);line-height:1.7}.latest,.row{display:block;width:100%;box-sizing:border-box;text-align:left;font-size:29rpx;font-weight:400;line-height:1.7;white-space:normal;overflow-wrap:anywhere}.latest{padding:28rpx;background:var(--soft);border-radius:20rpx}.row{padding:24rpx 0;background:transparent;border-bottom:1rpx solid var(--line);border-radius:0}.latest::after,.row::after{border:0}.link{color:var(--accent);margin-top:12rpx}