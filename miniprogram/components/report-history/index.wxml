<view class="history"><view class="title">教练训练报告</view><view wx:if="{{loading}}" class="hint">正在读取…</view><view wx:elif="{{error}}" class="hint">{{error}}<button bindtap="reload">重试</button></view><block wx:else><button wx:if="{{latest}}" class="latest" data-id="{{latest.id}}" bindtap="open"><text class="hint">{{latest.date}} · 教练指导</text><view>{{latest.title}}</view><text class="hint">{{latest.exerciseCount}} 个动作 · {{latest.completedSets}} 组完成</text><view class="link">查看报告 ›</view></button><view wx:else class="hint">还没有收到教练训练报告</view><view class="title">训练历史</view><button wx:for="{{items}}" wx:key="id" class="row" data-id="{{item.id}}" bindtap="open"><view class="hint">{{item.date}} · {{item.source}}</view><view>{{item.title}}</view><view class="hint">{{item.exerciseCount}} 个动作 · {{item.completedSets}} 组完成</view></button><view class="hint" wx:if="{{!items.length}}">完成的训练将保留在这里</view></block></view>