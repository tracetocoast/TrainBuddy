.tb-action{width:100%;border:0!important;border-radius:23rpx;background:#575bdc;color:#fff;font-size:27rpx;font-weight:800;min-height:90rpx;display:flex;align-items:center;justify-content:center;transition:transform 160ms ease,background-color 230ms ease;box-shadow:0 10rpx 24rpx rgba(87,91,220,.14)}
.tb-action:after{border:0!important}.tb-action:not([disabled]):active{transform:scale(.975)}.tb-action.is-success{background:#358e72}.tb-action.no-motion{transition:none}.tb-action.no-motion:active{transform:none}
.tb-action-label{animation:tb-action-enter 200ms both}@keyframes tb-action-enter{from{opacity:.25;transform:translateY(5rpx)}to{opacity:1;transform:translateY(0)}}