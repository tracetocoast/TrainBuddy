<view class="role" wx:if="{{roleOptions.length}}">
  <button
    wx:for="{{roleOptions}}"
    wx:key="role"
    class="role-btn {{role === item.role ? 'on' : ''}}"
    data-role="{{item.role}}"
    bindtap="onTap"
  >{{item.label}}</button>
  <view class="role-hint" wx:if="{{!canSwitchCoach && roleOptions.length === 1}}">
    仅已授予角色可切换 · 申请教练请至个人中心
  </view>
</view>
