.role {
  display: flex;
  gap: 8rpx;
  padding: 6rpx;
  margin: 4rpx 0 24rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 22rpx;
  background: #f7f9fa;
}

.role-btn {
  flex: 1;
  width: 0;
  min-height: 72rpx;
  padding: 14rpx 12rpx;
  border-radius: 16rpx;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.5;
  color: #777;
}

.role-btn.on {
  background: #fff;
  color: #487b21;
  box-shadow: 0 3rpx 0 #d9e7ce;
}

.role-btn {
  width: 0 !important;
  margin-left: 0 !important;
  margin-right: 0 !important;
}
