/* 分段胶囊 · 对齐 AI 工具 Tab */
.role {
  display: flex;
  gap: 0;
  padding: 6rpx;
  margin: 4rpx 0 24rpx;
  border: 1rpx solid #e0e7dc;
  border-radius: 999rpx;
  background: #eef3ea;
  box-sizing: border-box;
}

.role-btn {
  flex: 1;
  width: 0 !important;
  margin-left: 0 !important;
  margin-right: 0 !important;
  min-height: 68rpx;
  padding: 14rpx 12rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.5;
  color: #6e7c72;
  background: transparent;
  transition:
    transform 0.18s cubic-bezier(0.34, 1.4, 0.64, 1),
    background 0.22s ease,
    color 0.22s ease,
    box-shadow 0.22s ease;
}

.role-btn::after {
  border: none;
}

.role-btn.on {
  background: #ffffff;
  color: #1f5c3d;
  font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(40, 116, 78, 0.12);
}

.role-btn-press {
  transform: scale(0.96);
  opacity: 0.92;
}
