.role {
  display: flex;
  gap: 8rpx;
  padding: 6rpx;
  margin: 4rpx 0 24rpx;
  border: 2rpx solid #e0e7dc;
  border-radius: 22rpx;
  background: #f1f4ee;
}

.role-btn {
  flex: 1;
  width: 0;
  min-height: 72rpx;
  padding: 14rpx 12rpx;
  border-radius: 16rpx;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.5;
  color: #6e7c72;
}

.role-btn.on {
  background: var(--surface);
  color: #28744e;
  box-shadow: 0 3rpx 0 #e0e7dc;
}

.role-btn {
  width: 0 !important;
  margin-left: 0 !important;
  margin-right: 0 !important;
}

.role { border-width: 1rpx; background: #f1f4ee; }
.role-btn { font-weight: 400; color: #6e7c72; }
.role-btn.on { color: #25352c; background: #e6f0e4; box-shadow: none; }
