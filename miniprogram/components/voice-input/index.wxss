:host { display:block; }
.voice-input,.voice-text,.mic-button,.control-button,.parse-button,.text-action { box-sizing:border-box; }
.mic-button,.control-button,.parse-button,.text-action { margin:0; font:inherit; line-height:1.4; padding:0; border:0; }
.mic-button::after,.control-button::after,.parse-button::after,.text-action::after { border:none; }
.voice-input { padding:24rpx; border:1rpx solid var(--line); border-radius:20rpx; background:var(--surface); color:var(--ink); }
.voice-active { border-color:var(--accent); }
.voice-heading { display:flex; align-items:center; gap:12rpx; justify-content:space-between; font-size:26rpx; font-weight:600; }
.channel { color:var(--muted,var(--muted)); font-size:20rpx; font-weight:400; }
.voice-text { display:block; width:100%; min-height:96rpx; max-height:300rpx; margin:16rpx 0; padding:0; font-size:28rpx; line-height:1.6; border:0; background:transparent; }
.voice-controls { border-top:1rpx solid var(--line); padding:20rpx 0; }
.voice-start,.voice-running,.voice-waiting { display:flex; align-items:center; gap:16rpx; min-height:88rpx; }
.voice-copy { flex:1; min-width:0; }
.mic-button { flex:none; display:flex; align-items:center; justify-content:center; width:88rpx !important; height:88rpx; min-width:44px; min-height:44px; border-radius:24rpx; background:var(--surface-raised,var(--surface-raised)); }
.status { display:block; font-size:25rpx; line-height:1.6; }
.hint { display:block; color:var(--muted,var(--muted)); font-size:22rpx; line-height:1.6; font-weight:400; }
.live { display:flex; align-items:center; gap:10rpx; }
.record-dot { width:12rpx; height:12rpx; border-radius:50%; background:var(--danger,var(--danger)); flex:none; }
.pulsing { animation:record-pulse 1200ms ease-in-out infinite; }
.clock { display:block; margin-top:8rpx; font-size:36rpx; font-weight:600; font-variant-numeric:tabular-nums; }
.clock .hint { display:inline; }
.control-button { display:flex; flex:none; flex-direction:column; align-items:center; justify-content:center; gap:6rpx; width:88rpx !important; min-width:44px; min-height:44px; padding:8rpx; border-radius:14rpx; color:var(--ink); background:var(--surface-raised,var(--surface-raised)); font-size:22rpx; }
.stop-button { color:var(--danger,var(--danger)); background:var(--danger-bg); }
.spinner { flex:none; width:28rpx; height:28rpx; border:3rpx solid var(--line); border-top-color:var(--accent); border-radius:50%; animation:spin 900ms linear infinite; }
.parse-button { width:100% !important; min-height:44px; padding:20rpx 16rpx; margin-top:16rpx; border:1rpx solid var(--line); border-radius:14rpx; background:var(--surface); color:var(--accent); font-size:26rpx; font-weight:600; }
.text-action { padding:16rpx 0; min-height:44px; text-align:left; color:var(--accent); background:transparent; font-size:24rpx; }
.disabled { opacity:.45; }
.mic-button:active,.control-button:active,.parse-button:active,.text-action:active { opacity:.75; }
@keyframes record-pulse { 50% { opacity:.35; } }
@keyframes spin { to { transform:rotate(360deg); } }
.reduced .pulsing,.reduced .spinner { animation:none; }
@media (prefers-reduced-motion:reduce) { .pulsing,.spinner { animation:none; } }
@media (max-width:340px) { .voice-input { padding:20rpx; } .voice-running { flex-wrap:wrap; } .voice-copy { min-width:140rpx; } }
/* Capture variant is opt-in; other voice-input callers retain their layout. */
.capture-input { border:0; padding:32rpx 0; background:transparent; }
.capture-input .voice-heading { font-size:24rpx; color:var(--muted); }
.capture-prompt { font-size:38rpx; text-align:center; margin:52rpx 0 36rpx; }
.capture-input .voice-controls { border:0; padding:32rpx 0; }
.capture-input .voice-start { flex-direction:column; text-align:center; gap:24rpx; }
.capture-input .mic-button { width:176rpx !important; height:176rpx; border-radius:50%; background:var(--surface-raised); border:2rpx solid var(--accent); }
.capture-input .voice-running { flex-wrap:wrap; justify-content:center; }
.capture-input .voice-running .voice-copy { flex-basis:100%; text-align:center; }
.capture-input .clock { font-size:64rpx; font-variant-numeric:tabular-nums; margin:20rpx; }
.capture-input .text-action { width:100%; min-height:44px; margin-top:36rpx; border-top:1rpx solid var(--line); padding-top:24rpx; }
.journal-voice { color: #282522; }
.journal-tabs { display: flex; gap: 68rpx; }
.journal-tabs button { min-height: 44px; font-size: 25rpx; color: #827A73; border-bottom: 2px solid transparent; background: transparent; }
.journal-tabs .journal-selected { color: #AB584A; border-color: #AB584A; font-weight: 700; }
.journal-controls { padding: 42rpx 0 24rpx; text-align: center; }
.journal-wave { height: 114rpx; display: flex; align-items: center; justify-content: center; gap: 7rpx; }
.journal-bar { width: 5rpx; background: #AB584A; opacity: .30; border-radius: 4rpx; }
.journal-live .journal-bar { opacity: .55; animation: journal-pulse 900ms ease-in-out alternate infinite; }
.journal-live .journal-bar:nth-child(2n) { animation-delay: 160ms; }
.journal-live .journal-bar:nth-child(3n) { animation-delay: 350ms; }
.journal-reduced .journal-bar { animation: none; }
@keyframes journal-pulse { from { transform: scaleY(.76); } to { transform: scaleY(1); } }
.journal-controls .journal-record { display: flex; align-items: center; justify-content: center; width: 280rpx !important; height: 280rpx; margin: 40rpx auto 0 !important; padding: 0; border: 1rpx solid #D5AEA2; border-radius: 50%; background: #F6EEE8; }
.journal-record::after { border: 0; }
.journal-stop, .journal-start, .journal-wait { width: 50rpx; height: 50rpx; background: #AB584A; border-radius: 10rpx; }
.journal-start { border-radius: 50%; }
.journal-wait { width: 24rpx; height: 24rpx; opacity: .45; }
.journal-status { margin: 16rpx 0 0; color: #AB584A; font-size: 27rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.journal-transcript { border-top: 1rpx solid #E1D8CE; padding: 24rpx 0 12rpx; }
.journal-caption { display: flex; justify-content: space-between; color: #827A73; font-size: 22rpx; }
.journal-copy, .journal-text { box-sizing: border-box; width: 100%; margin-top: 16rpx; color: #282522; font-size: 28rpx; line-height: 1.8; overflow-wrap: anywhere; }
.journal-text { min-height: 140rpx; }
.journal-hint { margin-top: 10rpx; color: #827A73; font-size: 22rpx; }
.journal-voice .journal-link { min-height: 44px; padding: 0 8rpx; color: #AB584A; font-size: 24rpx; font-weight: 650; background: transparent; }

@media (prefers-reduced-motion:reduce) { .journal-live .journal-bar { animation:none; } }
