<view wx:if="{{variant === 'field-notes'}}" class="journal-voice {{reduced ? 'journal-reduced' : ''}}">
  <view class="journal-tabs">
    <button class="{{!showText ? 'journal-selected' : ''}}" bindtap="onVoiceTab">语音记录</button>
    <button class="{{showText ? 'journal-selected' : ''}}" bindtap="onManualTab">手动输入</button>
  </view>
  <view wx:if="{{!showText || active || waiting}}" class="journal-controls" aria-live="polite">
    <view class="journal-wave {{state === 'recording' ? 'journal-live' : ''}}" aria-hidden="true">
      <view wx:for="{{waveHeights}}" wx:key="index" class="journal-bar" style="height: {{item}}rpx"></view>
    </view>
    <button wx:if="{{active}}" class="journal-record" bindtap="onStop" aria-label="结束录音"><view class="journal-stop"></view></button>
    <button wx:else class="journal-record" bindtap="onStart" disabled="{{disabled || waiting || micDenied}}" aria-label="开始录音">
      <view class="{{waiting ? 'journal-wait' : 'journal-start'}}"></view>
    </button>
    <view class="journal-status">{{micDenied ? '麦克风不可用' : status}}<text wx:if="{{active}}"> {{time}}</text></view>
    <button class="journal-link" wx:if="{{active && canPause}}" bindtap="onPause">{{state === 'recording' ? '暂停录音' : '继续录音'}}</button>
    <button class="journal-link" wx:if="{{micDenied && !disabled}}" bindtap="onAuthorize">重试麦克风授权</button>
    <view class="journal-hint" wx:if="{{active && !canPause}}">可结束本段后继续补录</view>
  </view>
  <view class="journal-transcript">
    <view class="journal-caption"><text>{{showText ? '训练描述' : '录音文字'}}</text><text wx:if="{{mock}}">演示通道</text></view>
    <textarea wx:if="{{showText}}" class="journal-text" value="{{text}}" placeholder="{{placeholder}}" maxlength="-1" auto-height cursor-spacing="72" bindinput="onText" disabled="{{disabled || active || waiting}}" aria-label="训练描述"/>
    <view wx:else class="journal-copy">{{text || (waiting ? '正在处理本段录音' : '识别后的文字会显示在这里')}}</view>
    <view wx:if="{{mock}}" class="journal-hint">演示通道不会真实识别本次语音</view>
    <button class="journal-link" wx:if="{{showParse && text && !active && !waiting && !disabled}}" bindtap="onParse">整理训练内容 ↗</button>
  </view>
</view>
<view wx:else class="voice-input {{variant === 'capture' ? 'capture-input' : ''}} {{active ? 'voice-active' : ''}} {{reduced ? 'reduced' : ''}}">
  <view class="voice-heading"><text>{{label}}</text><text class="channel" wx:if="{{mock}}">演示通道</text></view>
  <view class="capture-prompt" wx:if="{{variant === 'capture'}}">{{active ? '正在记录你的描述' : waiting ? '正在整理训练记录' : '今天练了什么？'}}</view><textarea hidden="{{variant === 'capture' && !showText}}" class="voice-text" value="{{text}}" placeholder="{{placeholder}}" maxlength="-1" auto-height adjust-position cursor-spacing="100" bindinput="onText" disabled="{{disabled || active || waiting}}" aria-label="{{label}}，可手动输入"/>
  <view class="voice-controls" aria-live="polite">
    <view class="voice-start" wx:if="{{!active && !waiting}}"><button class="mic-button {{disabled || micDenied ? 'disabled' : ''}}" bindtap="onStart" disabled="{{disabled || micDenied}}" aria-label="开始录音"><ui-icon name="mic" tone="green" size="44"/></button><view class="voice-copy"><text class="status">{{micDenied ? '麦克风不可用' : status}}</text><text class="hint">{{micDenied ? '仍可在上方输入文字' : '最长 60 秒，也可直接打字'}}</text></view></view>
    <view class="voice-running" wx:elif="{{active}}"><view class="voice-copy"><view class="status live"><text class="record-dot {{state === 'recording' ? 'pulsing' : ''}}"/>{{status}}</view><text class="clock">{{time}}<text class="hint"> / 01:00</text></text></view><button class="control-button" wx:if="{{canPause}}" bindtap="onPause" aria-label="{{state === 'paused' || state === 'interrupted' ? '继续录音' : '暂停录音'}}"><ui-icon name="{{state === 'paused' || state === 'interrupted' ? 'play' : 'pause'}}" tone="ink" size="32"/><text>{{state === 'paused' || state === 'interrupted' ? '继续' : '暂停'}}</text></button><button class="control-button stop-button" bindtap="onStop" aria-label="结束录音"><ui-icon name="stop" tone="danger" size="32"/><text>{{canPause ? '结束' : '结束本段'}}</text></button></view>
    <view class="voice-waiting" wx:else><view class="spinner"/><text class="status">{{status}}，请稍候</text></view>
  </view>
  <view class="hint segment-hint" wx:if="{{active && !canPause}}">当前通道不支持暂停；结束本段后可继续补录。</view>
  <view class="hint" wx:if="{{mock}}">演示结果不代表对本次语音的真实识别。</view>
  <button class="text-action" wx:if="{{variant === 'capture'}}" bindtap="onTextToggle">{{showText ? '收起文字输入' : '也可手动输入文字'}}</button><button class="text-action" wx:if="{{micDenied && !disabled}}" bindtap="onAuthorize">重试麦克风授权</button>
  <button class="parse-button {{disabled || active || waiting || !text ? 'disabled' : ''}}" wx:if="{{showParse}}" bindtap="onParse" disabled="{{disabled || active || waiting || !text}}">整理训练内容</button>
</view>
