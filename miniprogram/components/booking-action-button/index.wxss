:host{display:block;width:100%}.submit{background:var(--ix-accent, #214beb);color:#fff;border-radius:16rpx;min-height:96rpx;font-size:28rpx;font-weight:600;transition:opacity var(--ix-state, 200ms) ease,transform var(--ix-fast, 100ms) ease}.submit::after{border:0}.submit:active{transform:scale(.99)}.submit.is-disabled{background:#e5eaf4;color:var(--ix-muted, #526071)}.submit.submitted,.submit.confirmed{background:#e6f5ed;color:#176340}.error{font-size:24rpx;color:#b42332;margin-top:16rpx}.reduced .submit{transition:none;transform:none}
