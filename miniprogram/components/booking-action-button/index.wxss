:host { display: block; width: 100%; }
.submit {
  display: flex !important;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: 16rpx 0 0;
  padding: 0 24rpx !important;
  background: var(--accent) !important;
  color: var(--on-accent) !important;
  border-radius: 16rpx;
  min-height: 96rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 0;
  text-align: center;
  white-space: nowrap;
  transition: opacity var(--ix-state, 200ms) ease, transform var(--ix-fast, 100ms) ease;
}
.submit::after { border: 0; }
.submit text {
  display: block;
  width: 100%;
  text-align: center;
  line-height: 1.2;
}
.submit:active { transform: scale(.99); opacity: .92; }
.submit.is-disabled {
  background: var(--disabled-bg) !important;
  color: var(--disabled-ink) !important;
  transform: none;
}
.submit.submitted,
.submit.confirmed {
  background: var(--ok-soft) !important;
  color: var(--ok-ink) !important;
}
.error {
  font-size: 24rpx;
  color: var(--ix-error, var(--danger, var(--danger)));
  margin-top: 16rpx;
}
.reduced .submit { transition: none; transform: none; }
@media (prefers-reduced-motion: reduce) {
  .submit { transition: none; transform: none; }
}
