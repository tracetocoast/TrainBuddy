:host{display:block;min-width:0;flex:1}.control{background:#f3f5f8;border:1rpx solid var(--ix-line, #dce2e8);border-radius:16rpx;padding:16rpx;color:var(--ix-ink, #17202b)}.label{font-size:24rpx;font-weight:600}.unit{color:var(--ix-muted, #526071);font-weight:400}.stepper{display:flex;align-items:center;gap:8rpx;margin-top:12rpx}.step{margin:0;padding:0;width:88rpx;min-width:72rpx;height:88rpx;line-height:88rpx;background:#fff;color:var(--ix-accent, #214beb);font-size:32rpx;border-radius:12rpx}.step::after{border:0}.step.is-disabled{color:#8b95a3;background:#e6eaf0}.number{min-width:0;flex:1;height:88rpx;text-align:center;font-size:42rpx;font-weight:700;font-variant-numeric:tabular-nums}.ruler{display:flex;justify-content:space-between;margin:12rpx 12rpx 0;color:#a1adbd;line-height:20rpx}.pointer{color:var(--ix-accent, #214beb)}.hint{font-size:20rpx;color:var(--ix-muted, #526071);margin-top:10rpx}.invalid{font-size:22rpx;color:#b42332;margin-top:10rpx}
.ruler{display:block;white-space:nowrap;margin:12rpx 0 0;line-height:normal}.tick{display:inline-flex;flex-direction:column;align-items:center;justify-content:center;width:88rpx;min-height:88rpx;margin:0;padding:0;background:transparent;color:var(--ix-muted, #526071);line-height:1.2;font-size:24rpx;border-radius:0}.tick::after{border:0}.tick-number{font-size:22rpx;margin-top:8rpx}.tick.pointer{color:var(--ix-accent, #214beb);font-weight:700}
.step{flex:0 0 88rpx;box-sizing:border-box}.number{display:block;width:160rpx;flex:1 1 160rpx;box-sizing:border-box;color:var(--ix-ink, #17202b)}.range{margin:18rpx 6rpx 8rpx}
.step{min-width:44px;min-height:44px;transition:transform var(--ix-fast,100ms) ease}.step:active{transform:scale(.97)}.reduced .step{transition:none;transform:none}.number{min-height:44px}
.step { width:88rpx !important;max-width:44px; }
