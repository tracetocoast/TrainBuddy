:host {
  display: block;
  min-width: 0;
  width: 100%;
}

.control {
  background: var(--surface-raised);
  border: 1rpx solid var(--ix-line, var(--line));
  border-radius: 24rpx;
  padding: 20rpx;
  color: var(--ix-ink, var(--ink));
  box-sizing: border-box;
}

.label {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
}

.unit {
  color: var(--ix-muted, var(--muted));
  font-weight: 400;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.step {
  margin: 0 !important;
  padding: 0 !important;
  flex: 0 0 88rpx;
  width: 88rpx !important;
  min-width: 88rpx;
  max-width: 88rpx;
  height: 88rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  text-align: center;
  background: var(--surface);
  color: var(--ix-accent, var(--accent));
  font-size: 36rpx;
  font-weight: 600;
  border-radius: 20rpx;
  box-sizing: border-box;
  transition: transform var(--ix-fast, 100ms) ease;
}

.step::after {
  border: 0;
}

.step.is-disabled {
  color: var(--blue-muted);
  background: var(--blue-tint);
}

.step:active {
  transform: scale(0.97);
}

.reduced .step {
  transition: none;
  transform: none;
}

.number {
  display: block;
  flex: 1 1 auto;
  min-width: 0;
  width: auto;
  height: 88rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: var(--ix-ink, var(--ink));
  background: transparent;
}

.ruler {
  display: block;
  white-space: nowrap;
  margin: 14rpx 0 0;
  line-height: normal;
}

.tick {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  color: var(--ix-muted, var(--muted));
  line-height: 1.2;
  font-size: 24rpx;
  border-radius: 0;
  vertical-align: top;
}

.tick::after {
  border: 0;
}

.tick-number {
  font-size: 22rpx;
  margin-top: 8rpx;
}

.tick.pointer {
  color: var(--ix-accent, var(--accent));
  font-weight: 700;
}

.range {
  margin: 18rpx 6rpx 8rpx;
}

.hint {
  font-size: 20rpx;
  color: var(--ix-muted, var(--muted));
  margin-top: 10rpx;
  line-height: 1.4;
}

.invalid {
  font-size: 22rpx;
  color: var(--danger);
  margin-top: 10rpx;
  line-height: 1.4;
}
