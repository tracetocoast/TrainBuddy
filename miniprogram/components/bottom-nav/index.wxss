.nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  min-height: calc(112rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  border-top: 1rpx solid var(--blue-line);
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  padding: 10rpx 8rpx calc(10rpx + env(safe-area-inset-bottom));
  z-index: 100;
  box-sizing: border-box;
}

.nav-item {
  flex: 1;
  min-width: 0;
  color: var(--muted);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  font-size: 20rpx;
  font-weight: 400;
  min-height:44px;
  justify-content:center;
  transition:opacity 100ms ease;
}

.nav-item:active {
  opacity:.7;
}

.nav-icon {
  width: 88rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  line-height: 1;
  border: 1rpx solid transparent;
  border-radius: 10rpx;
}

.nav-symbol {
  width: 42rpx;
  height: 42rpx;
  display: block;
}

.nav-item.active {
  color: var(--accent);
  font-weight: 600;
}

.nav-item.active .nav-icon {
  background: var(--surface-raised);
  border-color: transparent;
}

.nav-text {
  line-height: 1.35;
}

.nav-coach { background:var(--surface); border-color:var(--line); }
.nav-coach .nav-icon { width:80rpx; border-radius:14rpx; }
.nav-coach .nav-item.active { color:var(--accent); font-weight:600; }
.nav-coach .nav-item.active .nav-icon { background:var(--surface-raised); }
@media (prefers-reduced-motion:reduce) { .nav-item { transition:none; } }
