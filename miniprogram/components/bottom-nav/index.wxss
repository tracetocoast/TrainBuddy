.nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  min-height: calc(112rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  border-top: 2rpx solid #304351;
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  padding: 12rpx 8rpx calc(12rpx + env(safe-area-inset-bottom));
  z-index: 100;
  box-sizing: border-box;
}

.nav-item {
  flex: 1;
  min-width: 0;
  color: #888;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.nav-icon {
  width: 82rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  line-height: 1;
  border: 2rpx solid transparent;
  border-radius: 18rpx;
}

.nav-item.active {
  color: #bdd3e2;
}

.nav-item.active .nav-icon {
  background: #203748;
  border-color: #52718a;
}

.nav-text {
  line-height: 1.4;
}

.nav { background: #111b26; border-top: 1rpx solid #304351; }
.nav-symbol { width: 42rpx; height: 42rpx; display: block; }
.nav-item { color: #7e95a6; font-weight: 400; }
.nav-item.active { color: #d9e7f0; }
.nav-item.active .nav-icon { background: #233c4f; border: 1rpx solid #4a687f; }
