.nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 148rpx;
  background: #fff;
  border-top: 2rpx solid #e4e7dd;
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  padding: 12rpx 10rpx calc(12rpx + env(safe-area-inset-bottom));
  z-index: 100;
  box-sizing: border-box;
}

.nav-item {
  color: #8b9084;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  font-size: 18rpx;
  font-weight: 700;
  min-width: 106rpx;
}

.nav-icon {
  font-size: 38rpx;
  line-height: 1;
  padding: 10rpx 18rpx;
  border-radius: 20rpx;
}

.nav-item.active {
  color: #151812;
}

.nav-item.active .nav-icon {
  background: #c8ff36;
  margin-top: -10rpx;
}

.nav-text {
  line-height: 1;
}
