.nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  min-height: calc(112rpx + env(safe-area-inset-bottom));
  background: rgba(250, 251, 247, 0.96);
  border-top: 1rpx solid var(--line);
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  padding: 10rpx 8rpx calc(10rpx + env(safe-area-inset-bottom));
  z-index: 100;
  box-sizing: border-box;
  backdrop-filter: blur(16px);
}

.nav-item {
  flex: 1;
  min-width: 0;
  color: var(--muted);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  font-size: 20rpx;
  font-weight: 400;
  transition: transform 0.18s cubic-bezier(.2,.8,.2,1), color 0.2s ease;
}

.nav-item:active {
  transform: scale(0.94);
}

.nav-icon {
  width: 88rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  line-height: 1;
  border: 1rpx solid transparent;
  border-radius: 999rpx;
  transition: background 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
}

.nav-symbol {
  width: 42rpx;
  height: 42rpx;
  display: block;
}

.nav-item.active {
  color: var(--accent);
  font-weight: 500;
}

.nav-item.active .nav-icon {
  background: #e8f0df;
  border-color: transparent;
  box-shadow: 0 4rpx 14rpx rgba(23, 32, 43, 0.1);
}

.nav-text {
  line-height: 1.35;
}
.nav { background:#ffffff;border-color:#dce2e8;backdrop-filter:none;min-height:calc(112rpx + env(safe-area-inset-bottom)); }
.nav-item { min-height:44px;justify-content:center;transition:opacity 100ms ease; }
.nav-icon { border-radius:10rpx; }
.nav-item.active { color:#214beb;font-weight:700; }
.nav-item.active .nav-icon { background:#edf1ff;box-shadow:none; }
.nav-item:active { transform:none;opacity:.7; }
